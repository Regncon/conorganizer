{
  "inputs": [
    {
      "type": "promptString",
      "id": "grafana-token",
      "description": "Grafana service account token (glsa_…)",
      "password": true
    }
  ],
  "servers": {
    "grafana": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "github.com/grafana/mcp-grafana/v2/cmd/mcp-grafana@v2.0.2",
        "--disable-write",
        "--usage-stats=disabled"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.regncon.no",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${input:grafana-token}"
      }
    }
  }
}
