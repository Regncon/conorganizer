package feedback

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/Regncon/conorganizer/components"
	"github.com/Regncon/conorganizer/components/errorfeedback"
	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/service/feedback"
)

func feedbackCategoryButtonClass(category, selected feedback.Category) string {
	class := "btn btn--outline feedback-category-button"
	if category == selected {
		class += " selected"
	}
	return class
}

// feedbackCategoryClickExpr selects a category and clears any topics chosen
// for the previously selected category, since topics only apply to one
// category at a time.
func feedbackCategoryClickExpr(category feedback.Category) string {
	return fmt.Sprintf("$%s = '%s'; $%s = []", feedbackCategorySignal, category, feedbackTopicsSignal)
}

// feedbackTopicToggleExpr adds or removes one topic from the selected topics
// array, without relying on checkbox array binding.
func feedbackTopicToggleExpr(topic feedback.Topic) string {
	return fmt.Sprintf(
		"$%s = $%s.includes('%s') ? $%s.filter((t) => t !== '%s') : [...$%s, '%s']",
		feedbackTopicsSignal, feedbackTopicsSignal, topic, feedbackTopicsSignal, topic, feedbackTopicsSignal, topic,
	)
}

func feedbackTopicPressedExpr(topic feedback.Topic) string {
	return fmt.Sprintf("$%s.includes('%s') ? 'true' : 'false'", feedbackTopicsSignal, topic)
}

func feedbackTopicSelectedExpr(topic feedback.Topic) string {
	return fmt.Sprintf("$%s.includes('%s')", feedbackTopicsSignal, topic)
}

// feedbackHasTopicsExpr is true while the selected category has topics to
// pick from, so the optional topics question is hidden for "Noe annet".
func feedbackHasTopicsExpr() string {
	withTopics := []string{}
	for _, category := range feedback.Categories {
		if len(feedback.TopicsFor(category)) > 0 {
			withTopics = append(withTopics, "'"+string(category)+"'")
		}
	}
	return fmt.Sprintf("[%s].includes($%s)", strings.Join(withTopics, ", "), feedbackCategorySignal)
}

// feedbackTextDescribedBy lists the ids describing the message field: its
// error message, its character counter and, while shown, its personal info
// hint. The hint is only referenced while visible, since aria-describedby
// reads directly referenced elements even when they are hidden.
func feedbackTextDescribedBy(fieldKey string, withPersonalInfoHint bool) string {
	ids := fmt.Sprintf("feedback-%s-error feedback-%s-counter", fieldKey, fieldKey)
	if withPersonalInfoHint {
		ids += fmt.Sprintf(" feedback-%s-personal-info", fieldKey)
	}
	return ids
}

func feedbackTextDescribedByExpr(fieldKey, personalInfoSignal string) string {
	return fmt.Sprintf("%s ? '%s' : '%s'", personalInfoSignal, feedbackTextDescribedBy(fieldKey, true), feedbackTextDescribedBy(fieldKey, false))
}

// feedbackSubmitDescribedByExpr points the submit button at the personal
// info hint that explains why it is disabled.
func feedbackSubmitDescribedByExpr() string {
	return "$_messagePersonalInfo ? 'feedback-message-personal-info' : ''"
}

// feedbackResetExpr keeps the category the user came in with (for example
// from a QR code) preselected on the fresh form.
func feedbackResetExpr(category feedback.Category) string {
	return fmt.Sprintf("@get('/tilbakemelding/reset?om=%s')", category.Slug())
}

templ feedbackFormPage(preselected feedback.Category) {
	<style>
		.feedback-page {
			container: feedback-page / inline-size;
			display: flex;
			flex-direction: column;
			gap: var(--spacing-5x);
			max-inline-size: 52rem;

			.surface-pane {
				padding: clamp(var(--spacing-5x), 5cqi, var(--spacing-10x));
			}

			.feedback-content,
			.feedback-thank-you {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-8x);
			}

			.feedback-privacy-hint {
				display: flex;
				place-items: center;
				gap: var(--spacing-2x);
				margin: 0;
				padding-block-end: var(--spacing-5x);
				border-block-end: 1px solid var(--level-3-border);
				color: var(--color-text-soft);
				font-size: var(--text-body-small);

				.inline-icon {
					flex-shrink: 0;
				}
			}

			.feedback-form {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-10x);
			}

			fieldset {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-3x);
				min-inline-size: 0;
				margin: 0;
				padding: 0;
				border: none;
			}

			.feedback-group-label {
				padding: 0;
				margin-block-end: var(--spacing-1x);
				color: var(--color-text-strong);
				font-size: var(--text-body);
				font-weight: 700;
			}

			.feedback-optional {
				color: var(--color-text-soft);
				font-weight: 400;
			}

			.feedback-categories {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--spacing-2x);

				.btn {
					min-block-size: 3rem;
					padding-inline: var(--spacing-2x);
					white-space: nowrap;
				}
			}

			.feedback-category-button.selected {
				border-color: var(--color-primary);
				background: color-mix(in srgb, var(--color-primary) 14%, var(--bg-item));
				color: var(--color-text-strong);
			}

			.feedback-topics {
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-2x);
			}

			.feedback-topic-chip {
				padding-block: var(--spacing-2x);
				padding-inline: var(--spacing-4x);
				border: 1px solid var(--bg-item-border);
				border-radius: 999px;
				background: var(--bg-item);
				color: var(--color-text-soft);
				font: inherit;
				font-size: var(--text-body-small);
				cursor: pointer;
				transition: var(--btn-transition);

				&:hover {
					border-color: var(--bg-item-border-hover);
					color: var(--color-text-strong);
				}
				&.selected {
					border-color: var(--color-primary);
					background: color-mix(in srgb, var(--color-primary) 14%, var(--bg-item));
					color: var(--color-text-strong);
				}
			}

			.feedback-text-field {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2x);
				color: var(--color-text-strong);
				font-size: var(--text-body);
				font-weight: 700;

				textarea {
					min-block-size: 10rem;
					padding: var(--spacing-3x) var(--spacing-4x);
					font: inherit;
					font-size: var(--text-body);
					font-weight: 400;
					line-height: 1.5;
					resize: vertical;
				}
			}

			.feedback-field-helptext {
				margin: 0;
				color: var(--color-text-soft);
				font-size: var(--text-body-small);
				font-weight: 400;
			}

			.feedback-message-footer {
				display: flex;
				place-content: space-between;
				gap: var(--spacing-2x);
				min-block-size: 1.25rem;
			}

			.feedback-char-counter {
				margin-inline-start: auto;
				color: var(--color-text-soft);
				font-size: var(--text-body-small);
				font-weight: 400;
			}

			.feedback-personal-info-hint {
				margin: 0;
				color: var(--color-error);
				font-size: var(--text-body-small);
				font-weight: 600;
			}

			.feedback-submit {
				min-block-size: 3rem;

				&:disabled {
					opacity: 0.5;
					cursor: not-allowed;
				}
			}

			.feedback-thank-you {
				place-items: start;
				gap: var(--spacing-4x);

				h2 {
					margin: 0;
				}
			}
		}

		@container feedback-page (width > 40rem) {
			.feedback-page {
				.feedback-submit {
					align-self: end;
					min-inline-size: 16rem;
				}
			}
		}

		@container feedback-page (width < 18rem) {
			.feedback-page .feedback-categories {
				grid-template-columns: 1fr;
			}
		}
	</style>
	<section class="page-content-container feedback-page">
		<h1 class="page-heading">Gi tilbakemelding</h1>
		<p class="page-heading-helptext">Tilbakemeldingen din hjelper oss å gjøre Regncon bedre.</p>
		<div class="surface-pane">
			@feedbackFormWrapper(preselected)
		</div>
	</section>
	@feedbackPersonalInfoScript()
}

// feedbackPersonalInfoScript defines a global helper the form's computed
// signals call to detect personal info as the user types. It is rendered
// once on the full page, outside the swapped #feedback-form subtree, so it
// stays defined across resets and does not need to be re-sent on every patch.
templ feedbackPersonalInfoScript() {
	<script>
		window.feedbackContainsPersonalInfo = function (text, form) {
			if (!text || !form) {
				return false;
			}
			var emailMarker = form.dataset.personalInfoEmailMarker;
			if (emailMarker && text.includes(emailMarker)) {
				return true;
			}
			var dateOrTimeRange = new RegExp(form.dataset.personalInfoDatePattern, "g");
			var withoutDates = text.replace(dateOrTimeRange, form.dataset.personalInfoDateReplacement);
			var digitRun = new RegExp(form.dataset.personalInfoDigitPattern, "g");
			var phoneDigits = Number(form.dataset.personalInfoPhoneDigits);
			var minLongDigits = Number(form.dataset.personalInfoMinLongDigits);
			var matches = withoutDates.match(digitRun) || [];
			for (var i = 0; i < matches.length; i++) {
				var digitCount = (matches[i].match(/\d/g) || []).length;
				if (digitCount === phoneDigits || digitCount >= minLongDigits) {
					return true;
				}
			}
			return false;
		};
	</script>
}

templ feedbackFormWrapper(preselected feedback.Category) {
	<div
		id={ feedbackFormElementID }
		class="feedback-content"
		data-signals={ components.DataSignals(map[string]any{
			feedbackCategorySignal: string(preselected),
			feedbackMessageSignal:  "",
			feedbackTopicsSignal:   []string{},
		}) }
	>
		<p class="feedback-privacy-hint">
			@icons.Icon(icons.Shield, icons.Size16)
			<span>Tilbakemeldingen er anonym. Ikke skriv navn, e-post eller telefonnummer.</span>
		</p>
		<form
			id="feedback-form-element"
			class="feedback-form"
			data-on:submit="evt.preventDefault(); @post('/tilbakemelding')"
			data-personal-info-email-marker={ feedback.EmailMarker }
			data-personal-info-digit-pattern={ feedback.DigitRunPattern }
			data-personal-info-phone-digits={ strconv.Itoa(feedback.PhoneNumberDigits) }
			data-personal-info-min-long-digits={ strconv.Itoa(feedback.MinLongNumberDigits) }
			data-personal-info-date-pattern={ feedback.DateOrTimeRangePattern }
			data-personal-info-date-replacement={ feedback.DateOrTimeRangeReplacement }
			data-computed:_message-personal-info={ fmt.Sprintf("window.feedbackContainsPersonalInfo($%s, el)", feedbackMessageSignal) }
			{ errorfeedback.DefaultMessage("Klarte ikke å sende inn. Prøv igjen.")... }
		>
			<fieldset class="feedback-categories-field">
				<legend class="feedback-group-label">Hva gjelder tilbakemeldingen?</legend>
				<div class="feedback-categories">
					for _, category := range feedback.Categories {
						<button
							type="button"
							class={ feedbackCategoryButtonClass(category, preselected) }
							aria-pressed={ fmt.Sprintf("%t", category == preselected) }
							data-class:selected={ fmt.Sprintf("$%s === '%s'", feedbackCategorySignal, category) }
							data-attr:aria-pressed={ fmt.Sprintf("$%s === '%s' ? 'true' : 'false'", feedbackCategorySignal, category) }
							data-on:click={ feedbackCategoryClickExpr(category) }
						>
							{ category.Label() }
						</button>
					}
				</div>
				@errorfeedback.RenderMessage(feedbackCategorySignal)
			</fieldset>
			<fieldset
				class="feedback-topics-field"
				if len(feedback.TopicsFor(preselected)) == 0 {
					style="display: none"
				}
				data-show={ feedbackHasTopicsExpr() }
			>
				<legend class="feedback-group-label">Hva handler det om? <span class="feedback-optional">(valgfritt)</span></legend>
				for _, category := range feedback.Categories {
					if topics := feedback.TopicsFor(category); len(topics) > 0 {
						<div
							class="feedback-topics"
							if category != preselected {
								style="display: none"
							}
							data-show={ fmt.Sprintf("$%s === '%s'", feedbackCategorySignal, category) }
						>
							for _, topic := range topics {
								<button
									type="button"
									class="feedback-topic-chip"
									aria-pressed="false"
									data-class:selected={ feedbackTopicSelectedExpr(topic) }
									data-attr:aria-pressed={ feedbackTopicPressedExpr(topic) }
									data-on:click={ feedbackTopicToggleExpr(topic) }
								>
									{ topic.Label() }
								</button>
							}
						</div>
					}
				}
			</fieldset>
			<label class="label feedback-text-field" for="feedback-message">
				Tilbakemelding
				<span class="feedback-field-helptext">Fortell gjerne hva som fungerte bra, og hva som kan bli bedre.</span>
				<textarea
					id="feedback-message"
					name="feedbackMessage"
					class="input"
					placeholder="F.eks. «Påmeldingen var enkel, men programmet var vanskelig å finne på mobil.»"
					data-bind={ feedbackMessageSignal }
					rows="6"
					maxlength={ strconv.Itoa(feedback.MaxTextLength) }
					aria-describedby={ feedbackTextDescribedBy("message", false) }
					data-attr:aria-describedby={ feedbackTextDescribedByExpr("message", "$_messagePersonalInfo") }
				></textarea>
				<div class="feedback-message-footer">
					<span id="feedback-message-error">
						@errorfeedback.RenderMessage(feedbackMessageSignal)
					</span>
					<span
						id="feedback-message-counter"
						class="feedback-char-counter"
						data-text={ fmt.Sprintf("$%s.length + ' / %d tegn'", feedbackMessageSignal, feedback.MaxTextLength) }
					>{ fmt.Sprintf("0 / %d tegn", feedback.MaxTextLength) }</span>
				</div>
				<p id="feedback-message-personal-info" class="feedback-personal-info-hint" style="display: none" data-show="$_messagePersonalInfo">
					Det ser ut som du har skrevet en e-postadresse eller et telefonnummer. Fjern det før du sender.
				</p>
			</label>
			<button
				type="submit"
				class="btn btn--primary feedback-submit"
				data-attr:disabled={ "$_messagePersonalInfo" }
				data-attr:aria-describedby={ feedbackSubmitDescribedByExpr() }
			>
				Send tilbakemelding
			</button>
		</form>
	</div>
}

templ feedbackThankYou(category feedback.Category) {
	<div id={ feedbackFormElementID } class="feedback-thank-you">
		<h2>Takk for tilbakemeldingen!</h2>
		<p>Vi setter pris på at du tar deg tid til å hjelpe oss å gjøre Regncon bedre.</p>
		<button type="button" class="btn btn--outline" data-on:click={ feedbackResetExpr(category) }>
			Send en tilbakemelding til
		</button>
	</div>
}
