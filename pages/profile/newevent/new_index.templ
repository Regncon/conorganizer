package newevent

import (
	"context"
	"database/sql"
	"fmt"

	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/components/toast"
	"github.com/Regncon/conorganizer/layouts"
	"github.com/Regncon/conorganizer/pages/notfound"
	"github.com/Regncon/conorganizer/service/live"
	"github.com/Regncon/conorganizer/service/userctx"
	"github.com/go-chi/chi/v5"
	"github.com/go-chi/chi/v5/middleware"
	"log/slog"
	"net/http"
)

const eventNotFoundMessage = "Fant ikke arrangementet."

func NewEventLayoutRoute(router chi.Router, db *sql.DB, eventImageDir *string, logger *slog.Logger) {
	router.Get("/", func(w http.ResponseWriter, r *http.Request) {
		eventId := chi.URLParam(r, "id")

		userID, userIDErr := userctx.GetUserIDFromExternalIDFromContext(r.Context(), db, logger)
		if userIDErr != nil {
			logger.Error(fmt.Errorf("failed to get user_id for new event route: %w", userIDErr).Error())
			http.Error(w, userIDErr.Error(), http.StatusInternalServerError)
			return
		}

		selectErr, statusCode := validateEventOwnedByUser(db, eventId, userctx.GetUserRequestInfo(r.Context()).Id)
		if selectErr != nil && statusCode == http.StatusInternalServerError {
			http.Error(w, selectErr.Error(), http.StatusInternalServerError)
			return
		}

		if selectErr != nil && statusCode == http.StatusNotFound {
			notfound.RenderEvent(w, r, db, logger)
			return
		}

		eventTitle := getEventTitle(db, eventId)
		title := "Lag nytt arrangement"
		if eventTitle != "" {
			title = eventTitle
		}

		var ctx = r.Context()
		if err := layouts.Base(
			title,
			userctx.GetUserRequestInfo(ctx),
            db,
            logger,
			newEventIndex(eventId, userID, ctx, db, eventImageDir, logger),
		).Render(ctx, w); err != nil {
			logger.Error(fmt.Errorf("failed to render new-event page: %w", err).Error(), "event_id", eventId, "user_id", userID)
		}
	})
}

templ newEventIndex(eventId string, userID string, ctx context.Context, db *sql.DB, eventImageDir *string, logger *slog.Logger) {
	@toast.Render("Lagret", icons.ProgressComplete)
	<div
		id="formsubmission-container"
		class="formsubmission-css-container"
		data-init={ live.DatastarInit(fmt.Sprintf("/profile/api/new/%s", eventId)) }
	>
		@NewEventFormPageContent(eventId, eventImageDir, userID, ctx, db, logger)
	</div>
}

func RequireEventOwnerOrAdmin(db *sql.DB, logger *slog.Logger) func(http.Handler) http.Handler {
	logger = logger.With("component", "new_event")
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			ctx := r.Context()
			userInfo := userctx.GetUserRequestInfo(ctx)
			if userInfo.IsAdmin {
				next.ServeHTTP(w, r)
				return
			}

			eventId := chi.URLParam(r, "id")
			selectErr, statusCode := validateEventOwnedByUser(db, eventId, userInfo.Id)
			if selectErr != nil && statusCode == http.StatusInternalServerError {
				logger.Error(selectErr.Error(), "request_id", middleware.GetReqID(ctx), "event_id", eventId, "user_id", userInfo.Id)
				http.Error(w, "Klarte ikke å sjekke tilgangen til arrangementet", http.StatusInternalServerError)
				return
			}
			if selectErr != nil {
				logger.Warn("User is neither owner nor admin of event", "request_id", middleware.GetReqID(ctx), "path", r.URL.Path, "event_id", eventId, "user_id", userInfo.Id)
				http.Error(w, eventNotFoundMessage, http.StatusNotFound)
				return
			}

			next.ServeHTTP(w, r)
		})
	}
}

func validateEventOwnedByUser(db *sql.DB, eventId string, externalUserId string) (error, int) {
	var exists bool
	queryErr := db.QueryRow(`
		SELECT EXISTS(
			SELECT 1
			FROM events
			JOIN users ON users.id = events.user_id
			WHERE events.id = ? AND users.external_id = ?
		)
	`, eventId, externalUserId).Scan(&exists)
	if queryErr != nil {
		return fmt.Errorf("check owner of event %q: %w", eventId, queryErr), http.StatusInternalServerError
	}

	if !exists {
		return fmt.Errorf("event not found"), http.StatusNotFound
	}

	return nil, http.StatusOK
}

func getEventTitle(db *sql.DB, eventId string) string {
	var title string

	err := db.QueryRow("SELECT title FROM events WHERE id = ?", eventId).Scan(&title)

	if err != nil {
		return ""
	}

	return title
}
