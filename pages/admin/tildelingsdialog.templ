package admin

import (
	"fmt"

	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/service/puljefordeling"
)

func tildelingsrolle(role models.EventPlayerRole) string {
	if role == models.EventPlayerRoleGM {
		return "Spilleder"
	}
	return "Spiller"
}

func tildelingsoppsummering(tildelinger []puljefordeling.Tildeling) string {
	var gms, spillere int
	for _, tildeling := range tildelinger {
		if tildeling.Role == models.EventPlayerRoleGM {
			gms++
		} else {
			spillere++
		}
	}
	spillerplasser := "spillerplasser"
	if spillere == 1 {
		spillerplasser = "spillerplass"
	}
	return fmt.Sprintf("%d spillederoppdrag · %d %s", gms, spillere, spillerplasser)
}

func tildelingsbekreftelse(varsel puljefordeling.Tildelingsvarsel, valg puljefordeling.Tildelingsvalg) string {
	return fmt.Sprintf("$assignmentBillettholderId = %d; $assignmentEventId = %q; $assignmentPuljeId = %q; $assignmentRole = %q; $assignmentFromAddMenu = %t; $assignmentFromEventId = %q; $assignmentFromManualSeat = %t; $assignmentConfirmation = %q; $assignmentAgeConfirmed = true; $assignmentRemove = false; $assignmentCloseDialog = true; $tildelingOpen = false; @post(%q); $assignmentCloseDialog = false; $assignmentConfirmation = ''; $assignmentAgeConfirmed = false; $assignmentFromAddMenu = false; $assignmentBillettholderId = 0",
		valg.BillettholderID, valg.EventID, string(valg.PuljeID), string(valg.Role), valg.FraLeggTil, valg.FraEventID, valg.FraManuellPlass, varsel.Bekreftelse, puljeTildelingsURL)
}

templ puljeTildelingsDialog() {
	<dialog
		id="tildeling-dialog"
		class="tildeling-dialog"
		closedBy="any"
		aria-labelledby="tildeling-dialog-title"
		data-preserve-attr="open"
		data-signals__ifmissing:tildeling-open="false"
		data-signals__ifmissing:assignment-confirmation="''"
		data-signals__ifmissing:assignment-from-add-menu="false"
		data-signals__ifmissing:assignment-from-event-id="''"
		data-signals__ifmissing:assignment-from-manual-seat="false"
		data-signals__ifmissing:assignment-role="'Player'"
		data-signals__ifmissing:assignment-remove="false"
		data-effect="$tildelingOpen ? (!el.open && el.showModal()) : (el.open && el.close())"
		data-on:close="$tildelingOpen = false; $assignmentConfirmation = ''"
		data-on:click__stop="if (evt.target === el) $tildelingOpen = false"
	>
		<div id="tildeling-dialog-innhold"></div>
	</dialog>
	<style>
		.tildeling-dialog {
			container: tildeling / inline-size;
			inline-size: min(36rem, calc(100dvw - 2rem));
			max-inline-size: none;
			max-block-size: calc(100dvh - 2rem);
			padding: 0;
			border: 1px solid var(--level-3-border);
			border-radius: var(--border-radius-2x);
			background-color: var(--level-1-background);
			box-shadow: var(--shadow-dialog);
			color: var(--color-text-strong);

			&::backdrop {
				background-color: rgb(0 0 0 / 60%);
			}
			p {
				margin: 0;
			}
			h3 {
				margin: 0;
				font-size: var(--text-body);
			}
		}
		#tildeling-dialog-innhold {
			display: grid;
			gap: var(--spacing-4x);
			padding: var(--spacing-3x) var(--spacing-5x) var(--spacing-5x);
		}
		.tildeling-header {
			display: flex;
			place-content: center space-between;
			place-items: center;
			gap: var(--spacing-3x);
			margin-inline-end: calc(-1 * var(--spacing-2x));

			h2 {
				margin: 0;
				font-size: 1.25rem;
			}
		}
		.tildeling-handling {
			display: grid;
			gap: var(--spacing-1x);

			strong {
				font-size: var(--text-body);
			}
			span {
				color: var(--color-text-soft);
				font-size: var(--text-body-small);
			}
		}
		.tildeling-section {
			display: grid;
			gap: var(--spacing-2x);
			padding: var(--spacing-3x) var(--spacing-4x);
			border: 1px solid var(--level-3-border);
			border-radius: var(--border-radius-2x);
			background-color: var(--level-2-background);
		}
		.tildeling-note {
			color: var(--color-text-soft);
			font-size: var(--text-body-small);
		}
		.tildeling-list {
			display: grid;
			gap: var(--spacing-1x);
			margin: 0;
			padding: 0;
			list-style: none;

			li {
				display: grid;
				gap: var(--spacing-1x);
				padding: var(--spacing-2x) var(--spacing-3x);
				border: 1px solid var(--level-3-border);
				border-radius: var(--border-radius-1x);
				background-color: var(--level-3-background);
			}
			span {
				color: var(--color-text-soft);
				font-size: var(--text-body-small);
			}
		}
		.tildeling-konsekvens {
			grid-template-columns: minmax(0, 1fr) auto;
			place-items: center start;

			.tildeling-konsekvens-flytt {
				display: inline-flex;
				flex-wrap: wrap;
				place-items: center;
				gap: var(--spacing-1x) var(--spacing-2x);
				color: var(--color-text-strong);
			}
			.tildeling-konsekvens-notat {
				grid-column: 1 / -1;
			}
		}
		.tildeling-konsekvens-navn {
			color: var(--color-text-strong);
			font-weight: 600;
		}
		.tildeling-age-warning,
		.tildeling-capacity-warning {
			padding: var(--spacing-3x);
			border-inline-start: 4px solid var(--color-warning);
			border-radius: var(--border-radius-1x);
			background-color: color-mix(in srgb, var(--color-warning) 12%, transparent);
		}
		.tildeling-actions {
			display: grid;
			gap: var(--spacing-2x);
		}
		@container tildeling (width > 420px) {
			.tildeling-actions {
				grid-template-columns: auto 1fr;
			}
		}
	</style>
}

templ puljeTildelingsDialogInnhold(varsel puljefordeling.Tildelingsvarsel, valg puljefordeling.Tildelingsvalg) {
	<div id="tildeling-dialog-innhold">
		@puljeTildelingsHeader()
		<p class="tildeling-handling">
			<strong>{ varsel.Handling }</strong>
			<span>{ varsel.BillettholderNavn } · { varsel.PuljeNavn }</span>
		</p>
		if len(varsel.Tildelinger) > 0 {
			<section class="tildeling-section">
				<h3>Tildelinger for { varsel.BillettholderNavn }</h3>
				<p class="tildeling-note">{ tildelingsoppsummering(varsel.Tildelinger) }</p>
				<ul class="tildeling-list">
					for _, tildeling := range varsel.Tildelinger {
						<li data-role={ string(tildeling.Role) } data-event-id={ tildeling.EventID }>
							<p><strong>{ tildelingsrolle(tildeling.Role) }:</strong> { tildeling.EventTitle }</p>
							if tildeling.Role == models.EventPlayerRolePlayer {
								if tildeling.Source == puljefordeling.SourceManual {
									<span>Manuelt festet spillerplass</span>
								} else {
									<span>Automatisk fordelt spillerplass</span>
								}
							}
						</li>
					}
				</ul>
				if varsel.KanBekrefte {
					if valg.Role == models.EventPlayerRoleGM || valg.FraLeggTil {
						<p class="tildeling-note">Eksisterende tildelinger beholdes.</p>
						if valg.FraLeggTil {
							<p class="tildeling-note">Lagrede automatiske spillerplasser blir manuelle, slik at de beholdes ved ny fordeling.</p>
						}
					} else {
						<p class="tildeling-note">Andre tildelinger beholdes.</p>
					}
				}
			</section>
		}
		if !varsel.KanBekrefte {
			<p>Bruk «Legg til» for å bekrefte denne tildelingen.</p>
		}
		if varsel.Aldersvarsel != "" {
			<p class="tildeling-age-warning">{ varsel.Aldersvarsel }</p>
		}
		if varsel.Kapasitetsvarsel != "" {
			<p class="tildeling-capacity-warning">{ varsel.Kapasitetsvarsel }</p>
		}
		if varsel.Konsekvenser != nil {
			@puljeEgenKonsekvens(*varsel.Konsekvenser, varsel.BillettholderNavn)
			@puljeKonsekvenser(*varsel.Konsekvenser)
		}
		<div class="tildeling-actions">
			<button type="button" class="btn btn--outline" data-on:click="$tildelingOpen = false">Avbryt</button>
			if varsel.KanBekrefte {
				<button type="button" class="btn btn--primary" data-confirmation={ varsel.Bekreftelse } data-on:click={ tildelingsbekreftelse(varsel, valg) }>
					{ varsel.Handling }
				</button>
			}
		</div>
	</div>
}

// puljeFjerningsDialogInnhold asks the admin to confirm removing a manual
// Player seat or a GM, with the consequences for others in the pulje.
templ puljeFjerningsDialogInnhold(varsel puljefordeling.Fjerningsvarsel, fjerningsURL string) {
	{{ handling := fjerningshandling(varsel) }}
	<div id="tildeling-dialog-innhold">
		@puljeTildelingsHeader()
		<p class="tildeling-handling">
			<strong>{ handling }</strong>
			<span>{ varsel.BillettholderNavn } · { varsel.Konsekvenser.PuljeNavn }</span>
		</p>
		if varsel.Role == models.EventPlayerRolePlayer {
			<p class="tildeling-note">Interessene til { varsel.BillettholderNavn } beholdes, så fordelingen kan fortsatt gi hen en plass.</p>
		}
		@puljeEgenKonsekvens(varsel.Konsekvenser, varsel.BillettholderNavn)
		@puljeKonsekvenser(varsel.Konsekvenser)
		<div class="tildeling-actions">
			<button type="button" class="btn btn--outline" data-on:click="$tildelingOpen = false">Avbryt</button>
			<button type="button" class="btn btn--primary" data-on:click={ fmt.Sprintf("$tildelingOpen = false; @delete(%q)", fjerningsURL) }>{ handling }</button>
		</div>
	</div>
}

func fjerningshandling(varsel puljefordeling.Fjerningsvarsel) string {
	if varsel.Role == models.EventPlayerRoleGM {
		return fmt.Sprintf("Fjern som spilleder på «%s»", varsel.EventTitle)
	}
	return fmt.Sprintf("Fjern den manuelle plassen på «%s»", varsel.EventTitle)
}

templ puljeTildelingsHeader() {
	<header class="tildeling-header">
		<h2 id="tildeling-dialog-title">Er du sikker?</h2>
		<button type="button" class="btn btn--ghost btn-icon-only" aria-label="Lukk" data-on:click="$tildelingOpen = false">
			@icons.Icon(icons.Close, icons.Size24)
		</button>
	</header>
}

// puljeKonsekvenser lists, neutrally, who else in the pulje would get a
// different seat.
templ puljeKonsekvenser(konsekvenser puljefordeling.Konsekvenser) {
	<section class="tildeling-section tildeling-konsekvenser">
		<h3>Endringer for andre i { konsekvenser.PuljeNavn }</h3>
		if len(konsekvenser.Endringer) == 0 {
			<p class="tildeling-note">Ingen andre deltakere får endret plass.</p>
		} else {
			<ul class="tildeling-list">
				for _, endring := range konsekvenser.Endringer {
					@puljeKonsekvensRad(endring)
				}
			</ul>
		}
	</section>
}

// puljeEgenKonsekvens shows what the change does to the billettholder being
// placed, moved or removed, in the same format as everyone else.
templ puljeEgenKonsekvens(konsekvenser puljefordeling.Konsekvenser, navn string) {
	<section class="tildeling-section tildeling-egen-konsekvens">
		<h3>{ "For " + navn }</h3>
		<ul class="tildeling-list">
			if konsekvenser.Egen.Fra == konsekvenser.Egen.Til {
				<li class="tildeling-konsekvens">
					<span class="tildeling-konsekvens-navn">{ navn }</span>
					<span class="tildeling-konsekvens-flytt">
						<span>Beholder plassen:</span>
						@puljeKonsekvensPlass(konsekvenser.Egen.Til)
					</span>
				</li>
			} else {
				{{ egen := konsekvenser.Egen }}
				{{ egen.Name = navn }}
				@puljeKonsekvensRad(egen)
			}
		</ul>
	</section>
}

templ puljeKonsekvensRad(endring puljefordeling.Konsekvens) {
	<li class="tildeling-konsekvens">
		<span class="tildeling-konsekvens-navn">{ endring.Name }</span>
		<span class="tildeling-konsekvens-flytt">
			@puljeKonsekvensPlass(endring.Fra)
			<span aria-label="til">→</span>
			@puljeKonsekvensPlass(endring.Til)
		</span>
		if notat := forstevalgsnotat(endring); notat != "" {
			<span class="tildeling-konsekvens-notat">{ notat }</span>
		}
	</li>
}

templ puljeKonsekvensPlass(plass puljefordeling.Plass) {
	switch {
		case plass.EventID == "":
			<em>Uten plass</em>
		case plass.IsGM:
			<span>{ "Spilleder på " + plass.EventTitle }</span>
		default:
			<span title={ plass.Level.Label() }>{ plass.Level.Emoji() + " " + plass.EventTitle }</span>
	}
}

// forstevalgsnotat states a change in førstevalg for this pulje, if any.
func forstevalgsnotat(endring puljefordeling.Konsekvens) string {
	switch {
	case endring.Fra.Forstevalg && !endring.Til.Forstevalg:
		return "Får ikke førstevalg i denne puljen"
	case !endring.Fra.Forstevalg && endring.Til.Forstevalg:
		return "Får førstevalg i denne puljen"
	default:
		return ""
	}
}
