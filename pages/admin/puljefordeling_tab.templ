)

// puljefordelingRoute wires the per-pulje tabbed puljefordeling view. The page
// mirrors the bordfordeling (rooms assignment) layout: a tab strip per pulje and
// a connected panel that live-updates over SSE. It shows the emulated
// distribution and lets administrators make manual placements and set interests.
func puljefordelingRoute(router chi.Router, db *sql.DB, liveManager *live.Manager, logger *slog.Logger, eventImageDir *string) {
	logger = logger.With("component", "admin_puljefordeling_tab")

	router.Route("/puljefordeling", func(puljefordelingRouter chi.Router) {
		// Bare path: send the admin to the first pulje's tab.
		puljefordelingRouter.Get("/", func(w http.ResponseWriter, r *http.Request) {
			http.Redirect(w, r, fmt.Sprintf("/admin/puljefordeling/%s", models.PuljeFredagKveld), http.StatusSeeOther)
		})

		puljefordelingRouter.Get("/{pulje}", func(w http.ResponseWriter, r *http.Request) {
			userInfo := userctx.GetUserRequestInfo(r.Context())

			puljeQuery := chi.URLParam(r, "pulje")
			puljeID, ok := models.ParsePulje(puljeQuery)
			if !ok {
				http.Redirect(w, r, fmt.Sprintf("/admin/puljefordeling/%s", models.PuljeFredagKveld), http.StatusSeeOther)
				return
			}

			if err := layouts.Base(
				"Puljefordeling",
				userInfo,
				db,
				logger,
				puljefordelingIndex(db, logger, puljeID, eventImageDir),
			).Render(r.Context(), w); err != nil {
				logger.Error(fmt.Errorf("failed to render puljefordeling page: %w", err).Error(), "user_id", userInfo.Id)
			}
		})
	})

	// SSE endpoint: refreshes the complete puljefordeling work area for the
	// viewed pulje. Keeping the dialog inside this boundary lets its content stay
	// current while its local open state survives the morph.
	router.Get("/api/puljefordeling/{pulje}", func(w http.ResponseWriter, r *http.Request) {
		puljeQuery := chi.URLParam(r, "pulje")
		puljeID, ok := models.ParsePulje(puljeQuery)
		if !ok {
			http.Error(w, "Expected a valid pulje ID, got: "+puljeQuery, http.StatusBadRequest)
			return
		}

		liveManager.Stream(w, r, live.Page{
			Buckets: []live.Bucket{live.BucketEvents, live.BucketInterests},
			Render: func(ctx context.Context, r *http.Request) templ.Component {
				return puljefordelingPage(db, logger, puljeID, eventImageDir)
			},
		})
	})

	// Commit (+publish-independent). Persists the current distribution so it shows
	// in other views; solver picks become source='solver', manual pins stay manual.
	router.Post("/api/puljefordeling/{pulje}/commit", func(w http.ResponseWriter, r *http.Request) {
		puljeID, ok := models.ParsePulje(chi.URLParam(r, "pulje"))
		if !ok {
			http.Error(w, "Invalid pulje ID", http.StatusBadRequest)
			return
		}
		if err := puljefordeling.CommitDistribution(db, puljeID); err != nil {
			if errors.Is(err, puljefordeling.ErrPuljeCompleted) {
				http.Error(w, "Pulje is published; changes are not allowed", http.StatusConflict)
				return
			}
			logger.Error(err.Error(), "pulje_id", puljeID)
			http.Error(w, "Failed to commit distribution", http.StatusInternalServerError)
			return
		}
		if err := liveManager.Broadcast(r.Context(), live.BucketEvents, live.BucketRooms); err != nil {
			logger.Error(fmt.Errorf("failed to broadcast commit: %w", err).Error(), "pulje_id", puljeID)
		}
		w.WriteHeader(http.StatusNoContent)
	})

	// Add a manual pin (+). Force-pins the chosen billettholder into the event
	// without touching their interests; removing the pin reverts them to emulation.
	router.Post("/api/puljefordeling/assign", puljeTildelingsHandler(db, liveManager, logger))
	router.Put("/api/puljefordeling/interest", puljeInteresseHandler(db, liveManager, logger))

	router.Delete("/api/puljefordeling/{pulje}/{event}/{billettholderId}/gm", func(w http.ResponseWriter, r *http.Request) {
		pulje, ok := models.ParsePulje(chi.URLParam(r, "pulje"))
		if !ok {
			http.Error(w, "Invalid pulje ID", http.StatusBadRequest)
			return
		}
		billettholderID, err := strconv.Atoi(chi.URLParam(r, "billettholderId"))
		if err != nil || billettholderID <= 0 {
			http.Error(w, "Invalid billettholder ID", http.StatusBadRequest)
			return
		}
		eventID := chi.URLParam(r, "event")
		if err := puljefordeling.FjernTildeling(db, pulje, eventID, billettholderID, models.EventPlayerRoleGM); err != nil {
			tildelingsfeil(w, logger, err)
			return
		}
		if err := liveManager.Broadcast(r.Context(), live.BucketEvents, live.BucketInterests, live.BucketRooms); err != nil {
			logger.Error(fmt.Errorf("failed to broadcast GM removal: %w", err).Error(), "pulje_id", pulje, "event_id", eventID)
		}
		w.WriteHeader(http.StatusNoContent)
	})

	// Remove a manual pin (×). Manual-only: solver/GM rows are untouched. The
	// player's interest is kept, so the solver may re-seat them by simulation.
	router.Delete("/api/puljefordeling/{pulje}/{event}/{billettholderId}", func(w http.ResponseWriter, r *http.Request) {
		puljeID, ok := models.ParsePulje(chi.URLParam(r, "pulje"))
		if !ok {
			http.Error(w, "Invalid pulje ID", http.StatusBadRequest)
			return
		}
		eventID := chi.URLParam(r, "event")
		if eventID == "" {
			http.Error(w, "Event ID is required", http.StatusBadRequest)
			return
		}
		billettholderID, err := strconv.Atoi(chi.URLParam(r, "billettholderId"))
		if err != nil {
			http.Error(w, "Invalid billettholder ID", http.StatusBadRequest)
			return
		}

		// A published pulje is frozen: no assignment changes until it is unpublished.
		status, err := getPuljeStatus(db, puljeID)
		if err != nil {
			logger.Error(err.Error(), "pulje_id", puljeID)
			http.Error(w, "Failed to read pulje status", http.StatusInternalServerError)
			return
		}
		if puljeIsCompleted(status) {
			http.Error(w, "Pulje is published; changes are not allowed", http.StatusConflict)
			return
		}

		if err := puljefordeling.RemoveManualSeat(db, puljeID, eventID, billettholderID); err != nil {
			logger.Error(err.Error(), "pulje_id", puljeID, "event_id", eventID, "billettholder_id", billettholderID)
			http.Error(w, "Failed to remove manual seat", http.StatusInternalServerError)
			return
		}

		// Best-effort live refresh; a failed broadcast must not fail the request.
		if err := liveManager.Broadcast(r.Context(), live.BucketEvents); err != nil {
			logger.Error(fmt.Errorf("failed to broadcast manual seat removal: %w", err).Error(), "pulje_id", puljeID, "event_id", eventID)
		}

		w.WriteHeader(http.StatusNoContent)
	})
}

// findEmulatedPulje returns the emulated distribution for a single pulje.
func findEmulatedPulje(em puljefordeling.Emulation, pulje models.Pulje) (puljefordeling.EmulatedPulje, bool) {
	for _, p := range em.Puljer {
		if p.PuljeID == pulje {
			return p, true
		}
	}
	return puljefordeling.EmulatedPulje{}, false
}

// findPuljeRow returns the stored row (name + status) for a single pulje.
func findPuljeRow(puljer []models.PuljeRow, pulje models.Pulje) (models.PuljeRow, bool) {
	for _, p := range puljer {
		if p.ID == pulje {
			return p, true
		}
	}
	return models.PuljeRow{}, false
}

// unsatisfiedAfter returns how many interested participants still have no
// first-choice (top-choice) seat once the given pulje has been solved. The
// emulation processes puljer chronologically, so this is PlayerCount minus the
// running total of NewlySatisfied up to and including pulje. The bool is false
// when pulje is not part of the emulation.
func unsatisfiedAfter(em puljefordeling.Emulation, pulje models.Pulje) (int, bool) {
	cumulative := 0
	for _, p := range em.Puljer {
		cumulative += p.NewlySatisfied
		if p.PuljeID == pulje {
			return em.PlayerCount - cumulative, true
		}
	}
	return 0, false
}

templ puljefordelingIndex(db *sql.DB, logger *slog.Logger, current models.Pulje, eventImageDir *string) {
	@components.Breadcrumbs([]components.BreadcrumbPath{
		{Name: "Hjem", Url: "/"},
		{Name: "Admin", Url: "/admin/"},
		{Name: "Puljefordeling", Url: ""},
	})
	@puljefordelingPage(db, logger, current, eventImageDir)
	@puljeTildelingsDialog()
}

templ puljefordelingPage(db *sql.DB, logger *slog.Logger, current models.Pulje, eventImageDir *string) {
	{{
		em, emErr := puljefordeling.EmulateSeatings(db)
		if emErr != nil {
			logger.Error(fmt.Errorf("emulation failed: %w", emErr).Error())
		}
	}}
	<div
		id="puljefordeling-page"
		class="page-content-container flex flex-col"
		data-init={ live.DatastarInit(fmt.Sprintf("/admin/api/puljefordeling/%s", current)) }
		data-signals__ifmissing:assignment-event-id="''"
		data-signals__ifmissing:assignment-pulje-id="''"
		data-signals__ifmissing:assignment-billettholder-id="0"
		data-signals__ifmissing:assignment-picker-gm-only="false"
		data-signals__ifmissing:assignment-picker-title="'Administrer deltaker'"
		data-signals__ifmissing:assignment-interest-level="''"
		data-signals__ifmissing:assignment-close-dialog="false"
		data-signals__ifmissing:assignment-action-completed="false"
		data-signals__ifmissing:clear-input="0"
		data-signals__ifmissing:dragged-billettholder-id="0"
		data-signals__ifmissing:dragged-event-id="''"
		data-signals__ifmissing:dragged-manual-seat="false"
		data-signals__ifmissing:drag-over-event="''"
		data-signals__ifmissing:assignment-age-confirmed="false"
		data-signals__ifmissing:age-warning-text="''"
		data-signals__ifmissing:age-warning-billettholder-id="0"
		data-signals__ifmissing:age-warning-event-id="''"
		data-signals__ifmissing:age-warning-pulje-id="''"
		data-signals__ifmissing:age-warning-role="'Player'"
		data-signals__ifmissing:age-warning-from-add-menu="false"
		data-signals__ifmissing:age-warning-from-event-id="''"
		data-signals__ifmissing:age-warning-from-manual-seat="false"
		data-signals__ifmissing:_puljefordeling-assign-dialog-open="false"
	>
		<style>
			.pulje-tabs {
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-3x);
				margin-block-end: var(--responsive-page-section-spacing);

				a {
					white-space: nowrap;
					text-decoration: none;
					padding: var(--spacing-3x) var(--spacing-5x);
					border: 1px solid var(--level-3-border);
					border-radius: var(--border-radius-2x);
					background-color: var(--level-3-background);
					color: var(--color-text-soft);
					transition: border-color 200ms ease, color 200ms ease;
				}

				a:hover {
					border-color: var(--bg-item-border-hover);
					color: var(--color-text-strong);
				}

				a[aria-current="page"] {
					border: 2px solid var(--color-primary);
					padding: calc(var(--spacing-3x) - 1px) calc(var(--spacing-5x) - 1px);
					color: var(--color-primary);
				}
			}
		</style>
		<h1 class="page-heading">Puljefordeling</h1>
		<nav class="pulje-tabs" aria-label="Puljer">
			for _, pulje := range models.AllPuljer() {
				<a
					href={ "/admin/puljefordeling/" + pulje }
					class={ templ.KV("active", current == pulje) }
					if current == pulje {
						aria-current="page"
					}
				>{ pulje.Label() }</a>
			}
		</nav>
		@puljefordelingTabContent(db, logger, current, eventImageDir, em, emErr)
		@puljeAssignDialog(db, logger, current, em, emErr)
		@puljeAgeWarningDialog()
	</div>
}

templ PuljefordelingTabContent(db *sql.DB, logger *slog.Logger, pulje models.Pulje, eventImageDir *string) {
	{{
		em, emErr := puljefordeling.EmulateSeatings(db)
		if emErr != nil {
			logger.Error(fmt.Errorf("emulation failed: %w", emErr).Error())
		}
	}}
	@puljefordelingTabContent(db, logger, pulje, eventImageDir, em, emErr)
}

templ puljefordelingTabContent(db *sql.DB, logger *slog.Logger, pulje models.Pulje, eventImageDir *string, em puljefordeling.Emulation, emErr error) {
	{{
		puljer, puljerErr := getPuljer(db)
		if puljerErr != nil {
			logger.Error(fmt.Errorf("failed to load puljer: %w", puljerErr).Error())
		}
		row, hasRow := findPuljeRow(puljer, pulje)

		result, hasResult := findEmulatedPulje(em, pulje)
		unsatisfied, hasUnsatisfied := unsatisfiedAfter(em, pulje)
		var fordelingsvarsler []puljefordeling.Fordelingsvarsel
		var kapasitetsvarsler []puljefordeling.Kapasitetsvarsel
		var varslerErr error
		if emErr == nil && hasResult {
			fordelingsvarsler, varslerErr = puljefordeling.FinnFordelingsvarsler(db, result)
			if varslerErr == nil {
				kapasitetsvarsler, varslerErr = puljefordeling.FinnKapasitetsvarsler(db, result)
			}
			if varslerErr != nil {
				logger.Error(varslerErr.Error(), "component", "puljefordeling", "pulje_id", pulje)
			}
		}
	}}
	<style>
        .pulje-section {
            container: pulje-section / inline-size;
            display: flex;
            flex-direction: column;
            gap: var(--responsive-page-section-spacing);
        }
        .pulje-meta-panel {
            display: grid;
            gap: var(--spacing-5x);
            padding: var(--spacing-5x);
            border-radius: var(--border-radius-2x);
            background-color: var(--level-2-background);
        }
        @container pulje-section (width > 800px) {
            .pulje-meta-panel {
                grid-template-columns: 1fr minmax(16rem, auto);
            }
        }
        .pulje-meta {
            display: flex;
            flex-direction: column;
            place-content: center;
            gap: var(--spacing-3x);
            padding: var(--spacing-5x);
            border: 1px solid var(--level-3-border);
            border-radius: var(--border-radius-2x);
            background-color: var(--level-3-background);
        }
        .pulje-tab-stats {
            display: flex;
            gap: var(--spacing-2x) var(--spacing-4x);
            flex-wrap: wrap;
            color: var(--color-text-strong);
        }
        .pulje-tab-warn {
            color: var(--color-warning);
        }
        .pulje-status-controls {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-3x);
        }
        .pulje-status-control {
            display: flex;
            place-items: center start;
            gap: var(--spacing-3x);
            padding: var(--spacing-3x) var(--spacing-4x);
            border: 1px solid var(--level-3-border);
            border-radius: var(--border-radius-2x);
            background-color: var(--level-3-background);
            color: var(--color-text-soft);
            cursor: pointer;
            transition: border-color 200ms ease;

            &:hover {
                border-color: var(--bg-item-border-hover);
            }
            &:has(input:checked) {
                color: var(--color-text-strong);
            }
            &:has(input:disabled) {
                cursor: not-allowed;
                color: var(--color-disabled);
            }
            input {
                flex: 0 0 auto;
            }
        }
        .pulje-legend {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-1x);
            color: var(--color-text-soft);
            font-size: var(--text-body-small);

            p {
                margin: 0;
            }
            .legend-dm-name {
                color: turquoise;
            }
            .legend-icon {
                display: inline-flex;
                vertical-align: middle;
            }
        }
        .pulje-events-header {
            display: flex;
            flex-wrap: wrap;
            place-content: space-between;
            place-items: center;
            gap: var(--spacing-3x) var(--spacing-5x);
        }
        .pulje-commit-bar {
            display: flex;
            flex-wrap: wrap;
            place-items: center;
            gap: var(--spacing-3x) var(--spacing-5x);

            p {
                margin: 0;
                font-style: italic;
                color: var(--color-text-strong);
            }
        }
        .pulje-event-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: var(--responsive-page-section-spacing);
        }
        .pulje-event {
            container: pulje-event / inline-size;
            display: flex;
            flex-direction: column;
            gap: var(--spacing-5x);
            padding: var(--spacing-4x);
            border: 1px solid var(--level-3-border);
            border-radius: var(--border-radius-2x);
            background-color: var(--level-1-background);
            transition: border-color 300ms ease-in-out;

            &:hover {
                border-color: var(--bg-item-border-hover);
            }
            &.is-drag-over {
                border-color: var(--color-primary);
            }
        }
        .pulje-event-header {
            display: flex;
            place-items: start;
            gap: var(--spacing-3x);
        }
        .pulje-event-thumb {
            display: block;
            flex: 0 0 auto;
            inline-size: clamp(5rem, 25cqi, 7.5rem);
            block-size: auto;
            aspect-ratio: 2 / 1;
            object-fit: cover;
            border-radius: var(--border-radius-1x);
            background-color: var(--level-3-background);
        }
        .pulje-event-heading {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-1x);
            min-inline-size: 0;

            h3 {
                color: var(--color-text-strong);
                font-size: 1.25rem;
                font-weight: 700;
                overflow-wrap: anywhere;
            }
        }
        .pulje-event-system {
            margin: 0;
            color: var(--color-primary);
        }
        /* Game type with its label, then icon-only property badges. */
        .pulje-tags {
            display: flex;
            flex-wrap: wrap;
            place-content: space-between;
            place-items: center;
            gap: var(--spacing-2x) var(--spacing-4x);
            color: var(--color-text-soft);
            font-size: var(--text-body-small);
        }
        .pulje-event-type {
            display: inline-flex;
            place-items: center;
            gap: var(--spacing-2x);
        }
        .pulje-tag-icons {
            display: flex;
            gap: var(--spacing-3x);
            margin: 0;
            padding: 0;
            list-style: none;

            li {
                display: inline-flex;
            }
        }
        .pulje-event-group {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-2x);
        }
        .pulje-group-header {
            display: flex;
            place-content: space-between;
            place-items: center;
            gap: var(--spacing-2x);
        }
        .pulje-group-heading {
            margin: 0;
            color: var(--color-text-strong);
            font-size: var(--text-body-small);
            font-weight: 600;
        }
        .pulje-capacity {
            display: flex;
            place-items: center;
            gap: var(--spacing-3x);
        }
        .pulje-cap-bar {
            inline-size: clamp(3rem, 20cqi, 5rem);
            block-size: 4px;
            border-radius: 2px;
            background: linear-gradient(
                to right,
                var(--color-text-strong) var(--fill),
                color-mix(in srgb, #C6CDF1 20%, transparent) var(--fill)
            );
        }
        .pulje-cap {
            display: inline-flex;
            place-items: center;
            gap: var(--spacing-1x);
            padding: var(--spacing-1x) var(--spacing-2x);
            border-radius: 999px;
            background-color: var(--level-2-background);
            color: var(--color-text-strong);
            font-size: var(--text-body-small);
            font-weight: 600;
            white-space: nowrap;
        }
        .pulje-players li[draggable="true"] {
            cursor: grab;
        }
        .pulje-players li.is-dragging {
            opacity: 0.5;
        }
        .pulje-badge--error {
            color: var(--color-text-error, #e05050);
        }
        .pulje-badge {
            align-self: flex-start;
            padding: 0 var(--spacing-2x);
            border-radius: var(--border-radius-1x);
            background-color: var(--bg-surface);
            color: var(--color-text-warning, #e0a030);
            font-size: var(--text-small, 0.85rem);
        }
        .pulje-players {
            margin: 0;
            padding: 0;
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: var(--spacing-2x);

        }
        .pulje-players li,
        .pulje-gm {
            display: flex;
            place-items: center;
            gap: var(--spacing-2x);
            min-block-size: var(--btn-height);
            margin: 0;
            padding: var(--spacing-2x) var(--spacing-4x);
            border: 1px solid var(--level-3-border);
            border-radius: var(--border-radius-1x);
            background-color: var(--level-3-background);
            color: var(--color-text-strong);
        }
        .pulje-player-name {
            flex: 1 1 auto;
            min-inline-size: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .pulje-dm {
            color: turquoise;
        }
        .pulje-marker {
            display: inline-flex;
            flex: 0 0 auto;
        }
        .pulje-marker--moved {
            color: var(--color-error);
        }
        .pulje-marker--pin {
            color: var(--color-accent-orange);
        }
        .pulje-remove {
            flex: 0 0 auto;
            border: none;
            background: transparent;
            color: var(--color-text-soft);
            cursor: pointer;
            line-height: 1;
            padding: 0 var(--spacing-1x);

            &:hover {
                color: var(--color-error);
            }
        }
        .pulje-row {
            display: flex;
            flex-wrap: wrap;
            place-content: space-between;
            place-items: center;
            gap: var(--spacing-2x) var(--spacing-4x);
            inline-size: 100%;
            min-block-size: var(--btn-height);
            margin: 0;
            padding: var(--spacing-2x) var(--spacing-4x);
            border: 1px dashed var(--level-3-border);
            border-radius: var(--border-radius-1x);
            background-color: var(--level-2-background);
            color: var(--color-text-soft);
            font: inherit;
            text-align: start;
        }
        button.pulje-row {
            cursor: pointer;
            transition: border-color 200ms ease;

            &:hover {
                border-color: var(--color-primary);
            }
        }
        .pulje-row-status {
            display: inline-flex;
            place-items: center;
            gap: var(--spacing-2x);
            font-style: italic;
        }
        .pulje-row-status--warning {
            color: var(--color-error);

            .inline-icon {
                color: var(--color-warning);
            }
        }
        .pulje-row-action {
            display: inline-flex;
            place-items: center;
            gap: var(--spacing-2x);
            margin-inline-start: auto;
            color: var(--color-text-soft);
            font-weight: 600;
        }
        .pulje-emoji {
            flex: 0 0 auto;
            width: 1.4em;
            text-align: center;
        }
        .pulje-empty {
            color: var(--color-text-soft-50);
            font-style: italic;
        }
        .pulje-unassigned {
            padding: var(--spacing-4x) var(--spacing-5x);
            border-radius: var(--border-radius-2x);
            background-color: var(--level-2-background);
            color: var(--color-text-soft);

            h3 {
                margin-block-end: var(--spacing-2x);
                font-size: var(--text-body);
                color: var(--color-text-strong);
            }
            p {
                margin: 0;
            }
        }
        .pulje-error {
            color: var(--color-text-error, #e05050);
        }
        @container pulje-section (width > 1000px) {
            .pulje-event-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @container pulje-section (width > 1600px) {
            .pulje-event-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
    </style>
	<section
		id="puljefordeling-tab"
		class="pulje-section"
		data-signals:pulje-status={ fmt.Sprintf("'%s'", string(row.Status)) }
	>
		if hasRow {
			<h2>{ row.Name }</h2>
		} else {
			<h2>{ pulje.Label() }</h2>
		}
		<div class="pulje-meta-panel">
			<div class="pulje-meta">
				if hasResult {
					<div class="pulje-tab-stats">
						<span>{ fmt.Sprintf("%d fikk førstevalg", result.NewlySatisfied) }</span>
						if hasUnsatisfied {
							<span>{ fmt.Sprintf("%d uten førstevalg så langt", unsatisfied) }</span>
						}
						<span>{ fmt.Sprintf("%d interessepoeng", result.TotalScore) }</span>
						if len(result.Unassigned) > 0 {
							<span class="pulje-tab-warn">{ fmt.Sprintf("%d uten plass", len(result.Unassigned)) }</span>
						}
					</div>
				}
				<div class="pulje-legend">
					<p>🤩 Veldig interessert · 😁 Interessert · 🙂 Litt interessert · 🫥 Ikke interessert</p>
					<p><span class="legend-dm-name">Turkis navn</span> = Spilleder</p>
					<p>
						<span class="legend-icon pulje-marker--moved">
							@icons.Icon(icons.MovedDown, icons.Size16)
						</span> Flyttet ned for å gi plass ·
						<span class="legend-icon pulje-marker--pin">
							@icons.Icon(icons.Pin, icons.Size16)
						</span> Manuelt plassert
					</p>
				</div>
			</div>
			if hasRow {
				@puljeStatusToggles(row)
			}
		</div>
		<div class="pulje-events-header">
			if hasResult {
				<h2>{ antallTekst(len(result.Events), "arrangement", "arrangementer") }</h2>
			} else {
				<h2>Arrangementer</h2>
			}
			<div class="pulje-commit-bar">
				if puljeIsCompleted(row.Status) {
					<p>Fordelingen er publisert og kan ikke endres.</p>
				} else {
					<p>Fordelingen er midlertidig frem til du lagrer.</p>
				}
				<button
					type="button"
					class="btn btn--primary pulje-commit"
					disabled?={ puljeIsCompleted(row.Status) }
					data-on:click={ fmt.Sprintf("if (confirm('Lagre denne fordelingen? Den blir tilgjengelig i andre visninger.')) { @post('/admin/api/puljefordeling/%s/commit') }", string(pulje)) }
				>Lagre fordeling</button>
			</div>
		</div>
		if emErr != nil {
			<p class="pulje-error">Kunne ikke beregne fordeling: { emErr.Error() }</p>
		} else if !hasResult {
			<p class="pulje-empty">Ingen fordeling å vise for denne puljen ennå.</p>
		} else {
			if varslerErr != nil {
				<p class="pulje-error">Kunne ikke kontrollere tildelinger og kapasitet.</p>
			} else {
				@puljeFordelingsvarsler(pulje, fordelingsvarsler, kapasitetsvarsler)
			}
			if len(result.Unassigned) > 0 {
				<div class="pulje-unassigned">
					<h3>{ antallTekst(len(result.Unassigned), "deltaker", "deltakere") + " uten plass" }</h3>
					<p>{ strings.Join(result.Unassigned, ", ") }</p>
				</div>
			}
			<div class="pulje-event-grid">
				for _, ev := range result.Events {
					@puljeEventBox(pulje, ev, puljeIsCompleted(row.Status), eventImageDir)
				}
			</div>
		}
	</section>
}

func antallTekst(antall int, entall, flertall string) string {
	if antall == 1 {
		return fmt.Sprintf("%d %s", antall, entall)
	}
	return fmt.Sprintf("%d %s", antall, flertall)
}

// puljeAgeConfirmAction re-posts the pending placement with the age confirmation
// flag set. The flag is page-global and travels with every request, so it is
// reset on the very next statement: datastar serialises the signal payload
// synchronously inside the action call, and clearing it later (in a .finally())
// would leave every placement fired while the re-post is in flight silently
// pre-confirmed. datastar compiles expressions with a plain Function(), so
// `await` is a SyntaxError and must not be used here.
func puljeAgeConfirmAction() string {
	return "$assignmentBillettholderId = $ageWarningBillettholderId; " +
		"$assignmentEventId = $ageWarningEventId; " +
		"$assignmentPuljeId = $ageWarningPuljeId; " +
		"$assignmentRole = $ageWarningRole; " +
		"$assignmentFromAddMenu = $ageWarningFromAddMenu; " +
		"$assignmentFromEventId = $ageWarningFromEventId; " +
		"$assignmentFromManualSeat = $ageWarningFromManualSeat; " +
		"$assignmentConfirmation = ''; " +
		"$assignmentAgeConfirmed = true; " +
		"$assignmentCloseDialog = true; " +
		"@post('/admin/api/puljefordeling/assign'); " +
		"$assignmentCloseDialog = false; " +
		"$assignmentAgeConfirmed = false; " +
		"$assignmentFromAddMenu = false; " +
		"$ageWarningText = ''; " +
		"document.getElementById('puljefordeling-age-dialog').close()"
}

// puljeAgeWarningDialog is the confirmation the server asks for before an admin
// pins a participant under 18 into an 18+ game. The check is server-side (the
// picker only knows the billettholder id), so this dialog is opened by the
// $ageWarningText signal the assign endpoint patches back.
templ puljeAgeWarningDialog() {
	<dialog
		id="puljefordeling-age-dialog"
		closedBy="any"
		data-effect="$ageWarningText && document.getElementById('puljefordeling-age-dialog').showModal()"
		data-on:close="$ageWarningText = ''"
	>
		<h3>Aldersgrense</h3>
		<p data-text="$ageWarningText"></p>
		<button
			class="btn btn--outline"
			type="button"
			data-on:click="$ageWarningText = ''; document.getElementById('puljefordeling-age-dialog').close()"
		>Avbryt</button>
		<button
			class="btn"
			type="button"
			data-on:click={ puljeAgeConfirmAction() }
		>Plasser likevel</button>
	</dialog>
}

templ puljeStatusToggles(pulje models.PuljeRow) {
	<div class="pulje-status-controls">
		<label class="pulje-status-control">
			<input
				if pulje.ClosingWarningActive {
					checked
				}
				if pulje.Status != models.PuljeStatusOpen {
					disabled
				}
				data-on:click={ fmt.Sprintf("if (!confirm('Vil du endre varselet for %s?')) { evt.preventDefault(); } else { $closingWarningActive = evt.currentTarget.checked; @put('/admin/api/puljer/%s/closing-warning') }", pulje.Name, pulje.ID) }
				type="checkbox"
				class="checkbox input"
			/>
			<span>Vis advarsel om at puljefordeling stenger snart</span>
		</label>
		<label class="pulje-status-control">
			<input
				if puljeIsLocked(pulje.Status) {
					checked
				}
				data-on:click={ puljeStatusUpdateAction(
					pulje,
					fmt.Sprintf("Vil du endre lukking for %s?", pulje.Name),
					models.PuljeStatusLocked,
					models.PuljeStatusOpen,
				) }
				type="checkbox"
				class="checkbox input"
			/>
			<span>Puljefordeling lukket</span>
		</label>
		<label class="pulje-status-control">
			<input
				if puljeIsCompleted(pulje.Status) {
					checked
				}
				data-on:click={ puljeStatusUpdateAction(
					pulje,
					fmt.Sprintf("Vil du endre publisering av puljefordeling for %s?", pulje.Name),
					models.PuljeStatusCompleted,
					models.PuljeStatusLocked,
				) }
				type="checkbox"
				class="checkbox input"
			/>
			<span>Puljefordeling publisert</span>
		</label>
	</div>
}

templ puljeEventBox(pulje models.Pulje, ev puljefordeling.EmulatedEvent, published bool, eventImageDir *string) {
	{{
		// A non-published event box is a drop target: dropping a dragged player
		// pins them here via the assign endpoint (mirrors the rooms drag-and-drop).
		dropAttrs := templ.Attributes{}
		if !published {
			dropAttrs["data-on:dragover__prevent"] = fmt.Sprintf("$dragOverEvent = '%s'", ev.EventID)
			dropAttrs["data-on:drop__prevent"] = fmt.Sprintf("$dragOverEvent = ''; $draggedBillettholderId && (($assignmentBillettholderId = $draggedBillettholderId), ($assignmentEventId = %q), ($assignmentPuljeId = %q), ($assignmentFromEventId = $draggedEventId), ($assignmentFromManualSeat = $draggedManualSeat), ($assignmentRole = 'Player'), ($assignmentFromAddMenu = false), ($assignmentConfirmation = ''), ($assignmentAgeConfirmed = false), @post('/admin/api/puljefordeling/assign'))", ev.EventID, string(pulje))
			dropAttrs["data-class:is-drag-over"] = fmt.Sprintf("$dragOverEvent === '%s'", ev.EventID)
		}
		imageBannerUrl := eventimage.GetEventImageUrl(ev.EventID, "banner", eventImageDir)
	}}
	<article class={ "pulje-event", templ.KV("missing-dm", ev.GMName == "") } { dropAttrs... }>
		<header class="pulje-event-header">
			<img class="pulje-event-thumb" src={ imageBannerUrl } alt="" aria-hidden="true"/>
			<div class="pulje-event-heading">
				<h3>{ ev.Title }</h3>
				if ev.System != "" {
					<p class="pulje-event-system">{ ev.System }</p>
				}
			</div>
		</header>
		@puljeEventTags(ev)
		<section class="pulje-event-group" aria-label="Spilleder">
			<h4 class="pulje-group-heading">Spilleder</h4>
			if len(ev.AssignedGMs) > 0 {
				for _, gm := range ev.AssignedGMs {
					<p class="pulje-gm">
						<span class="pulje-player-name">{ gm.Name }</span>
						if ev.AgeGroup == models.AgeGroupAdultsOnly && !gm.IsOver18 {
							<span class="pulje-badge pulje-badge--error">Under 18</span>
						}
						if !published {
							<button type="button" class="pulje-remove" aria-label={ "Fjern spilleder " + gm.Name } title={ "Fjern spilleder " + gm.Name } data-on:click={ fmt.Sprintf("@delete('/admin/api/puljefordeling/%s/%s/%d/gm')", string(pulje), ev.EventID, gm.BillettholderID) }>×</button>
						}
					</p>
				}
			} else if published {
				<p class="pulje-row pulje-row--static">
					@puljeRowStatus("Mangler spilleder", true)
				</p>
			} else {
				<button
					type="button"
					class="pulje-row pulje-missing-gm"
					aria-haspopup="dialog"
					aria-controls="puljefordeling-assign-dialog"
					data-on:click={ puljeAssignDialogAction(pulje, ev, true) }
				>
					@puljeRowStatus("Mangler spilleder", true)
					@puljeRowAction("Finn spilleder")
				</button>
			}
		</section>
		<section class="pulje-event-group" aria-label="Deltakere">
			<div class="pulje-group-header">
				<h4 class="pulje-group-heading">Deltakere</h4>
				<div class="pulje-capacity">
					<span class="pulje-cap-bar" aria-hidden="true" style={ templ.SafeCSS(fmt.Sprintf("--fill: %d%%;", puljeCapacityPercent(ev))) }></span>
					<span class="pulje-cap" title="Deltakere / plasser">
						{ fmt.Sprintf("%d / %d", len(ev.AssignedPlayers), ev.Capacity) }
						@icons.Icon(icons.User, icons.Size16)
					</span>
				</div>
			</div>
			if len(ev.AssignedPlayers) > 0 {
				<ul class="pulje-players">
					for _, pl := range ev.AssignedPlayers {
						{{
							tileAttrs := templ.Attributes{}
							if !published {
								tileAttrs["draggable"] = "true"
								tileAttrs["data-on:dragstart"] = fmt.Sprintf("$draggedBillettholderId = %d; $draggedEventId = %q; $draggedManualSeat = %t", pl.BillettholderID, ev.EventID, pl.Manual)
								tileAttrs["data-on:dragend"] = "$draggedBillettholderId = 0; $draggedEventId = ''; $draggedManualSeat = false; $dragOverEvent = ''"
								tileAttrs["data-class:is-dragging"] = fmt.Sprintf("$draggedBillettholderId === %d && $draggedEventId === %q", pl.BillettholderID, ev.EventID)
							}
						}}
						<li class={ templ.KV("moved", pl.Moved), templ.KV("manual", pl.Manual) } { tileAttrs... }>
							<span class={ "pulje-player-name", templ.KV("pulje-dm", pl.IsDM) }>{ pl.Name }</span>
							if ev.AgeGroup == models.AgeGroupAdultsOnly && !pl.IsOver18 {
								<span class="pulje-badge pulje-badge--error">Under 18</span>
							}
							if pl.Moved {
								<span class="pulje-marker pulje-marker--moved" title="Flyttet ned for å gi plass">
									@icons.Icon(icons.MovedDown, icons.Size20)
								</span>
							}
							if pl.Manual {
								<span class="pulje-marker pulje-marker--pin" title="Manuelt plassert">
									@icons.Icon(icons.Pin, icons.Size20)
								</span>
							}
							<span class="pulje-emoji" title={ pl.Level.Label() }>{ pl.Level.Emoji() }</span>
							if pl.Manual && !published {
								<button
									type="button"
									class="pulje-remove"
									title="Fjern manuell plassering"
									data-on:click={ fmt.Sprintf("@delete('/admin/api/puljefordeling/%s/%s/%d')", string(pulje), ev.EventID, pl.BillettholderID) }
								>×</button>
							}
						</li>
					}
				</ul>
			}
			{{ playerStatus, playerWarning := puljePlayerRowStatus(ev) }}
			if !published {
				<button
					type="button"
					class="pulje-row pulje-add"
					aria-haspopup="dialog"
					aria-controls="puljefordeling-assign-dialog"
					data-on:click={ puljeAssignDialogAction(pulje, ev, false) }
				>
					if playerStatus != "" {
						@puljeRowStatus(playerStatus, playerWarning)
					}
					@puljeRowAction("Finn deltaker")
				</button>
			} else if playerWarning {
				<p class="pulje-row pulje-row--static">
					@puljeRowStatus(playerStatus, true)
				</p>
			}
		</section>
	</article>
}

// puljeCapacityPercent is how full the event is, capped at 100 so an
// over-capacity event does not overflow the capacity bar.
func puljeCapacityPercent(ev puljefordeling.EmulatedEvent) int {
	if ev.Capacity <= 0 {
		return 0
	}
	return min(100, len(ev.AssignedPlayers)*100/ev.Capacity)
}

// puljePlayerRowStatus describes the open player seats shown in the dashed row
// under the participant list, and whether that state needs the admin's attention.
func puljePlayerRowStatus(ev puljefordeling.EmulatedEvent) (string, bool) {
	switch {
	case len(ev.AssignedPlayers) == 0:
		return "Ingen deltakere", true
	case ev.Undersubscribed:
		return "Veldig få deltakere", true
	case len(ev.AssignedPlayers) < ev.Capacity:
		return "Ledig plass", false
	default:
		return "", false
	}
}

templ puljeRowStatus(text string, warning bool) {
	<span class={ "pulje-row-status", templ.KV("pulje-row-status--warning", warning) }>
		if warning {
			@icons.Icon(icons.Warning, icons.Size20)
		}
		{ text }
	</span>
}

templ puljeRowAction(text string) {
	<span class="pulje-row-action">
		{ text }
		@icons.Icon(icons.Plus, icons.Size20)
	</span>
}

// puljeEventTags renders the event's game type with its label, followed by
// icon-only badges for age group, runtime, beginner and English, using the same
// SVG icons as the event detail page. The badges carry their label as a tooltip.
templ puljeEventTags(ev puljefordeling.EmulatedEvent) {
	<div class="pulje-tags">
		<span class="pulje-event-type">
			switch ev.EventType {
				case models.EventTypeRoleplay:
					@icons.Icon(icons.EventRoleplay, icons.Size32)
				case models.EventTypeBoardGame:
					@icons.Icon(icons.EventBoardgame, icons.Size32)
				case models.EventTypeCardGame:
					@icons.Icon(icons.EventCardgame, icons.Size32)
				case models.EventTypeOther:
					@icons.Icon(icons.EventOtherGames, icons.Size32)
			}
			{ ev.EventType.Label() }
		</span>
		<ul class="pulje-tag-icons">
			if ev.AgeGroup == models.AgeGroupAdultsOnly {
				@puljeTagIcon(ev.AgeGroup.BadgeLabel(), icons.EventAdultOnly)
			}
			if ev.AgeGroup == models.AgeGroupChildFriendly {
				@puljeTagIcon(ev.AgeGroup.BadgeLabel(), icons.EventChildFriendly)
			}
			if ev.Runtime == models.RunTimeLongRunning {
				@puljeTagIcon(ev.Runtime.BadgeLabel(), icons.TimeOver6Hours)
			}
			if ev.Runtime == models.RunTimeShortRunning {
				@puljeTagIcon(ev.Runtime.BadgeLabel(), icons.TimeUnder3Hours)
			}
			if ev.BeginnerFriendly {
				@puljeTagIcon("Nybegynnervennlig", icons.EventBeginnerFriendly)
			}
			if ev.CanBeRunInEnglish {
				@puljeTagIcon("Can be run in English", icons.EventEnglish)
			}
		</ul>
	</div>
}

templ puljeTagIcon(label string, icon icons.IconType) {
	<li title={ label } aria-label={ label }>
		@icons.Icon(icon, icons.Size32)
	</li>
}
