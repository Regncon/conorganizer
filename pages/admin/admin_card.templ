package admin

templ adminCardStyles() {
	<style>
		.admin-section {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-4x);
		}

		.admin-section-cards {
			display: grid;
			grid-template-columns: 1fr;
			gap: var(--spacing-4x);
		}

		@container main (width > 40rem) {
			.admin-section-cards {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		.admin-tool-card {
			display: flex;
			place-items: center;
			gap: var(--spacing-4x);
			inline-size: 100%;
			box-sizing: border-box;
			background-color: var(--level-2-background);
			border: 1px solid var(--level-2-border);
			border-radius: var(--border-radius-2x);
			padding: var(--spacing-4x);
			text-decoration: none;
			color: inherit;
		}

		a.admin-tool-card:is(:hover, :focus-visible) {
			background-color: var(--level-2-background-hover);
			border-color: var(--level-2-border-hover);
		}

		a.admin-tool-card:active {
			background-color: var(--level-2-background-active);
			border-color: var(--level-2-border-hover);
		}

		.admin-tool-card--wide {
			grid-column: 1 / -1;
			flex-wrap: wrap;
			row-gap: var(--spacing-4x);
		}

		.admin-tool-graphic {
			flex: 0 0 auto;
			display: flex;
			place-content: center;
			place-items: center;
			inline-size: 4.25rem;
			block-size: 4.25rem;
			background-image: url("/static/admin/frame.svg");
			background-repeat: no-repeat;
			background-position: center;
			background-size: contain;
		}

		.admin-tool-graphic img {
			inline-size: 2.75rem;
			block-size: auto;
		}

		.admin-tool-card-body {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-1x);
			min-inline-size: 0;
			flex: 1 1 12rem;
		}

		.admin-tool-title {
			color: var(--color-text-strong);
		}

		.admin-tool-description {
			margin: 0;
			color: var(--color-text-soft);
			font-size: var(--text-body-small);
		}

		.admin-tool-print-link {
			color: var(--color-primary);
			font-size: var(--text-body-small);
			text-decoration: underline;

			.inline-icon {
				display: inline-block;
				vertical-align: middle;
				margin-inline-start: var(--spacing-1x);
			}
		}

		.admin-tool-print-link:is(:hover, :focus-visible) {
			color: var(--color-primary-hover);
		}

		@container main (width > 40rem) {
			.admin-tool-card--wide {
				flex-wrap: nowrap;
			}
		}
	</style>
}

templ adminToolGraphic(graphic string) {
	<span class="admin-tool-graphic" aria-hidden="true">
		<img src={ graphic } alt=""/>
	</span>
}

templ adminToolCard(slug string, title string, href string, graphic string, description string) {
	<a class="admin-tool-card" href={ templ.URL(href) } data-admin-tool={ slug }>
		@adminToolGraphic(graphic)
		<div class="admin-tool-card-body">
			<strong class="admin-tool-title">{ title }</strong>
			<p class="admin-tool-description">{ description }</p>
		</div>
	</a>
}
