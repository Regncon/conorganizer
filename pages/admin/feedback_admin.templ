package admin

import (
	"database/sql"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"strconv"

	"github.com/Regncon/conorganizer/components"
	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/layouts"
	"github.com/Regncon/conorganizer/service/feedback"
	"github.com/Regncon/conorganizer/service/program"
	"github.com/Regncon/conorganizer/service/userctx"
	"github.com/go-chi/chi/v5"
	datastar "github.com/starfederation/datastar-go/datastar"
)

// feedbackAdminRoute registers the admin list of user-submitted feedback.
func feedbackAdminRoute(router chi.Router, db *sql.DB, logger *slog.Logger) {
	logger = logger.With("component", "feedback_admin")

	router.Get("/tilbakemeldinger/", func(w http.ResponseWriter, r *http.Request) {
		ctx := r.Context()
		userInfo := userctx.GetUserRequestInfo(ctx)

		activeCategory := resolveFeedbackCategoryFilter(r.URL.Query().Get("om"))
		entries, err := feedback.List(db, activeCategory)
		if err != nil {
			logger.Error(fmt.Errorf("failed to list feedback: %w", err).Error(), "user_id", userInfo.Id)
			http.Error(w, "Klarte ikke å hente tilbakemeldinger.", http.StatusInternalServerError)
			return
		}

		if err := layouts.Base(
			"Tilbakemeldinger",
			userInfo,
			db,
			logger,
			feedbackAdminPage(entries, activeCategory),
		).Render(ctx, w); err != nil {
			logger.Error(fmt.Errorf("failed to render feedback admin page: %w", err).Error(), "user_id", userInfo.Id)
		}
	})

	router.Delete("/tilbakemeldinger/{id}", func(w http.ResponseWriter, r *http.Request) {
		ctx := r.Context()
		userInfo := userctx.GetUserRequestInfo(ctx)

		id, err := strconv.Atoi(chi.URLParam(r, "id"))
		if err != nil {
			http.Error(w, "Ugyldig tilbakemelding.", http.StatusBadRequest)
			return
		}
		if err := feedback.Delete(db, id); err != nil {
			if errors.Is(err, feedback.ErrNotFound) {
				http.Error(w, "Fant ikke tilbakemeldingen.", http.StatusNotFound)
				return
			}
			logger.Error(fmt.Errorf("failed to delete feedback: %w", err).Error(), "user_id", userInfo.Id, "feedback_id", id)
			http.Error(w, "Klarte ikke å slette tilbakemeldingen.", http.StatusInternalServerError)
			return
		}
		logger.Info("feedback deleted", "user_id", userInfo.Id, "feedback_id", id)

		// Re-render the list the admin was looking at, so the count and the
		// category filter stay right.
		activeCategory := resolveFeedbackCategoryFilter(r.URL.Query().Get("om"))
		entries, err := feedback.List(db, activeCategory)
		if err != nil {
			logger.Error(fmt.Errorf("failed to list feedback after delete: %w", err).Error(), "user_id", userInfo.Id)
			http.Error(w, "Klarte ikke å hente tilbakemeldinger.", http.StatusInternalServerError)
			return
		}
		sse := datastar.NewSSE(w, r)
		if err := sse.PatchElementTempl(feedbackAdminContent(entries, activeCategory)); err != nil {
			logger.Error(fmt.Errorf("failed to patch feedback list: %w", err).Error(), "user_id", userInfo.Id)
		}
	})

	feedbackQRRoute(router, db, logger)
}

// resolveFeedbackCategoryFilter maps the ?om= query slug to a category.
// An empty or unrecognized slug means no filter (show every category).
func resolveFeedbackCategoryFilter(slug string) feedback.Category {
	if slug == "" {
		return ""
	}
	category, ok := feedback.CategoryFromSlug(slug)
	if !ok {
		return ""
	}
	return category
}

// formatFeedbackTime shows when feedback was sent in the convention's time
// zone. created_at is stored in UTC.
func formatFeedbackTime(createdAt models.DBDateTime) string {
	if !createdAt.Valid {
		return ""
	}
	value := createdAt.Time
	if location, err := program.Location(); err == nil {
		value = value.In(location)
	}
	return value.Format("02.01.2006 15:04")
}

// feedbackCountLabel is the Norwegian entry count, singular or plural.
func feedbackCountLabel(count int) string {
	if count == 1 {
		return "1 tilbakemelding"
	}
	return fmt.Sprintf("%d tilbakemeldinger", count)
}

// feedbackDeleteAction is the datastar action that deletes one entry and
// re-renders the list with the admin's current category filter.
func feedbackDeleteAction(id int, activeCategory feedback.Category) string {
	url := fmt.Sprintf("/admin/tilbakemeldinger/%d", id)
	if activeCategory != "" {
		url += "?om=" + activeCategory.Slug()
	}
	return fmt.Sprintf("@delete('%s')", url)
}

func feedbackDeleteDialogID(id int) string {
	return fmt.Sprintf("feedback-delete-dialog-%d", id)
}

// feedbackFilterHref is the ?om=<slug> link for one category filter.
func feedbackFilterHref(category feedback.Category) string {
	if category == "" {
		return "/admin/tilbakemeldinger/"
	}
	return "/admin/tilbakemeldinger/?om=" + category.Slug()
}

templ feedbackAdminPage(entries []feedback.Entry, activeCategory feedback.Category) {
	@components.Breadcrumbs([]components.BreadcrumbPath{
		{Name: "Hjem", Url: "/"},
		{Name: "Admin", Url: "/admin/"},
		{Name: "Tilbakemeldinger", Url: ""},
	})
	<style>
		.feedback-admin {
			container-type: inline-size;
			container-name: feedback-admin;
			display: flex;
			flex-direction: column;
			gap: var(--responsive-page-section-spacing);
		}

		.feedback-filter-tabs {
			display: flex;
			flex-wrap: wrap;
			gap: var(--spacing-2x);

			a[aria-current="page"] {
				border-color: var(--color-primary);
				color: var(--color-primary);
			}
		}

		.feedback-count {
			color: var(--color-text-soft);
		}

		.feedback-list {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-3x);
			list-style: none;
			margin: 0;
			padding-inline-start: 0;
		}

		.feedback-entry {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-2x);

			.feedback-entry-meta {
				display: flex;
				flex-wrap: wrap;
				place-content: start space-between;
				gap: var(--spacing-2x);
				font-size: var(--text-body-small);
				color: var(--color-text-soft);
			}

			.feedback-entry-category {
				font-weight: 600;
				color: var(--color-primary);
			}

			.feedback-entry-topics {
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-1x);
				list-style: none;
				margin: 0;
				padding-inline-start: 0;
			}

			.feedback-entry-topic {
				font-size: var(--text-body-small);
				color: var(--color-text-soft);
				background: var(--bg-item);
				border: 1px solid var(--bg-item-border);
				border-radius: var(--border-radius-2x);
				padding-block: var(--spacing-1x);
				padding-inline: var(--spacing-2x);
			}

			.feedback-entry-text {
				margin: 0;
				max-inline-size: min(70ch, 100cqi);
				white-space: pre-wrap;
				overflow-wrap: anywhere;
			}
		}

		.feedback-empty {
			color: var(--color-text-soft);
		}

		.feedback-entry-actions {
			display: flex;
			place-content: end;
		}

		.feedback-danger {
			color: var(--color-error);
			border-color: var(--color-error);
		}

		:is(.feedback-delete-button, .feedback-delete-dialog .btn) {
			display: inline-flex;
			place-items: center;
			gap: var(--spacing-2x);
		}

		.feedback-delete-dialog {
			inline-size: min(28rem, calc(100dvw - 2rem));
			padding: var(--spacing-5x);
			border: 1px solid var(--level-3-border);
			border-radius: var(--border-radius-2x);
			background-color: var(--level-1-background);
			box-shadow: var(--shadow-dialog);
			color: var(--color-text-strong);

			&[open] {
				display: grid;
				gap: var(--spacing-3x);
			}

			&::backdrop {
				background-color: rgb(0 0 0 / 60%);
			}

			:is(h2, p) {
				margin: 0;
			}

			h2 {
				font-size: var(--text-heading-small, 1.25rem);
			}

			.feedback-delete-excerpt {
				color: var(--color-text-soft);
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
				overflow-wrap: anywhere;
			}

			.feedback-delete-dialog-actions {
				display: flex;
				flex-wrap: wrap;
				place-content: end;
				gap: var(--spacing-2x);
			}
		}

		@container feedback-admin (width > 500px) {
			.feedback-entry-meta {
				place-content: center space-between;
			}
		}
	</style>
	<div class="page-content-container feedback-admin">
		<h1 class="page-heading">Tilbakemeldinger</h1>
		<div>
			<a href="/admin/tilbakemeldinger/qr" class="btn btn--secondary">Skriv ut QR-kode</a>
		</div>
		<nav class="feedback-filter-tabs" aria-label="Filtrer tilbakemeldinger">
			<a href="/admin/tilbakemeldinger/" class="btn btn--secondary" if activeCategory == "" { aria-current="page" }>Alle</a>
			for _, category := range feedback.Categories {
				<a href={ feedbackFilterHref(category) } class="btn btn--secondary" if activeCategory == category { aria-current="page" }>{ category.Label() }</a>
			}
		</nav>
		@feedbackAdminContent(entries, activeCategory)
	</div>
}

// feedbackAdminContent is the count and the list. Deleting an entry re-renders
// it by its id.
templ feedbackAdminContent(entries []feedback.Entry, activeCategory feedback.Category) {
	<div id="feedback-admin-content">
		<p class="feedback-count">{ feedbackCountLabel(len(entries)) }</p>
		if len(entries) == 0 {
			<p class="feedback-empty">Ingen tilbakemeldinger å vise ennå.</p>
		} else {
			<ul class="feedback-list">
				for _, entry := range entries {
					<li class="surface-pane feedback-entry">
						<div class="feedback-entry-meta">
							<span class="feedback-entry-category">{ entry.Category.Label() }</span>
							<time class="feedback-entry-time">{ formatFeedbackTime(entry.CreatedAt) }</time>
						</div>
						if len(entry.Topics) > 0 {
							<ul class="feedback-entry-topics">
								for _, topic := range entry.Topics {
									<li class="feedback-entry-topic">{ topic.Label() }</li>
								}
							</ul>
						}
						<p class="feedback-entry-text feedback-entry-message">{ entry.Message }</p>
						<div class="feedback-entry-actions">
							@feedbackDeleteControl(entry, activeCategory)
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

// feedbackDeleteControl is the trash button and the dialog asking the admin to
// confirm before the entry is deleted.
templ feedbackDeleteControl(entry feedback.Entry, activeCategory feedback.Category) {
	{{ dialogID := feedbackDeleteDialogID(entry.ID) }}
	<button
		type="button"
		class="btn btn--secondary feedback-danger feedback-delete-button"
		commandfor={ dialogID }
		command="show-modal"
	>
		@icons.Icon(icons.Trash, icons.Size20)
		Slett
	</button>
	<dialog id={ dialogID } class="feedback-delete-dialog" closedby="any" aria-labelledby={ dialogID + "-title" }>
		<h2 id={ dialogID + "-title" }>Er du sikker?</h2>
		<p>Tilbakemeldingen slettes for godt og kan ikke hentes tilbake.</p>
		<p class="feedback-delete-excerpt">{ entry.Message }</p>
		<div class="feedback-delete-dialog-actions">
			<button type="button" class="btn btn--secondary" commandfor={ dialogID } command="close">
				@icons.Icon(icons.CloseCircle, icons.Size20)
				Avbryt
			</button>
			<button
				type="button"
				class="btn btn--secondary feedback-danger feedback-delete-confirm"
				data-on:click={ feedbackDeleteAction(entry.ID, activeCategory) }
			>
				@icons.Icon(icons.CheckCircle, icons.Size20)
				Ja, slett
			</button>
		</div>
	</dialog>
}
