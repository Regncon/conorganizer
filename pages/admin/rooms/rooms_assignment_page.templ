package rooms

import (
	"database/sql"
	"fmt"
	"github.com/Regncon/conorganizer/components/errorfeedback"
	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/service/eventimage"
	"github.com/Regncon/conorganizer/service/live"
	roomService "github.com/Regncon/conorganizer/service/rooms"
	"log/slog"
	"sort"
	"strings"
)

type FloorGroupPulje struct {
	Floor int
	Rooms []models.RoomByPulje
}

func getRoomsPuljeByFloor(db *sql.DB, logger *slog.Logger, pulje models.Pulje) []FloorGroupPulje {
	allRooms, err := roomService.GetAllRoomStatusesByPulje(db, pulje)
	if err != nil {
		logger.Error(fmt.Errorf("failed to get rooms for pulje %s: %w", pulje, err).Error())
	}

	allRoomsInPulje := allRooms[pulje]

	floorMap := make(map[int][]models.RoomByPulje)
	for _, room := range allRoomsInPulje {
		floorMap[room.Floor] = append(floorMap[room.Floor], room)
	}

	var result []FloorGroupPulje
	for floor, rooms := range floorMap {
		sort.Slice(rooms, func(i, j int) bool {
			return rooms[i].RoomNumber < rooms[j].RoomNumber
		})
		result = append(result, FloorGroupPulje{
			Floor: floor,
			Rooms: rooms,
		})
	}

	sort.Slice(result, func(i, j int) bool {
		return result[i].Floor > result[j].Floor
	})

	return result
}

func getApprovedEventsForPulje(db *sql.DB, logger *slog.Logger, pulje models.Pulje) []models.RoomEventPuljeSummaryJson {
	query := `
        SELECT
            e.title,
            e.max_players,
            e.id,
            COALESCE(e.notes, ''),
            COALESCE(rep.pulje_id, ''),
            rep.room_id
        FROM events e
        LEFT JOIN relation_event_puljer rep
            ON rep.event_id = e.id
            AND rep.pulje_id = ?
            AND rep.is_in_pulje = 1
        WHERE e.status IN (?, ?)
        ORDER BY e.title ASC;
    `

	rows, err := db.Query(query, pulje, models.EventStatusApproved, models.EventStatusAnnounced)
	if err != nil {
		logger.Error(fmt.Errorf("failed to get approved events: %w", err).Error())
		return nil
	}
	defer rows.Close()

	var events []models.RoomEventPuljeSummaryJson
	for rows.Next() {
		var event models.RoomEventPuljeSummaryJson

		err := rows.Scan(
			&event.Title,
			&event.MaxPlayers,
			&event.EventID,
			&event.Notes,
			&event.EventPuljeID,
			&event.RoomID,
		)
		if err != nil {
			logger.Error(fmt.Errorf("failed to scan event: %w", err).Error())
			continue
		}

		events = append(events, event)
	}

	if err := rows.Err(); err != nil {
		logger.Error(fmt.Errorf("error iterating rows: %w", err).Error())
	}

	return events
}

func calculatePopulation(rooms []models.RoomEventPuljeSummary) int {
	if len(rooms) > 0 {
		var count int
		for _, room := range rooms {
			count = count + room.MaxPlayers + 1
		}

		return count
	}

	return 0
}

templ assignEventModal(events []models.RoomEventPuljeSummaryJson, pulje models.Pulje, eventImageDir *string) {
	<dialog
		id="assignment-dialog"
		closedBy="any"
		aria-labelledby="assignment-dialog-title"
	>
		<h2 id="assignment-dialog-title">Legg til arrangement i rom <span data-text="$_roomNumber"></span></h2>
		<p>Velg et godkjent arrangement. Arrangementer fra andre puljer blir lagt til og publisert i denne puljen.</p>
		@errorfeedback.RenderMessage("room-picker")
		<div
			class="room-event-container"
		>
			if len(events) == 0 {
				<p>Ingen godkjente arrangementer.</p>
			}
			for _, event := range events {
				{{ imageBannerUrl := eventimage.GetEventImageUrl(event.EventID, "banner", eventImageDir) }}
				<div class="room-event-option" data-event-id={ event.EventID }>
					<div class="room-event-option-main">
						<img
							src={ imageBannerUrl }
							alt=""
							loading="lazy"
						/>
						<span>
							<strong>{ event.Title }</strong>
							<small>
								if event.EventPuljeID != string(pulje) {
									Ikke i denne puljen
								} else if !event.RoomID.Valid {
									Mangler rom
								} else {
									Har rom – flyttes ved valg
								}
								· { event.MaxPlayers } spillere
							</small>
						</span>
					</div>
					<button
						type="button"
						class="room-event-option-add"
						aria-label={ "Legg til " + event.Title + " i rommet" }
						title="Legg til i rommet"
						data-indicator="_roomSaving"
						data-attr:disabled={ fmt.Sprintf("$_roomSaving || $room === %d", event.RoomID.Int64) }
						{ errorfeedback.Attrs("room-picker", "Klarte ikke å tildele rommet. Prøv igjen.")... }
						data-on:click={ fmt.Sprintf(
                                "@post('/admin/rooms/api/assignment/%s/%s/' + $room)",
                                string(pulje),
                                event.EventID,
                            ) }
					>+</button>
					@eventNotesAccordion(event.Notes)
				</div>
			}
		</div>
		<button type="button" aria-label="Lukk" class="modal-close-button icon-size-24" data-on:click="document.getElementById('assignment-dialog').close()">
			@icons.Icon(icons.Close, icons.Size24)
		</button>
	</dialog>
}

templ eventNotesAccordion(notes string) {
	if strings.TrimSpace(notes) != "" {
		<details class="event-notes" data-preserve-attr="open" draggable="false">
			<summary>Notater</summary>
			<p>{ notes }</p>
		</details>
	}
}

templ roomEventCard(event models.RoomEventPuljeSummary, pulje models.Pulje, eventImageDir *string) {
	{{ imageBannerUrl := eventimage.GetEventImageUrl(event.EventID, "banner", eventImageDir) }}
	<div
		class="room-event"
		data-event-id={ event.EventID }
		draggable="true"
		data-on:dragstart={ fmt.Sprintf("$draggedEventId = '%s'", event.EventID) }
		data-on:dragend="$draggedEventId = ''; $dragOverRoom = 0"
		data-class:is-dragging={ fmt.Sprintf("$draggedEventId === '%s'", event.EventID) }
	>
		<a href={ "/admin/approval/edit/" + event.EventID } draggable="false" title={ event.Title }>
			<img src={ imageBannerUrl } alt="" loading="lazy" draggable="false"/>
			<span>{ event.Title }</span>
		</a>
		if event.RoomID != 0 {
			<button
				type="button"
				class="room-event-remove"
				aria-label={ "Fjern " + event.Title + " fra rommet" }
				title="Fjern fra rommet"
				data-indicator="_roomSaving"
				data-attr:disabled="$_roomSaving"
				data-on:click={ fmt.Sprintf("@delete('/admin/rooms/api/assignment/%s/%s/%d')", pulje, event.EventID, event.RoomID) }
				{ errorfeedback.Attrs("room-assignment", "Klarte ikke å fjerne romtildelingen. Prøv igjen.")... }
			>×</button>
		}
		@eventNotesAccordion(event.Notes)
	</div>
}

templ roomPuljeContainer(room models.RoomByPulje, pulje models.Pulje, eventImageDir *string) {
	{{ _, hasRoomMap := roomService.MapPathForRoom(room.RoomNumber)
	_, hasFloorMap := roomService.MapPathForFloor(room.Floor)
	mapped := hasRoomMap && hasFloorMap }}
	<div
		class={ "room", templ.KV("room--map", mapped) }
		if mapped {
			slot={ fmt.Sprintf("room-%d", room.ID) }
		}
		data-room-number={ room.RoomNumber }
		aria-label={ fmt.Sprintf("Rom %s", room.RoomNumber) }
		data-on:dragover__prevent={ fmt.Sprintf("$dragOverRoom = %d", room.ID) }
		data-on:dragleave="$dragOverRoom = 0"
		data-on:drop__prevent={ fmt.Sprintf("$dragOverRoom = 0; !$_roomSaving && $draggedEventId && @post('/admin/rooms/api/assignment/%s/' + $draggedEventId + '/%d')", string(pulje), room.ID) }
		data-class:is-drag-over={ fmt.Sprintf("$dragOverRoom === %d", room.ID) }
		data-indicator="_roomSaving"
		{ errorfeedback.Attrs("room-assignment", "Klarte ikke å tildele rommet. Prøv igjen.")... }
	>
		<header class="room-heading">
			if !mapped {
				<h3 title={ room.Name }>{ room.RoomNumber }</h3>
			}
			<span class="room-event-count" aria-label={ fmt.Sprintf("%d tildelte arrangementer", len(room.AssignedEventsID)) }>{ len(room.AssignedEventsID) }</span>
			<button
				type="button"
				class="room-add-event"
				aria-label={ "Legg til arrangement i rom " + room.RoomNumber }
				title="Legg til arrangement"
				data-attr:disabled="$_roomSaving"
				data-on:click={ fmt.Sprintf("$room = %d; $_roomNumber = %q; document.getElementById('assignment-dialog').showModal()", room.ID, room.RoomNumber) }
			>+</button>
		</header>
		if !mapped {
			<p>{ room.Name }</p>
			<p>Spillere og GMs: &#126;{ calculatePopulation(room.AssignedEventsID) }</p>
		}
		<div class="room-event-container">
			if len(room.AssignedEventsID) > 0 {
				for _, event := range room.AssignedEventsID {
					@roomEventCard(event, pulje, eventImageDir)
				}
			} else {
				<p class="room-empty">Ingen tildelte spill</p>
			}
		</div>
		if !mapped && room.Notes != "" {
			<p style="border-bottom: 1px solid var(--bg-item-border);">Notater på rom</p>
			<p style="font-style: italic; font-size: var(--text-body-small);">{ room.Notes }</p>
		}
	</div>
}

templ floorPuljeContainer(floor int, rooms []models.RoomByPulje, pulje models.Pulje, eventImageDir *string) {
	for index, room := range rooms {
		if index == 0 {
			<h2>{ floor }. Etg</h2>
		}
		@roomPuljeContainer(room, pulje, eventImageDir)
	}
}

templ RoomsAssignmentPage(db *sql.DB, logger *slog.Logger, pulje models.Pulje, eventImageDir *string) {
	<script type="module" src="/static/web_components/room_map.js"></script>
	<style>
        #room-assignment { container-type: inline-size; min-inline-size: 0; }
        .assignment-map-panel { display: grid; gap: var(--spacing-2x); min-inline-size: 0; }
        .event-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
            gap: var(--spacing-1x);
        }
        .rooms-container {
            display: grid;
            grid-template-columns: 1fr;
            gap: var(--spacing-2x);
            h2 { grid-column: 1/-1; }
        }
        @container (width > 700px) {
            .rooms-container { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .room {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-inline-size: 0;
            padding: 12px;
            border: 1px solid var(--bg-item-border);
            border-radius: 6px;
            background: var(--bg-item);
            &.is-drag-over { outline: 3px solid var(--color-primary); }
        }
        .room-heading {
            display: flex;
            align-items: center;
            gap: 6px;
            h3 { margin: 0; font-size: 16px; }
        }
        .room-event-count {
            display: inline-grid;
            place-items: center;
            min-inline-size: 24px;
            block-size: 24px;
            border-radius: 12px;
            background: var(--bg-item-hover);
            font-size: 12px;
        }
        .room-add-event, .room-event-remove {
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            inline-size: 28px;
            block-size: 28px;
            padding: 0;
            border: 1px solid var(--bg-item-border);
            border-radius: 4px;
            background: var(--bg-item);
            color: var(--color-primary-text);
            font-size: 20px;
            cursor: pointer;
            &:hover { background: var(--bg-item-hover); }
            &:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
            &:disabled { opacity: 0.5; cursor: wait; }
        }
        .room-add-event { margin-inline-start: auto; }
        .room-event-container {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-block-size: 0;
            margin: 0;
            padding: 0;
        }
        .room-empty { font-size: 12px; opacity: 0.7; }
        .room--map {
            position: relative;
            padding: 8px;
            gap: 6px;
            border-color: color-mix(in srgb, var(--bg-item-border) 75%, transparent);
            border-radius: 8px;
            background: color-mix(in srgb, var(--bg-item) 28%, transparent);
            box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);

            .room-heading {
                position: absolute;
                inset: 6px 6px auto;
                justify-content: flex-end;
                z-index: 2;
                pointer-events: none;
            }
            .room-heading .room-event-count,
            .room-heading .room-add-event { pointer-events: auto; }
            .room-event-container {
                padding-block-start: 30px;
                overflow-y: auto;
                overscroll-behavior: contain;
            }
            .room-empty { display: none; }
        }
        .room-event {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            flex: 0 0 auto;
            gap: 4px;
            min-inline-size: 0;
            padding: 4px;
            border: 1px solid var(--bg-item-border);
            border-radius: 4px;
            background: var(--bg-main, var(--bg-item));
            cursor: grab;
            a {
                display: flex;
                align-items: center;
                flex: 1;
                gap: 6px;
                min-inline-size: 0;
                color: var(--color-primary-text);
                text-decoration: none;
                font-size: 12px;
                line-height: 1.25;
                overflow-wrap: anywhere;
            }
            img { inline-size: 36px; block-size: 36px; object-fit: cover; border-radius: 3px; flex: 0 0 auto; }
            &:hover { border-color: var(--color-primary); }
            &.is-dragging { opacity: 0.5; }
        }
        .event-notes {
            min-inline-size: 0;
            font-size: 11px;
            line-height: 1.35;
            summary {
                inline-size: fit-content;
                color: var(--color-primary-text);
                cursor: pointer;
            }
            p {
                max-block-size: 8rem;
                margin: 4px 0 0;
                overflow-y: auto;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }
        }
        .room-event .event-notes {
            flex: 0 0 100%;
            border-block-start: 1px solid var(--bg-item-border);
            padding-block-start: 4px;
        }
        #assignment-dialog {
            inline-size: min(560px, calc(100% - 32px));
            max-block-size: calc(100dvh - 32px);
            padding: 24px;
            overflow-y: auto;
            h2 { padding-inline-end: 24px; }
            .room-event-container { margin-block-start: 16px; }
        }
        .room-event-option {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            padding: 8px;
            text-align: start;
            border: 1px solid var(--bg-item-border);
            border-radius: 6px;
            background: var(--bg-item);
            color: var(--color-primary-text);
            .room-event-option-main {
                display: flex;
                align-items: center;
                flex: 1;
                gap: 12px;
                min-inline-size: 0;
            }
            img { inline-size: 64px; block-size: 48px; object-fit: cover; border-radius: 4px; }
            span { display: grid; gap: 4px; }
            small { opacity: 0.7; }
            &:hover { border-color: var(--color-primary); }
        }
        .room-event-option-add {
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            inline-size: 32px;
            block-size: 32px;
            padding: 0;
            border: 1px solid var(--bg-item-border);
            border-radius: 4px;
            background: var(--bg-item-hover);
            color: var(--color-primary-text);
            font-size: 20px;
            line-height: 1;
            cursor: pointer;
            &:hover { background: var(--bg-main, var(--bg-item)); }
            &:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
            &:disabled { opacity: 0.5; cursor: wait; }
        }
        .room-event-option .event-notes {
            flex: 0 0 100%;
            border-block-start: 1px solid var(--bg-item-border);
            padding-block-start: 4px;
            padding-inline: 8px;
        }
	</style>
	{{ allEvents := getApprovedEventsForPulje(db, logger, pulje) }}
	<div
		id="room-assignment-page"
		data-signals:dragged-event-id="''"
		data-signals:drag-over-room="0"
		data-signals__ifmissing="{room: 0, _roomNumber: '', _roomSaving: false, _roomAssignmentStatus: ''}"
		data-on:room-saved__window="$draggedEventId = ''; $_roomSaving = false; $_roomAssignmentStatus = 'Romtildelingen er lagret.'"
	>
		@roomsAssignmentLiveContent(db, logger, pulje, eventImageDir, allEvents)
		@assignEventModal(allEvents, pulje, eventImageDir)
	</div>
}

templ RoomsAssignmentPageContent(db *sql.DB, logger *slog.Logger, pulje models.Pulje, eventImageDir *string) {
	{{ allEvents := getApprovedEventsForPulje(db, logger, pulje) }}
	@roomsAssignmentLiveContent(db, logger, pulje, eventImageDir, allEvents)
}

templ roomsAssignmentLiveContent(db *sql.DB, logger *slog.Logger, pulje models.Pulje, eventImageDir *string, allEvents []models.RoomEventPuljeSummaryJson) {
	<section
		id="room-assignment"
		class="rooms-section"
		data-init={ live.DatastarInit(fmt.Sprintf("/admin/rooms/api/assignment/%s", pulje)) }
	>
		@errorfeedback.RenderMessage("room-assignment")
		<p role="status" data-text="$_roomAssignmentStatus"></p>
		{{
			var events []models.RoomEventPuljeSummaryJson
			for _, event := range allEvents {
				if event.EventPuljeID == string(pulje) && !event.RoomID.Valid {
					events = append(events, event)
				}
			}
		}}
		if len(events) > 0 {
			<h2>{ len(events) } Eventer i pulje uten tildelt rom</h2>
			<div class="event-list">
				for _, event := range events {
					@roomEventCard(models.RoomEventPuljeSummary{EventID: event.EventID, Title: event.Title, Notes: event.Notes, MaxPlayers: event.MaxPlayers}, pulje, eventImageDir)
				}
			</div>
		}
		<h2>Romfordeling for { pulje.Label() }</h2>
		{{ floors := getRoomsPuljeByFloor(db, logger, pulje) }}
		for _, floorGroup := range floors {
			if mapPath, hasMap := roomService.MapPathForFloor(floorGroup.Floor); hasMap {
				<div class="assignment-map-panel">
					<h2>Romkart – Terminus, { floorGroup.Floor }. etasje</h2>
					<p>Bruk + for å legge til et arrangement, eller dra et kort til rommet. Bruk × for å fjerne romtildelingen. På smale skjermer kan kartet rulles sidelengs.</p>
					<room-map id={ fmt.Sprintf("assignment-room-map-%d", floorGroup.Floor) } map-path={ mapPath } rooms={ templ.JSONString(floorGroup.Rooms) }>
						for _, room := range floorGroup.Rooms {
							@roomPuljeContainer(room, pulje, eventImageDir)
						}
					</room-map>
				</div>
			}
		}
		if len(floors) > 0 {
			<div class="rooms-container">
				for _, floorGroup := range floors {
					if _, hasMap := roomService.MapPathForFloor(floorGroup.Floor); !hasMap {
						@floorPuljeContainer(floorGroup.Floor, floorGroup.Rooms, pulje, eventImageDir)
					}
				}
			</div>
		} else {
			<p style="text-align: center;">Ingen rom funnet, vær den første til å <a href="/admin/rooms/">legge inn</a> et rom nå!</p>
		}
	</section>
}
