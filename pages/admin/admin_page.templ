package admin

import (
	"database/sql"

	"github.com/Regncon/conorganizer/components"
	"github.com/Regncon/conorganizer/components/icons"
)

templ adminPage(db *sql.DB) {
	<div id="admin-container">
		@components.Breadcrumbs([]components.BreadcrumbPath{
			{Name: "Hjem", Url: "/"},
			{Name: "Admin", Url: ""},
		})
		@adminCardStyles()
		<style>
			.admin-page-layout {
				display: flex;
				flex-direction: column;
				gap: var(--responsive-page-section-spacing);
			}
		</style>
		<div class="page-content-container">
			<h1 class="page-heading">Adminverktøy</h1>
			<div class="admin-page-layout">
				<section class="admin-section" data-admin-section="puljefordeling" aria-labelledby="puljefordeling-heading">
					<h2 id="puljefordeling-heading">Puljefordeling</h2>
					<div class="admin-section-cards">
						@adminToolCard(
							"fordeling",
							"Fordeling av deltakere",
							"/admin/puljefordeling/",
							"/static/admin/algorithm.svg",
							"Fordel festivaldeltakerne til arrangementene som skjer i løpet av festivalen.",
						)
						@adminToolCard(
							"puljeoppsett",
							"Sett arrangementer i puljer",
							"/admin/puljeoppsett/",
							"/static/admin/blueprint.svg",
							"Organiser spill inn i puljene som finner sted under festivalen.",
						)
					</div>
				</section>
				<section class="admin-section" data-admin-section="programoppsett" aria-labelledby="programoppsett-heading">
					<h2 id="programoppsett-heading">Programoppsett</h2>
					<div class="admin-section-cards">
						<div class="admin-tool-card admin-tool-card--wide" data-admin-tool="publiser">
							@adminToolGraphic("/static/admin/launch.svg")
							<div class="admin-tool-card-body">
								<strong class="admin-tool-title">Publiser program</strong>
								<p class="admin-tool-description">Publiser programmet for festivalen, og åpne for ønsker og påmeldinger.</p>
								<a class="admin-tool-print-link" href="/print">
									Hent utskriftsvennlig versjon av programmet
									<span aria-hidden="true">
										@icons.Icon(icons.ExternalLink, icons.Size16)
									</span>
								</a>
							</div>
							@publiserProgram(db)
						</div>
						@adminToolCard(
							"rom",
							"Administrer rom",
							"/admin/rooms/",
							"/static/admin/blueprint.svg",
							"Legg til, rediger og få en oversikt over alle tilgjengelige rom under festivalen.",
						)
						@adminToolCard(
							"godkjenn",
							"Godkjenn arrangementer",
							"/admin/approval/",
							"/static/admin/checklist.svg",
							"Se alle arrangementer som er sendt inn av deltakerne og som venter på godkjenning.",
						)
					</div>
				</section>
				<section class="admin-section" data-admin-section="ovrige" aria-labelledby="ovrige-heading">
					<h2 id="ovrige-heading">Øvrige verktøy</h2>
					<div class="admin-section-cards">
						@adminToolCard(
							"billettholdere",
							"Administrer billettholdere",
							"/admin/billettholder/",
							"/static/admin/access-badge.svg",
							"Se en oversikt over alle billettholdere som kommer til festivalen.",
						)
						@adminToolCard(
							"tilbakemeldinger",
							"Tilbakemeldinger",
							"/admin/tilbakemeldinger/",
							"/static/admin/inbox.svg",
							"Les tilbakemeldinger fra deltakerne om nettsiden og festivalen.",
						)
					</div>
				</section>
			</div>
		</div>
	</div>
}
