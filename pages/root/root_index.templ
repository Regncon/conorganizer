package root

import (
	"database/sql"
	"fmt"
	"github.com/Regncon/conorganizer/layouts"
	"github.com/Regncon/conorganizer/service/live"
	"github.com/Regncon/conorganizer/service/userctx"
	"github.com/go-chi/chi/v5"
	"log/slog"
	"net/http"
	"github.com/Regncon/conorganizer/service/requestctx"
)

func rootLayoutRoute(router chi.Router, db *sql.DB, logger *slog.Logger, eventImageDir *string) {
	router.Get("/", func(w http.ResponseWriter, r *http.Request) {
		var ctx = r.Context()
		userInfo := userctx.GetUserRequestInfo(r.Context())
		if err := layouts.Base(
			"Regncon program",
			userInfo,
            db,
            logger,
			rootIndex(userInfo, db, userInfo.IsAdmin, eventImageDir, logger),
		).Render(ctx, w); err != nil {
			logger.Error(fmt.Errorf("failed to render root page: %w", err).Error(), "user_id", userInfo.Id)
		}
	})
}

templ rootIndex(userInfo requestctx.UserRequestInfo, db *sql.DB, isAdmin bool, eventImageDir *string, logger *slog.Logger) {
	<div id="root-page-wrapper" data-init={ live.DatastarInit("/root/api") }>
		@rootPageContent(userInfo, db, isAdmin, eventImageDir, logger)
	</div>
}
