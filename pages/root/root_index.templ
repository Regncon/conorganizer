package root

import (
	"database/sql"
	"fmt"
	"github.com/Regncon/conorganizer/layouts"
	"github.com/Regncon/conorganizer/service/live"
	"github.com/Regncon/conorganizer/service/userctx"
	"github.com/go-chi/chi/v5"
	"log/slog"
	"net/http"
)

func rootLayoutRoute(router chi.Router, db *sql.DB, logger *slog.Logger, eventImageDir *string) {
	router.Get("/", func(w http.ResponseWriter, r *http.Request) {
		var ctx = r.Context()
		userInfo := userctx.GetUserRequestInfo(r.Context())
		interests := loadBillettholderInterestsForPage(ctx, userInfo, db, logger)
		if err := layouts.Base(
			"Regncon program",
			userInfo,
            db,
            logger,
			rootIndex(db, eventImageDir, r.URL.Query().Get(programDateQueryParam), interests),
		).Render(ctx, w); err != nil {
			logger.Error(fmt.Errorf("failed to render root page: %w", err).Error(), "user_id", userInfo.Id)
		}
	})
}

templ rootIndex(db *sql.DB, eventImageDir *string, requestedDate string, interests billettholderInterestsByEvent) {
	<div id="root-page-wrapper" data-init={ live.DatastarInit(rootAPIURL(requestedDate)) }>
		@rootPageContentForDate(db, eventImageDir, requestedDate, interests)
	</div>
}
