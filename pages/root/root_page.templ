package root

import (
	"database/sql"
	"time"

	"github.com/Regncon/conorganizer/components"
	"github.com/Regncon/conorganizer/service/program"
)

templ rootPage(db *sql.DB, eventImageDir *string, requestedDate string) {
	<div id="root-page-wrapper">
		@rootPageContentForDate(db, eventImageDir, requestedDate, time.Now())
	</div>
}

templ rootPageContent(db *sql.DB, eventImageDir *string) {
	@rootPageContentForDate(db, eventImageDir, "", time.Now())
}

templ rootPageContentForDate(db *sql.DB, eventImageDir *string, requestedDate string, now time.Time) {
	{{
		programPublished, err := program.IsPublished(db)
		var programDays []program.Day
		var programDaysErr error
		if err == nil && programPublished {
			programDays, programDaysErr = program.GetDays(db)
		}
		selectedDayIndex := program.SelectDayIndex(programDays, requestedDate, now)
	}}
	if selectedDayIndex >= 0 {
		@puljeAlerts(programDays[selectedDayIndex].Blocks, now)
	}
	if err != nil {
		<div class="page-content-container">
			<p class="root-page-error">{ rootPageLoadErrorMessage }</p>
		</div>
	} else {
		if programPublished {
			if programDaysErr != nil {
				@components.CallToAction()
				<div class="page-content-container">
					<p class="root-page-error">{ rootEventsLoadErrorMessage }</p>
				</div>
			} else if len(programDays) > 0 {
				@programDaySelector(programDays, selectedDayIndex)
				@components.CallToAction()
				{{ selectedDay := programDays[selectedDayIndex] }}
				@eventList(db, eventImageDir, true, &selectedDay)
			} else {
				@components.CallToAction()
				@eventList(db, eventImageDir, true, nil)
			}
		} else {
			@components.CallToAction()
			@eventList(db, eventImageDir, false, nil)
		}
	}
}
