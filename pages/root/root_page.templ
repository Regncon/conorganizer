package root

import (
	"database/sql"
	"errors"
	"fmt"

	"github.com/Regncon/conorganizer/components"
)

func getProgramPublished(db *sql.DB) (bool, error) {
	const query = `
		SELECT is_published
		FROM program_publishing_state
		WHERE id = 1
	`

	var isPublished int
	if err := db.QueryRow(query).Scan(&isPublished); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return false, nil
		}
		return false, fmt.Errorf("query program publishing state: %w", err)
	}

	return isPublished == 1, nil
}

templ rootPage(db *sql.DB, isAdmin bool, eventImageDir *string) {
	<div id="root-page-wrapper">
		@rootPageContent(db, isAdmin, eventImageDir)
	</div>
}

templ rootPageContent(db *sql.DB, isAdmin bool, eventImageDir *string) {
	{{
		programPublished, err := getProgramPublished(db)
	}}
	<style>
		#root-page-wrapper {
			--program-scrollnav-mobile-top-offset: 51px;
			--program-scrollnav-sticky-top: var(--program-scrollnav-mobile-top-offset);
			--program-scrollnav-margin-block-start: 0px;
			--program-scrollnav-block-size: calc(var(--btn-height) + (var(--spacing-2x) * 2));
			--program-scroll-target-gap: 0px;
			--program-scroll-target-offset: calc(
				var(--program-scrollnav-sticky-top) +
				var(--program-scrollnav-margin-block-start) +
				var(--program-scrollnav-block-size) +
				var(--program-scroll-target-gap)
			);
			--program-pulje-section-spacing: var(--spacing-8x);
		}

		@container main (width > 600px) {
			#root-page-wrapper {
				--program-scrollnav-sticky-top: var(--nav-height);
				--program-scrollnav-margin-block-start: var(--spacing-3x);
			}
		}
	</style>
	@components.Breadcrumbs([]components.BreadcrumbPath{
		{Name: "Hjem", Url: ""},
	})
	if err != nil {
		<div class="page-content-container">
			<p class="root-page-error">{ rootPageLoadErrorMessage }</p>
		</div>
	} else {
		if programPublished {
			@components.ProgramScrollnav(db)
		}
		@components.CallToAction()
		@eventList(db, isAdmin, eventImageDir, programPublished)
	}
}
