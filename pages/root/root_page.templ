package root

import (
	"database/sql"
	"errors"
	"fmt"

	"github.com/Regncon/conorganizer/components"
    "github.com/Regncon/conorganizer/components/header"
	"github.com/Regncon/conorganizer/service/requestctx"
	"log/slog"
)

func getProgramPublished(db *sql.DB) (bool, error) {
	const query = `
		SELECT is_published
		FROM program_publishing_state
		WHERE id = 1
	`

	var isPublished int
	if err := db.QueryRow(query).Scan(&isPublished); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return false, nil
		}
		return false, fmt.Errorf("query program publishing state: %w", err)
	}

	return isPublished == 1, nil
}

templ rootPage(userInfo requestctx.UserRequestInfo, db *sql.DB, isAdmin bool, eventImageDir *string, logger *slog.Logger) {
	<div id="root-page-wrapper">
		@rootPageContent(userInfo, db, isAdmin, eventImageDir, logger)
	</div>
}

templ rootPageContent(userInfo requestctx.UserRequestInfo, db *sql.DB, isAdmin bool, eventImageDir *string, logger *slog.Logger) {
	{{
		programPublished, err := getProgramPublished(db)
	}}

    <style>

        .breadcrumb-and-hamburger {
            display: grid;
            grid-template-columns: 1fr 42px;
            align-items: center;
            margin-bottom: var(--spacing-4x);
        }

    </style>
    <div class="breadcrumb-and-hamburger">
	@components.Breadcrumbs(userInfo, []components.BreadcrumbPath{
		{Name: "Hjem", Url: ""},
	}, db, logger)
    /* TODO: hamburger menu hide when on pc not implemented */
    @header.HamburgerPhone(userInfo, db, logger)
    </div>
	if err != nil {
		<div class="page-content-container">
			<p>Error fetching program publishing state: { err.Error() }</p>
		</div>
	} else {
		if programPublished {
			@components.ProgramScrollnav(db)
		}
		@components.CallToAction()
		@eventList(db, isAdmin, eventImageDir, programPublished)
	}
}
