package root

import (
	"database/sql"
	"time"
	"github.com/Regncon/conorganizer/components"
	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/service/program"
)

templ flatEventList(events []models.EventCardModel, eventImageDir *string) {
	<div class="page-wide-eventcard-grid">
		for _, event := range events {
			@components.EventCard(event, eventImageDir, "", "", nil)
		}
	</div>
}

templ eventPuljeBlock(block program.PuljeBlock, db *sql.DB, eventImageDir *string, date string) {
	{{ events := block.RaffleEvents() }}
	if len(events) > 0 {
		{{ interests := loadPuljeInterests(ctx, db, block.Pulje.ID) }}
		<section class="container-inner-padding raffle-pulje-section">
			<h2 class="pulje-heading" id={ puljeAnchorID(block.Pulje.ID) }>
				{ block.Pulje.Name }
				<span class="pulje-heading-time">({ block.Pulje.TimeRange() })</span>
			</h2>
			<div class="raffle-eventcard-grid">
				for _, event := range events {
					@components.EventCard(event, eventImageDir, string(block.Pulje.ID), date, interests[event.Id])
				}
			</div>
		</section>
	}
}

templ programDaySchedule(day program.Day) {
	switch day.Date.Weekday() {
		case time.Friday:
			<h1 class="program-day-heading container-inner-padding">Fredag (17:00 - 22:00)</h1>
			@components.TimeScheduleFriday()
		case time.Saturday:
			<h1 class="program-day-heading container-inner-padding">Lørdag (09:00 - 22:00)</h1>
			@components.TimeScheduleLoordag()
		case time.Sunday:
			<h1 class="program-day-heading container-inner-padding">Søndag (09:00 - 16:00)</h1>
			@components.TimeScheduleSoondag()
	}
}

templ eventList(db *sql.DB, eventImageDir *string, programPublished bool, publishedDay *program.Day) {
	<style>
		.event-pulje-overview {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-8x);
		}

		@container main (width > 1200px) {
			.event-pulje-overview {
			    margin-top: var(--spacing-2x);
			}
		}

		.pulje-heading {
			--program-day-selector-height: calc(var(--btn-height) + 2 * var(--spacing-2x));

			color: var(--color-text-strong);
			margin: 0 0 var(--spacing-3x);
			scroll-margin-block-start: calc(var(--program-day-selector-height) + var(--spacing-4x));
			text-transform: capitalize;
		}
		.pulje-heading-time {
			font-family: var(--font-sans-serif);
			font-size: var(--text-body);
			font-weight: normal;
			color: var(--color-primary);
		}

		@container main (width > 600px) {
			.pulje-heading {
				margin: 0 0 var(--spacing-5x);
				scroll-margin-block-start: calc(var(--nav-height) + var(--program-day-selector-height) + var(--spacing-4x));
			}
		}
	</style>
	<div class="page-content-container event-pulje-overview">
		if programPublished {
			if publishedDay != nil {
				@programDaySchedule(*publishedDay)
				if len(publishedDay.ProgramEvents) > 0 {
					<section class="container-inner-padding program-section">
						<h2 class="pulje-heading">Programoversikt</h2>
						<div class="program-event-grid">
							for _, row := range programEventRows(publishedDay.ProgramEvents) {
								<div class={ "program-event-row", templ.KV("reversed", row.Reversed) }>
									for _, programEvent := range row.Events {
										@components.ProgramEventCard(programEvent.Event, eventImageDir, string(programEvent.PuljeID), publishedDay.QueryValue())
									}
								</div>
							}
						</div>
					</section>
				}
				for _, block := range publishedDay.Blocks {
					@eventPuljeBlock(block, db, eventImageDir, publishedDay.QueryValue())
				}
			}
		} else {
			{{ events, err := program.GetAnnouncedEvents(db) }}
			if err != nil {
				<p class="root-page-error">{ rootEventsLoadErrorMessage }</p>
			} else {
				@flatEventList(events, eventImageDir)
			}
		}
	</div>
}

templ puljeAlerts(blocks []program.PuljeBlock, now time.Time) {
	{{ alerts := collectPuljeAlerts(blocks, now) }}
	<style>
		.pulje-alerts {
			display: grid;
			grid-template-columns: min(100%, var(--page-content-narrow-max-width));
			gap: var(--spacing-2x);
			place-content: center;
		}
		.pulje-alert {
			--pulje-alert-color: var(--color-warning);
			--pulje-alert-border-width: 2px;
			--pulje-alert-icon-size: 24px;
			--pulje-alert-tint-start: 26%;
			--pulje-alert-tint-end: 21%;

			display: flex;
			gap: var(--spacing-2x);
			place-items: start;
			margin: 0;
			padding: var(--spacing-3x);
			border-block: var(--pulje-alert-border-width) solid var(--pulje-alert-color);
			background: linear-gradient(
				to right,
				color-mix(in srgb, var(--pulje-alert-color) var(--pulje-alert-tint-start), var(--bg-surface)),
				color-mix(in srgb, var(--pulje-alert-color) var(--pulje-alert-tint-end), var(--bg-surface))
			);
			color: var(--color-text-strong);
			font-size: var(--text-body-small);
			font-weight: 700;

			.inline-icon {
				inline-size: var(--pulje-alert-icon-size);
				block-size: var(--pulje-alert-icon-size);
				margin-block-start: calc((1lh - var(--pulje-alert-icon-size)) / 2);
				color: var(--pulje-alert-color);
			}

			a {
				color: inherit;
				text-decoration: none;

				&:hover,
				&:focus-visible {
					text-decoration: underline;
				}
			}
		}
		.pulje-alert.is-completed {
			--pulje-alert-color: var(--color-success);
		}
		.pulje-alert.is-closing {
			--pulje-alert-icon-size: 20px;
		}

		@container main (width > 600px) {
			.pulje-alerts:has(.pulje-alert) {
				margin-block-start: var(--spacing-1x);
			}
			.pulje-alert {
				border: var(--pulje-alert-border-width) solid var(--pulje-alert-color);
				border-radius: var(--border-radius-2x);
			}
		}
	</style>
	<div class="pulje-alerts container-inner-padding" role="status">
		for _, alert := range alerts {
			<p class={ "pulje-alert", alert.Class }>
				@icons.Icon(alert.Icon, icons.Size24)
				<span>
					if alert.PuljeName != "" {
						<strong>{ alert.PuljeName }:</strong> { alert.Message }
					} else {
						{ alert.Message }
					}
					if alert.LinkHref != "" {
						<a href={ templ.URL(alert.LinkHref) }>Klikk her for å gå til puljen.</a>
					}
				</span>
			</p>
		}
	</div>
}
