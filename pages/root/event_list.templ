package root

import (
	"database/sql"
	"time"

	"github.com/Regncon/conorganizer/components"
	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/service/program"
)

templ flatEventList(events []models.EventCardModel, eventImageDir *string) {
	<div class="page-wide-eventcard-grid">
		for _, event := range events {
			@components.EventCard(event, eventImageDir, "", "")
		}
	</div>
}

templ eventPuljeBlock(block program.PuljeBlock, eventImageDir *string, date string) {
	{{ events := block.RaffleEvents() }}
	if len(events) > 0 {
		<section class="container-inner-padding raffle-pulje-section">
			<h2 class="pulje-heading">
				{ block.Pulje.Name }
				<span class="pulje-heading-time">({ block.Pulje.TimeRange() })</span>
			</h2>
			<div class="raffle-eventcard-grid">
				for _, event := range events {
					@components.EventCard(event, eventImageDir, string(block.Pulje.ID), date)
				}
			</div>
		</section>
	}
}

templ programDaySchedule(day program.Day) {
	switch day.Date.Weekday() {
		case time.Friday:
			<h1 class="program-day-heading">Fredag (17:00 - 22:00)</h1>
			@components.TimeScheduleFriday()
		case time.Saturday:
			<h1 class="program-day-heading">Lørdag (09:00 - 22:00)</h1>
			@components.TimeScheduleLoordag()
		case time.Sunday:
			<h1 class="program-day-heading">Søndag (09:00 - 16:00)</h1>
			@components.TimeScheduleSoondag()
	}
}

templ eventList(db *sql.DB, eventImageDir *string, programPublished bool, publishedDay *program.Day) {
	<style>
		.event-pulje-overview {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-8x);
		}

		@container main (width > 1200px) {
			.event-pulje-overview {
			    margin-top: var(--spacing-2x);
			}
		}

		.pulje-heading {
			color: var(--color-text-strong);
			margin: 0 0 var(--spacing-3x);
			text-transform: capitalize;
		}
		.pulje-heading-time {
			font-family: var(--font-sans-serif);
			font-size: var(--text-body);
			font-weight: normal;
			color: var(--color-primary);
		}

		@container main (width > 600px) {
			.pulje-heading {
				margin: 0 0 var(--spacing-5x);
			}
		}
	</style>
	<div class="page-content-container event-pulje-overview">
		if programPublished {
			if publishedDay != nil {
				@programDaySchedule(*publishedDay)
				if len(publishedDay.ProgramEvents) > 0 {
					<section class="container-inner-padding program-section">
						<h2 class="pulje-heading">Programoversikt</h2>
						<div class="program-event-grid">
							for _, row := range programEventRows(publishedDay.ProgramEvents) {
								<div class={ "program-event-row", templ.KV("reversed", row.Reversed) }>
									for _, programEvent := range row.Events {
										@components.ProgramEventCard(programEvent.Event, eventImageDir, string(programEvent.PuljeID), publishedDay.QueryValue())
									}
								</div>
							}
						</div>
					</section>
				}
				for _, block := range publishedDay.Blocks {
					@eventPuljeBlock(block, eventImageDir, publishedDay.QueryValue())
				}
			}
		} else {
			{{ events, err := program.GetAnnouncedEvents(db) }}
			if err != nil {
				<p class="root-page-error">{ rootEventsLoadErrorMessage }</p>
			} else {
				@flatEventList(events, eventImageDir)
			}
		}
	</div>
}
