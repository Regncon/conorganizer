package root

import (
	"database/sql"
	"fmt"

	"github.com/Regncon/conorganizer/components"
	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/service/puljer"
)

type PuljeBlock struct {
	Pulje  models.PuljeRow
	Events []models.EventCardModel
}

type EventsByPulje map[models.Pulje]*PuljeBlock

func GetAnnouncedEventsAlphabetically(db *sql.DB) ([]models.EventCardModel, error) {
	const q = `
		SELECT
			e.id,
			e.title,
			e.intro,
			e.status,
			e.system,
			e.host_name,
			e.event_type,
			e.age_group,
			e.event_runtime,
			e.beginner_friendly,
			e.can_be_run_in_english,
			e.is_in_puljefordeling
		FROM events e
		WHERE e.status = ?
		ORDER BY e.title COLLATE NOCASE ASC, e.id ASC
	`

	rows, err := db.Query(q, models.EventStatusAnnounced)
	if err != nil {
		return nil, fmt.Errorf("query announced events alphabetically: %w", err)
	}
	defer rows.Close()

	events := make([]models.EventCardModel, 0)
	for rows.Next() {
		var event models.EventCardModel
		if err := rows.Scan(
			&event.Id,
			&event.Title,
			&event.Intro,
			&event.Status,
			&event.System,
			&event.HostName,
			&event.EventType,
			&event.AgeGroup,
			&event.Runtime,
			&event.BeginnerFriendly,
			&event.CanBeRunInEnglish,
			&event.IsInPuljefordeling,
		); err != nil {
			return nil, fmt.Errorf("scan announced event row: %w", err)
		}
		events = append(events, event)
	}

	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("iterate announced event rows: %w", err)
	}

	return events, nil
}

func GetEventsByPulje(db *sql.DB) (EventsByPulje, error) {
	const q = `
		SELECT
			e.id,
			e.title,
			e.intro,
			e.status,
			e.system,
			e.host_name,
			e.event_type,
			e.age_group,
			e.event_runtime,
			e.beginner_friendly,
			e.can_be_run_in_english,
			e.is_in_puljefordeling,

			-- pulje
			e.pulje_id,
			e.pulje_name,
			e.pulje_start_at,
			e.pulje_end_at
		FROM v_events_by_pulje_active e
		ORDER BY e.pulje_start_at ASC, e.title COLLATE NOCASE ASC, e.id ASC
	`

	rows, err := db.Query(q)
	if err != nil {
		return nil, fmt.Errorf("querying events by pulje: %w", err)
	}
	defer rows.Close()

	out := make(EventsByPulje)

	for rows.Next() {
		var (
			ev                 models.EventCardModel
			puljeID, puljeName string
			startAt, endAt     models.DBDateTime
		)

		if err := rows.Scan(
			&ev.Id,
			&ev.Title,
			&ev.Intro,
			&ev.Status,
			&ev.System,
			&ev.HostName,
			&ev.EventType,
			&ev.AgeGroup,
			&ev.Runtime,
			&ev.BeginnerFriendly,
			&ev.CanBeRunInEnglish,
			&ev.IsInPuljefordeling,

			&puljeID,
			&puljeName,
			&startAt,
			&endAt,
		); err != nil {
			return nil, err
		}

		key := models.Pulje(puljeID)
		block, ok := out[key]
		if !ok {
			pulje, err := puljerService.BuildPulje(key, puljeName, "", startAt, endAt)
			if err != nil {
				return nil, err
			}

			block = &PuljeBlock{
				Pulje: pulje,
			}
			out[key] = block
		}

		block.Events = append(block.Events, ev)
	}

	return out, rows.Err()
}

templ flatEventList(events []models.EventCardModel, eventImageDir *string) {
	<div class="page-wide-eventcard-grid">
		for _, event := range events {
			@components.EventCard(event, eventImageDir, "", "")
		}
	</div>
}

templ eventPuljeBlock(block PuljeBlock, eventImageDir *string, date string) {
	{{ events := RaffleEvents(block) }}
	if len(events) > 0 {
		<section class="container-inner-padding raffle-pulje-section">
			<h2 class="pulje-heading">
				{ block.Pulje.Name }
				<span class="pulje-heading-time">({ block.Pulje.TimeRange() })</span>
			</h2>
			<div class="raffle-eventcard-grid">
				for _, event := range events {
					@components.EventCard(event, eventImageDir, string(block.Pulje.ID), date)
				}
			</div>
		</section>
	}
}

templ eventList(db *sql.DB, eventImageDir *string, programPublished bool, publishedDay *ProgramDay) {
	<style>
		.event-pulje-overview {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-8x);
		}

		@container main (width > 1200px) {
			.event-pulje-overview {
			    margin-top: var(--spacing-2x);
			}
		}

		.pulje-heading {
			color: var(--color-primary);
			margin: 0 0 var(--spacing-3x);
			text-transform: capitalize;
		}
		.pulje-heading-time {
			font-family: var(--font-sans-serif);
			font-size: var(--text-body);
			font-weight: normal;
			color: var(--color-text-soft);
		}

		@container main (width > 600px) {
			.pulje-heading {
				margin: 0 0 var(--spacing-5x);
			}
		}
	</style>
	<div class="page-content-container event-pulje-overview">
		if programPublished {
			if publishedDay != nil {
				if len(publishedDay.ProgramEvents) > 0 {
					<section class="container-inner-padding program-section">
						<h2 class="pulje-heading">Programoversikt</h2>
						<div class="program-event-grid">
							for _, row := range ProgramEventRows(publishedDay.ProgramEvents) {
								<div class={ "program-event-row", templ.KV("reversed", row.Reversed) }>
									for _, programEvent := range row.Events {
										@components.ProgramEventCard(programEvent.Event, eventImageDir, string(programEvent.PuljeID), publishedDay.QueryValue())
									}
								</div>
							}
						</div>
					</section>
				}
				for _, block := range publishedDay.Blocks {
					@eventPuljeBlock(block, eventImageDir, publishedDay.QueryValue())
				}
			}
		} else {
			{{ events, err := GetAnnouncedEventsAlphabetically(db) }}
			if err != nil {
				<p class="root-page-error">{ rootEventsLoadErrorMessage }</p>
			} else {
				@flatEventList(events, eventImageDir)
			}
		}
	</div>
}
