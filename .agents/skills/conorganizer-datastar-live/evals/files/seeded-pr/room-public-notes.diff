@@ -0,0 +1,48 @@
+package admin
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Regncon/conorganizer/service/live"
+	"github.com/Regncon/conorganizer/testutil"
+	"github.com/Regncon/conorganizer/testutil/bdd"
+	"github.com/go-chi/chi/v5"
+)
+
+func TestRoomPublicNotes_SavesNotesForRoom(t *testing.T) {
+	bdd.Behavior(t, bdd.BDD{
+		Given: "Gitt et rom uten offentlig notat.",
+		When:  "Når en administrator lagrer et notat fra romkortet.",
+		Then:  "Så er notatet lagret på rommet.",
+	})
+
+	// Given
+	expectedNotes := "Nøkkel hentes i resepsjonen"
+	db, logger := testutil.CreateTestDBAndLogger(t, "room_public_notes_route")
+	testutil.MustExec(t, db, `INSERT INTO rooms(id,name,room_number,floor,max_concurrent_games) VALUES(42,'Andre','705',7,0)`)
+	router := chi.NewRouter()
+	if err := SetupAdminRoute(router, logger, &live.Manager{}, db, nil); err != nil {
+		t.Fatal(err)
+	}
+
+	// When
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodPut, "/admin/rooms/api/42/public-notes", strings.NewReader(`{"publicNotes": "Nøkkel hentes i resepsjonen"}`))
+	request.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(recorder, request)
+
+	// Then
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("expected status %d, got %d: %s", http.StatusOK, recorder.Code, recorder.Body.String())
+	}
+	var actualNotes string
+	if err := db.QueryRow(`SELECT public_notes FROM rooms WHERE id = 42`).Scan(&actualNotes); err != nil {
+		t.Fatal(err)
+	}
+	if actualNotes != expectedNotes {
+		t.Fatalf("public notes mismatch\nexpected: %q\nactual:   %q", expectedNotes, actualNotes)
+	}
+}
