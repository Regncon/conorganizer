#!/usr/bin/env bash
set -euo pipefail

sqlite_database_path="/mnt/HC_Volume_103911252/environments/main/database/events.db"
sqlite_wal_path="${sqlite_database_path}-wal"
backups_root_directory="/mnt/HC_Volume_103911252/backups"
backup_directory="${backups_root_directory}/sqlite"
backup_retention_days="14"
metrics_file="/var/lib/prometheus/node-exporter/conorganizer-sqlite-backup.prom"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_file="${backup_directory}/events-${timestamp}.db"
compressed_backup_file="${backup_file}.zst"

mkdir -p "$backup_directory"

echo "conorganizer-sqlite-backup: started"

if [[ ! -f "$sqlite_database_path" ]]; then
    echo "conorganizer-sqlite-backup: database does not exist: ${sqlite_database_path}"
    exit 1
fi

sqlite3 "$sqlite_database_path" ".backup '${backup_file}'"

integrity_result="$(sqlite3 "$backup_file" "PRAGMA integrity_check;")"

if [[ "$integrity_result" != "ok" ]]; then
    echo "conorganizer-sqlite-backup: integrity check failed"
    echo "$integrity_result"
    rm -f "$backup_file"
    exit 1
fi

expected_table_count="$(
    sqlite3 "$backup_file" "
        SELECT COUNT(*)
        FROM sqlite_master
        WHERE type = 'table'
          AND name IN ('users', 'events');
    "
)"

if [[ "$expected_table_count" != "2" ]]; then
    echo "conorganizer-sqlite-backup: sanity check failed, expected core tables are missing"
    rm -f "$backup_file"
    exit 1
fi

sqlite3 "$backup_file" "
    SELECT COUNT(*) FROM users;
    SELECT COUNT(*) FROM events;
" > /dev/null

cp "$backup_file" "$backup_directory/events-latest.db"

zstd --quiet --rm "$backup_file"

find "$backup_directory" \
    -type f \
    -name 'events-*.db.zst' \
    -mtime "+${backup_retention_days}" \
    -delete

echo "conorganizer-sqlite-backup: created ${compressed_backup_file}"

completed_at_seconds="$(date +%s)"
backup_size_bytes="$(stat --format=%s "$compressed_backup_file")"
database_size_bytes="$(stat --format=%s "$sqlite_database_path")"
wal_size_bytes="0"
if [[ -f "$sqlite_wal_path" ]]; then
    wal_size_bytes="$(stat --format=%s "$sqlite_wal_path")"
fi
backups_root_size_bytes="$(du --summarize --block-size=1 "$backups_root_directory" | cut --fields=1)"

metrics_temporary_file="$(mktemp "${metrics_file}.XXXXXX")"
cat > "$metrics_temporary_file" <<EOF
# HELP conorganizer_sqlite_backup_last_success_timestamp_seconds Unix time when the last successful SQLite backup of main completed.
# TYPE conorganizer_sqlite_backup_last_success_timestamp_seconds gauge
conorganizer_sqlite_backup_last_success_timestamp_seconds ${completed_at_seconds}
# HELP conorganizer_sqlite_backup_size_bytes Size of the newest compressed SQLite backup.
# TYPE conorganizer_sqlite_backup_size_bytes gauge
conorganizer_sqlite_backup_size_bytes ${backup_size_bytes}
# HELP conorganizer_sqlite_db_size_bytes Size of main's events.db at the last successful backup.
# TYPE conorganizer_sqlite_db_size_bytes gauge
conorganizer_sqlite_db_size_bytes ${database_size_bytes}
# HELP conorganizer_sqlite_wal_size_bytes Size of main's events.db-wal at the last successful backup, 0 when it does not exist.
# TYPE conorganizer_sqlite_wal_size_bytes gauge
conorganizer_sqlite_wal_size_bytes ${wal_size_bytes}
# HELP conorganizer_backup_directory_size_bytes Disk space used by ${backups_root_directory}.
# TYPE conorganizer_backup_directory_size_bytes gauge
conorganizer_backup_directory_size_bytes ${backups_root_size_bytes}
EOF
# mktemp creates the file as 0600, and node_exporter reads it as the prometheus user.
chmod 0644 "$metrics_temporary_file"
mv "$metrics_temporary_file" "$metrics_file"

echo "conorganizer-sqlite-backup: completed successfully"

