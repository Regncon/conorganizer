package ticketholder

import (
	"fmt"

	"github.com/Regncon/conorganizer/models"
)

templ TicketHolderInterestPicker(
	eventId string,
	isOpenRegistration bool) {
	<style>
		.interest-buttons {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-2x);
            padding: var(--border-outline-width);
			.ticket-holder-error {
				color: var(--color-error);
			}

			.card-clickable {
				height: 3.75rem;
                display: flex;
                place-content: start;
                place-items: center;
                width: 100%;
			}

			.card-clickable.is-disabled {
				cursor: not-allowed;
				opacity: 0.65;
			}

			.interest-participation-warning {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2x);
				padding: var(--spacing-3x);
				border: 1px solid var(--color-warning);
				border-radius: var(--border-radius-1x);
				color: var(--color-text-soft);
				background: color-mix(in srgb, var(--color-warning) 10%, var(--bg-surface));

				p,
				ul {
					margin: 0;
				}
			}

			.interest-registration-warning {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2x);
				padding: var(--spacing-3x);
				border: 1px solid var(--color-warning);
				border-radius: var(--border-radius-1x);
				color: var(--color-text-soft);
				background: color-mix(in srgb, var(--color-warning) 10%, var(--bg-surface));

				p {
					margin: 0;
				}
			}

			&.is-disabled {
				.card-clickable {
					cursor: not-allowed;
					opacity: 0.65;
				}
			}

			.pulje-status-message {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2x);
				padding: var(--spacing-3x);
				border: 1px solid currentColor;
				border-radius: var(--border-radius-1x);
				color: var(--color-text-soft);
			}

			.pulje-status-message--warning {
				color: var(--color-warning, var(--color-error));
			}

			.pulje-status-message--urgent-warning {
				color: var(--color-error);
			}

			.pulje-status-message--locked {
				color: var(--color-accent-blue);
			}

			.pulje-status-message--completed {
				color: var(--color-success);
			}
		}
	</style>
	{{ pendingChoice := "Pending choice" }}
	<div
		class="interest-buttons"
		data-class:is-disabled="!$puljeCanEdit"
		data-signals:current-interest-level-choice={ fmt.Sprintf("'%s'", pendingChoice) }
		data-signals:selected-interest-level={ fmt.Sprintf("'%s'", models.InterestLevelNone) }
		data-signals:is-assigned-to-event="false"
		data-signals:ordinary-interests-disabled="false"
		data-signals:registration-disabled="false"
		data-signals:deregistration-disabled="false"
		data-signals:is-registered="false"
	>
		<strong
			class="ticket-holder-error"
			data-signals:interestErrorMessage
			data-text="$interestErrorMessage"
		></strong>
		<div
			class="pulje-status-message"
			data-show="$puljeStatusMessage"
			data-class:pulje-status-message--warning="$puljeAvailability === 'warning'"
			data-class:pulje-status-message--urgent-warning="$puljeAvailability === 'urgent-warning'"
			data-class:pulje-status-message--locked="$puljeAvailability === 'locked'"
			data-class:pulje-status-message--completed="$puljeAvailability === 'completed'"
		>
			<span data-text="$puljeStatusMessage"></span>
			<a
				href="/profile"
				class="btn btn--outline"
				data-show="$puljeShowProfileLink"
			>
				Se profilen din
			</a>
		</div>
		if isOpenRegistration {
			<section class="interest-registration-warning" role="status" data-show="!$isAssignedToEvent">
				<p><strong>«Meld deg på» gir ein stadfesta plass i denne pulja.</strong></p>
				<p>Billettheldaren blir då ikkje vurdert for andre arrangement gjennom den ordinære fordelinga i pulja, men kan framleis melde seg på andre arrangement med open påmelding.</p>
			</section>
		}
		<div id="interest-participation-warning"></div>
		<div
			role="button"
			class="card-clickable card-clickable-item interest-deregister"
			data-show="$isAssignedToEvent"
			data-class:is-disabled="!$puljeCanEdit || $deregistrationDisabled"
			data-attr:aria-disabled="!$puljeCanEdit || $deregistrationDisabled ? 'true' : 'false'"
			data-attr:tabindex="!$puljeCanEdit || $deregistrationDisabled ? '-1' : '0'"
			data-on:click={ fmt.Sprintf("if ($puljeCanEdit && !$deregistrationDisabled) { $isRegistered = false; @put('/event/api/%s/registration') }", eventId) }
		>
			<span class="emoji">↩️</span> Meld deg av
		</div>
		if isOpenRegistration {
			<div
				role="button"
				class="card-clickable card-clickable-item interest-register"
				data-show="!$isAssignedToEvent"
				data-class:is-disabled="!$puljeCanEdit || $registrationDisabled"
				data-attr:aria-disabled="!$puljeCanEdit || $registrationDisabled ? 'true' : 'false'"
				data-attr:tabindex="!$puljeCanEdit || $registrationDisabled ? '-1' : '0'"
				data-on:click={ fmt.Sprintf("if ($puljeCanEdit && !$registrationDisabled) { $isRegistered = true; @put('/event/api/%s/registration') }", eventId) }
			>
				<span class="emoji">🎟️</span> Meld deg på
			</div>
		} else {
			<div
				role="button"
				class="card-clickable card-clickable-item interest-high"
				data-show="!$isAssignedToEvent"
				data-class:selected={ fmt.Sprintf("$currentInterestLevelChoice === '%s' ? $selectedInterestLevel === '%s': $currentInterestLevelChoice === '%s'", pendingChoice, models.InterestLevelHigh, models.InterestLevelHigh) }
				data-class:is-disabled="!$puljeCanEdit || $ordinaryInterestsDisabled"
				data-attr:aria-disabled="!$puljeCanEdit || $ordinaryInterestsDisabled ? 'true' : 'false'"
				data-attr:tabindex={ fmt.Sprintf("!$puljeCanEdit || $ordinaryInterestsDisabled ? '-1' : $currentInterestLevelChoice === '%s' ? $selectedInterestLevel === '%s' ? '-1' : '0' : '0'", pendingChoice, models.InterestLevelHigh) }
				data-on:click={ fmt.Sprintf("if ($puljeCanEdit && !$ordinaryInterestsDisabled) { $currentInterestLevelChoice = '%s'; @put('/event/api/%s/interest/update/interest') }", models.InterestLevelHigh, eventId) }
			>
				<span class="emoji">{ models.InterestLevelHigh.Emoji() }</span> { models.InterestLevelHigh.Label() }
			</div>
		}
		<div
			role="button"
			class="card-clickable card-clickable-item"
			data-class:selected={ fmt.Sprintf("$currentInterestLevelChoice === '%s' ? $selectedInterestLevel === '%s': $currentInterestLevelChoice === '%s'", pendingChoice, models.InterestLevelMedium, models.InterestLevelMedium) }
			data-class:is-disabled="!$puljeCanEdit || $ordinaryInterestsDisabled"
			data-attr:aria-disabled="!$puljeCanEdit || $ordinaryInterestsDisabled ? 'true' : 'false'"
			data-attr:tabindex={ fmt.Sprintf("!$puljeCanEdit || $ordinaryInterestsDisabled ? '-1' : $currentInterestLevelChoice === '%s' ? $selectedInterestLevel === '%s' ? '-1' : '0' : '0'", pendingChoice, models.InterestLevelMedium) }
			data-on:click={ fmt.Sprintf("if ($puljeCanEdit && !$ordinaryInterestsDisabled) { $currentInterestLevelChoice = '%s'; @put('/event/api/%s/interest/update/interest') }", models.InterestLevelMedium, eventId) }
		>
			<span class="emoji">{ models.InterestLevelMedium.Emoji() }</span> { models.InterestLevelMedium.Label() }
		</div>
		<div
			role="button"
			class="card-clickable card-clickable-item"
			data-class:selected={ fmt.Sprintf("$currentInterestLevelChoice === '%s' ? $selectedInterestLevel === '%s': $currentInterestLevelChoice === '%s'", pendingChoice, models.InterestLevelLow, models.InterestLevelLow) }
			data-class:is-disabled="!$puljeCanEdit || $ordinaryInterestsDisabled"
			data-attr:aria-disabled="!$puljeCanEdit || $ordinaryInterestsDisabled ? 'true' : 'false'"
			data-attr:tabindex={ fmt.Sprintf("!$puljeCanEdit || $ordinaryInterestsDisabled ? '-1' : $currentInterestLevelChoice === '%s' ? $selectedInterestLevel === '%s' ? '-1' : '0' : '0'", pendingChoice, models.InterestLevelLow) }
			data-on:click={ fmt.Sprintf("if ($puljeCanEdit && !$ordinaryInterestsDisabled) { $currentInterestLevelChoice = '%s'; @put('/event/api/%s/interest/update/interest') }", models.InterestLevelLow, eventId) }
		>
			<span class="emoji">{ models.InterestLevelLow.Emoji() }</span> { models.InterestLevelLow.Label() }
		</div>
		<div
			role="button"
			class="card-clickable card-clickable-item"
			data-class:selected={ fmt.Sprintf("$currentInterestLevelChoice === '%s' ? $selectedInterestLevel === '%s': $currentInterestLevelChoice === '%s'", pendingChoice, models.InterestLevelNone, models.InterestLevelNone) }
			data-class:is-disabled="!$puljeCanEdit || $ordinaryInterestsDisabled"
			data-attr:aria-disabled="!$puljeCanEdit || $ordinaryInterestsDisabled ? 'true' : 'false'"
			data-attr:tabindex={ fmt.Sprintf("!$puljeCanEdit || $ordinaryInterestsDisabled ? '-1' : $currentInterestLevelChoice === '%s' ? $selectedInterestLevel === '%s' ? '-1' : '0' : '0'", pendingChoice, models.InterestLevelNone) }
			data-on:click={ fmt.Sprintf("if ($puljeCanEdit && !$ordinaryInterestsDisabled) { $currentInterestLevelChoice = '%s'; @put('/event/api/%s/interest/update/interest') }", models.InterestLevelNone, eventId) }
		>
			<span class="emoji">😑</span> { models.InterestLevelNone.Label() }
		</div>
	</div>
}
