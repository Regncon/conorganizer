package ticketholder

import (
	"database/sql"
	"fmt"
	"github.com/Regncon/conorganizer/service/requestctx"
	"log/slog"
)

templ TicketHolderPicker(userInfo requestctx.UserRequestInfo, eventId string, db *sql.DB, logger *slog.Logger) {
	<style>
		.ticket-holder-container {
			padding-bottom: var(--responsive-pane-padding);
            .ticket-holder-error {
                color: var(--color-error);
            }

            &:empty {
                display: none;
            }
            .ticket-holder-picker-buttons {
                column-gap:calc(var(--border-outline-width) - var(--spacing-2x));
                row-gap: var(--spacing-2x);
                display: flex;
                flex-direction: column;

                .ticket-holder-picker {
                    div {
                        width: 100%;
                        width: stretch;
                        width: --webkit-fill-available;
                        place-content: center;
                    }
                }
            }
		}

        @container interest-dialog (width >= 308px) {
            .ticket-holder-container {
                .ticket-holder-picker-buttons {
                    display: flex;
                    flex-wrap: wrap;
                    flex-direction: row;

                    .ticket-holder-picker {
                        div {
                            width: 9.1rem;
                            place-content: unset;
                        }
                    }
                }
            }
        }

        @container interest-dialog (width >= 370px) {
            .ticket-holder-container {
                .ticket-holder-picker-buttons {
                    display: grid;
                    grid-template-columns: repeat(3, auto);

                    .ticket-holder-picker {
                        div {
                            width: stretch;
                            width: -webkit-fill-available;
                        }
                    }
                }
            }
        }
	</style>
	{{
		associatedTicketHolders, err := GetTicketHolders(userInfo, db)
		billettholderOptions := NewBillettholderOptions(userInfo, associatedTicketHolders)
		associatedTicketHoldersJSON, _ := templ.JSONString(billettholderOptions.Associated)
		defaultBillettholderJSON, _ := templ.JSONString(billettholderOptions.Default)
	}}
	if err != nil {
		{{ logger.Error(err.Error(), "user_id", userInfo.Id) }}
		<div class="ticket-holder-error">
			<p>Feil ved henting av billettholdere: { err.Error() }</p>
		</div>
		return
	}
	<div
		class="ticket-holder-container"
		data-signals__ifmissing:billett-holder-id=""
		data-on:billettholder-selected="$billettHolderId = evt.detail"
		data-init={ fmt.Sprintf("const init = window.conorganizer.billettholderSelection.initialize(%s, %s); $billettHolderId = init?.Id ?? '';", associatedTicketHoldersJSON, defaultBillettholderJSON) }
	>
		if err != nil {
			<div class="ticket-holder-error">
				<p>Feil ved henting av billettholdere: { err.Error() }</p>
			</div>
		}
		if billettholderOptions.CanSwitchBillettholder() && len(billettholderOptions.Associated) < 4 {
			<p class="label">Velg billettholder</p>
			<div class="ticket-holder-picker-buttons">
				for _, billettHolder := range billettholderOptions.Associated {
					@TicketHolderButton(billettHolder)
				}
			</div>
		}
		if len(billettholderOptions.Associated) > 3 {
			<p class="label">Velg billettholder</p>
			<div class="ticket-holder-picker-dropdown">
				@TicketHolderDropDown(eventId, userInfo, billettholderOptions.Associated)
			</div>
		}
	</div>
}
