package eventimgupload

import (
	"database/sql"
	"encoding/json"
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"os"
	"path/filepath"
	"strings"
	"time"

	"github.com/Regncon/conorganizer/components"
	"github.com/Regncon/conorganizer/components/formsubmission"
	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/components/toast"
	"github.com/Regncon/conorganizer/layouts"
	"github.com/Regncon/conorganizer/service/eventService"
	"github.com/Regncon/conorganizer/service/userctx"
	"github.com/go-chi/chi/v5"
	datastar "github.com/starfederation/datastar-go/datastar"
)

func EventImageRoute(router chi.Router, db *sql.DB, eventImageDir *string, logger *slog.Logger) {
	router.Get("/", func(w http.ResponseWriter, r *http.Request) {
		eventId := chi.URLParam(r, "id")
		if eventId == "" {
			http.Error(w, "Arrangement-ID manglar. Fekk: "+eventId, http.StatusBadRequest)
			return
		}
		var ctx = r.Context()
		userInfo := userctx.GetUserRequestInfo(ctx)
		showUploadToast := r.URL.Query().Get("uploaded") == "source"
		if err := layouts.Base(
			"Legg til bilete",
			userInfo,
			db,
			logger,
			page(eventId, db, eventImageDir, logger, showUploadToast),
		).Render(ctx, w); err != nil {
			logger.Error(fmt.Errorf("failed to render event image page: %w", err).Error(), "event_id", eventId, "user_id", userInfo.Id)
		}
	})
}

func EventImageFormSubmission(newEventRouter chi.Router, db *sql.DB, eventImageDir *string, logger *slog.Logger) {
	newEventRouter.Post("/", func(w http.ResponseWriter, r *http.Request) {
		eventID := chi.URLParam(r, "id")
		if eventID == "" {
			logger.Warn("Event ID is required")
			http.Error(w, "Arrangement-ID manglar", http.StatusBadRequest)
			return
		}
		logger.Info("Uploading event image", "event_id", eventID)

		file, header, err := r.FormFile("image")
		if err != nil {
			logger.Error(fmt.Errorf("failed to get image from form for event %s: %w", eventID, err).Error())
			http.Error(w, "Klarte ikkje å hente bilete frå skjemaet", http.StatusBadRequest)
			return
		}
		defer file.Close()
		if err := removeExistingSourceImages(eventID, eventImageDir); err != nil {
			logger.Error("Failed to remove existing source images", "error", err)
			http.Error(w, "Klarte ikkje å erstatte biletet", http.StatusInternalServerError)
			return
		}
		filename := sourceImageFilename(eventID, header.Filename)
		imagePath := filepath.Join(*eventImageDir, filename)
		out, err := os.Create(imagePath)
		if err != nil {
			logger.Error(fmt.Errorf("failed to create image file %q: %w", imagePath, err).Error())
			http.Error(w, "Klarte ikkje å lagre biletet", http.StatusInternalServerError)
			return
		}
		defer out.Close()
		_, err = io.Copy(out, file)
		if err != nil {
			logger.Error(fmt.Errorf("failed to save image file %q: %w", imagePath, err).Error())
			http.Error(w, "Klarte ikkje å lagre biletet", http.StatusInternalServerError)
			return
		}
		if err := formsubmission.TouchEventUpdatedAt(r.Context(), db, logger, eventID); err != nil {
			logger.Error(fmt.Errorf("failed to touch event after source image upload for event %s: %w", eventID, err).Error())
			http.Error(w, "Klarte ikkje å oppdatere revisjonsspor for arrangementsbiletet", http.StatusInternalServerError)
			return
		}
		logger.Info("Image uploaded successfully", "path", imagePath)
		sourceImageURL := cacheBustedImageURL(getUploadedSourceImageURL(eventID, eventImageDir))

		if r.Header.Get("Upload-Progress-Request") == "true" {
			w.Header().Set("Content-Type", "application/json")
			if err := json.NewEncoder(w).Encode(map[string]string{"sourceImageUrl": sourceImageURL}); err != nil {
				logger.Error("Failed to encode source image upload response", "error", err, "event_id", eventID)
			}
			return
		}

		if r.Header.Get("Datastar-Request") == "true" {
			sse := datastar.NewSSE(w, r)
			if err := sse.MarshalAndPatchSignals(map[string]string{"sourceImageUrl": sourceImageURL}); err != nil {
				logger.Error("Failed to patch source image URL after upload", "error", err, "event_id", eventID)
			}
			return
		}

		http.Redirect(w, r, fmt.Sprintf("/profile/new/%s/image/?uploaded=source", eventID), http.StatusSeeOther)
	})
}

func EventImageCroppedSubmission(newEventRouter chi.Router, db *sql.DB, eventImageDir *string, logger *slog.Logger) {
	newEventRouter.Post("/", func(w http.ResponseWriter, r *http.Request) {
		logger.Info("Received cropped image upload request")
		eventID := chi.URLParam(r, "id")
		if strings.TrimSpace(eventID) == "" {
			logger.Warn("Event ID is required")
			http.Error(w, "Arrangement-ID manglar", http.StatusBadRequest)
			return
		}
		imageKind := r.FormValue("kind")
		if imageKind != "card" && imageKind != "banner" {
			logger.Warn("Invalid image kind", "imageKind", imageKind)
			http.Error(w, "Ugyldig bilettype", http.StatusBadRequest)
			return
		}
		logger.Info("Uploading cropped event image", "event_id", eventID, "imageKind", imageKind)
		file, _, err := r.FormFile("image")
		if err != nil {
			logger.Error(fmt.Errorf("failed to get cropped image from form for event %s: %w", eventID, err).Error())
			http.Error(w, "Klarte ikkje å hente bilete frå skjemaet", http.StatusBadRequest)
			return
		}
		defer file.Close()
		filename := fmt.Sprintf("%s_%s.webp", eventID, imageKind)
		imagePath := fmt.Sprintf("%s/%s", *eventImageDir, filename)
		out, err := os.Create(imagePath)
		if err != nil {
			logger.Error(fmt.Errorf("failed to create cropped image file %q: %w", imagePath, err).Error())
			http.Error(w, "Klarte ikkje å lagre biletet", http.StatusInternalServerError)
			return
		}
		defer out.Close()
		_, err = io.Copy(out, file)
		if err != nil {
			logger.Error(fmt.Errorf("failed to save cropped image file %q: %w", imagePath, err).Error())
			http.Error(w, "Klarte ikkje å lagre biletet", http.StatusInternalServerError)
			return
		}
		if err := formsubmission.TouchEventUpdatedAt(r.Context(), db, logger, eventID); err != nil {
			logger.Error(fmt.Errorf("failed to touch event after cropped image upload for event %s: %w", eventID, err).Error())
			http.Error(w, "Klarte ikkje å oppdatere revisjonsspor for arrangementsbiletet", http.StatusInternalServerError)
			return
		}
		logger.Info("Image uploaded successfully", "path", imagePath)
		if r.Header.Get("Datastar-Request") == "true" {
			w.WriteHeader(http.StatusNoContent)
			return
		}
		http.Redirect(w, r, fmt.Sprintf("/profile/new/%s/image/", eventID), http.StatusSeeOther)
	})
}

func sourceImageFilename(eventID string, originalFilename string) string {
	ext := strings.ToLower(filepath.Ext(originalFilename))
	if ext == "" {
		ext = ".img"
	}
	return fmt.Sprintf("%s_source%s", eventID, ext)
}

func removeExistingSourceImages(eventID string, eventImageDir *string) error {
	if eventImageDir == nil || strings.TrimSpace(*eventImageDir) == "" {
		return nil
	}
	entries, err := os.ReadDir(*eventImageDir)
	if err != nil {
		return err
	}
	prefix := eventID + "_source"
	for _, entry := range entries {
		if entry.IsDir() || !strings.HasPrefix(entry.Name(), prefix) {
			continue
		}
		if err := os.Remove(filepath.Join(*eventImageDir, entry.Name())); err != nil {
			return err
		}
	}
	return nil
}

func getUploadedSourceImageURL(eventID string, eventImageDir *string) string {
	if eventImageDir == nil || strings.TrimSpace(*eventImageDir) == "" {
		return ""
	}
	entries, err := os.ReadDir(*eventImageDir)
	if err != nil {
		return ""
	}
	prefix := eventID + "_source"
	for _, entry := range entries {
		if entry.IsDir() || !strings.HasPrefix(entry.Name(), prefix) {
			continue
		}
		return "/event-images/" + entry.Name()
	}
	return ""
}

func cacheBustedImageURL(imageURL string) string {
	if imageURL == "" {
		return ""
	}
	separator := "?"
	if strings.Contains(imageURL, "?") {
		separator = "&"
	}
	return fmt.Sprintf("%s%sv=%d", imageURL, separator, time.Now().UnixNano())
}

templ page(eventId string, db *sql.DB, eventImageDir *string, logger *slog.Logger, showUploadToast bool) {
	{{
		event, eventErr := eventservice.GetEventById(eventId, db)
		var title string
		imageUrl := getUploadedSourceImageURL(eventId, eventImageDir)
		if eventErr == nil && event != nil {
			title = event.Title
		}

		if title == "" {
			title = "Mangler navn"
		}
	}}
	if eventErr != nil {
		{{ logger.Error(fmt.Errorf("failed to load event image page for event %s: %w", eventId, eventErr).Error()) }}
		<p>Klarte ikkje å hente arrangement: { eventErr.Error() }</p>
		return
	}
	if event == nil {
		{{ logger.Warn("Event not found for event image page", "event_id", eventId) }}
		<p>Fann ikkje arrangementet</p>
		return
	}
	<script type="module" src="/static/web_components/banner_cropper.js"></script>
	@toast.Render("Lagra", icons.ProgressComplete)
	<script type="module" src="/static/js/custom-actions/upload-with-progress.js"></script>
	<style>

        @keyframes cropper-loading-spin {
            to {
                rotate: 1turn;
            }
        }
        .page-content-container {
            max-width: 1020px;
        }

        .back-button {
            font-size: unset;
            margin-block-start: var(--spacing-10x);
        }

        h1 {
            margin-block: var(--spacing-5x) var(--spacing-10x);
        }

        .img-upload-form-content {
            display: flex;
            flex-direction: column;
            gap: var(--responsive-pane-column-spacing);

            .info-text-content {
                display: flex;
                flex-direction: column;
                gap: var(--spacing-5x);

                .image-upload-info-label {
                    font-weight: 700;
                }
            }

            .image-upload-content {
                display: flex;
                flex-direction: column;
                gap: var(--spacing-5x);

                .image-upload-card {
                    display: flex;
                    flex-direction: column;
                    place-items: center;
                    place-content: center;
                    height: 208px;
                    position: relative;
                    text-align: center;
                    outline: 2px dashed transparent;
                    outline-offset: -8px;
                    transition: background-color 0.2s, outline-color 0.2s, box-shadow 0.2s;

                    &:is(.is-drag-over) {
                        background-color: color-mix(in srgb, var(--color-primary) 12%, var(--bg-item));
                        outline-color: var(--color-primary);
                        box-shadow: inset 0 0 32px color-mix(in srgb, var(--color-primary) 10%, transparent);

                        .image-upload-icon-wrapper {
                            translate: 0 -4px;
                            scale: 1.1;
                        }
                    }

                    &:is([aria-busy="true"]) {
                        cursor: progress;
                    }

                    p+p {
                        margin-block-start: var(--spacing-3x)
                    }
                    p:last-child {
                        margin:0;
                    }

                    input[type="file"] {
                        block-size: 100%;
                        inline-size: 100%;
                        position: absolute;
                        inset: 0;
                        z-index: 1;
                        opacity: 0;
                        cursor: pointer;

                        &:disabled {
                            pointer-events: none;
                        }
                    }

                    .image-upload-icon-wrapper {
                        height: 40px;
                        width: 40px;
                        border-radius: 100vw;
                        background-color: var(--color-primary-hover);
                        display: grid;
                        place-content: center;
                        margin-block-end: var(--spacing-5x);
                        transition: translate 0.2s, scale 0.2s;
                    }

                }

                .image-upload-progress-wrapper {
                    display: grid;
                    padding-inline: var(--spacing-4x);
                    inline-size: 100%;
                    gap: var(--spacing-3x);
                    text-align: center;

                    .image-upload-progress {
                        position: relative;
                        height: 8px;
                        background-color: var(--bg-item-hover);
                        border: 1px solid var(--bg-item-focus-visible);
                        border-radius: var(--border-radius-2x);

                        .progress-bar {
                            position: absolute;
                            inset: 0;
                            width: calc(var(--progress) * 1%);
                            background-color: var(--color-primary);
                            border-radius: var(--border-radius-2x);

                            transition: width 0.4s ease-out;
                        }

                        span {
                            text-align: center;
                        }
                    }
                }
                .item-card:is(:not(.file-info)) {
                    padding: 0;
                    border-radius: var(--border-radius-1x);
                    border: 1px solid var(--bg-item-border)
                }
            }

            .banner-cropper {
                .cropper-actions {
                    display: grid;
                    grid-template-columns: 1fr auto;
                    place-items: center start;
                    gap: var(--spacing-4x);

                    button {
                        grid-column: 2;
                        place-self: end;
                    }
                }

                inline-size: min-content;
                block-size: max-content;

                .cropper-placeholder-canvas {
                    display: grid;
                    place-content: center;
                    inline-size: var(--cropper-placeholder-inline-size);
                    block-size: var(--cropper-placeholder-block-size);
                    color: var(--color-primary);
                    background: var(--bg-item);
                    border-radius: var(--border-radius-2x);

                    .inline-icon {
                        animation: cropper-loading-spin 1s linear infinite;
                    }
                }

                &:is(.cropper-placeholder--banner) {
                    --cropper-placeholder-inline-size: 980px;
                    --cropper-placeholder-block-size: 229px;
                }

                &:is(.cropper-placeholder--card) {
                    --cropper-placeholder-inline-size: 540px;
                    --cropper-placeholder-block-size: 200px;
                }
            }
        }
    </style>
	@components.Breadcrumbs([]components.BreadcrumbPath{
		{Name: "Heim", Url: "/"},
		{Name: "Mine arrangement", Url: "/profile/"},
		{Name: title, Url: "/profile/new/" + eventId + "/"},
		{Name: "Legg til bilete", Url: ""},
	})
	<article
		class="page-content-container"
		data-signals__ifmissing={ formsubmission.DataSignals(map[string]any{
            "_add_drag_over": false,
            "_uploading": false,
            "_uploadProgress": 0,
            "_uploadError": "",
            "_bannerCrop": map[string]any{"ready": false, "loading": false, "loadError": "", "exporting": false, "saveError": "", "saved": false},
            "_cardCrop": map[string]any{"ready": false, "loading": false, "loadError": "", "exporting": false, "saveError": "", "saved": false},
            "_has_current_image": imageUrl != "",
            "toastBannerImage": false,
            "toastCardImage": false,
        }) }
		data-computed:_cropper-image-ready="$_bannerCrop.ready && $_cardCrop.ready"
		data-computed:_cropper-image-loading="$_bannerCrop.loading || $_cardCrop.loading"
		data-computed:_cropper-image-error="$_bannerCrop.loadError || $_cardCrop.loadError"
		data-computed:_image-busy="$_uploading || $_cropperImageLoading || $_bannerCrop.exporting || $_cardCrop.exporting || $toastBannerImage || $toastCardImage"
	>
		if showUploadToast {
			<span hidden data-init="el.dispatchEvent(new CustomEvent('toast', { bubbles: true, detail: { message: 'Lagret' } })); const url = new URL(window.location.href); url.searchParams.delete('uploaded'); window.history.replaceState(null, '', url)"></span>
		}
		<a
			href={ templ.SafeURL("/profile/new/" + eventId + "/") }
			class="btn btn--outline back-button"
		>
			Tilbake
		</a>
		<h1>Legg til bilete</h1>
		<div
			class="img-upload-form-content"
			data-signals={ formsubmission.DataSignals(map[string]string{"sourceImageUrl": imageUrl}) }
		>
			<div class="surface-pane info-text-content">
				<div>
					<p class="image-upload-info-label">
						Ver venleg og ikkje bruk AI/KI-genererte bilete
					</p>
					<p>
						Sidan AI/KI-genererte bilete er eit betent tema, ønskjer vi i RegnCon ikkje
						at arrangørar skal bruke slike bilete som hovudbilete for arrangementet sitt.
					</p>
					<p>
						Om du er i tvil om bruk av bilete, anbefaler vi å finne bilete som er ope
						tilgjengelege for bruk, eller bilete som elles blir brukte til å demonstrere
						og promotere spelet/systemet du skal bruke på arrangementet.
					</p>
				</div>
			</div>
			<div
				class="surface-pane image-upload-content"
			>
				<h4>Last opp bilete</h4>
				<form
					enctype="multipart/form-data"
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/profile/api/new/%s/upload", eventId)) }
					data-on:submit__prevent={ fmt.Sprintf("if (!$_imageBusy) @uploadWithProgress('/profile/api/new/%s/upload', {progressSignal: '_uploadProgress', convertToWebp: true})", eventId) }
					data-indicator="_uploading"
					data-on:datastar-fetch__document="if (evt.detail.el === el) { if (evt.detail.type === 'started') { $_uploadError = ''; $_add_drag_over = false } if (evt.detail.type === 'error') $_uploadError = evt.detail.argsRaw.message; if (evt.detail.type === 'finished') el.reset() }"
					class="item-card image-upload-card"
					data-class:is-drag-over="$_add_drag_over"
					data-attr:aria-busy="($_uploading || $_cropperImageLoading) ? 'true' : 'false'"
					data-on:dragover__prevent="$_add_drag_over = !$_imageBusy && evt.dataTransfer.types.includes('Files'); evt.dataTransfer.dropEffect = $_add_drag_over ? 'copy' : 'none'"
					data-on:dragleave="if (!el.contains(evt.relatedTarget)) $_add_drag_over = false"
					data-on:drop__prevent="$_add_drag_over = false; if (!$_imageBusy && evt.dataTransfer.files.length) { el.elements.namedItem('image').files = evt.dataTransfer.files; el.requestSubmit() }"
				>
					<p
						data-show="$_cropperImageLoading"
						style="display: none;"
					>Lastar bilete. Ver venleg og vent...</p>
					<input
						data-on:change="if (el.files.length) el.form.requestSubmit()"
						data-attr:disabled="$_imageBusy"
						data-show="!$_cropperImageLoading"
						style="display: none;"
						type="file"
						name="image"
						accept="image/*"
						aria-label="Last opp bilde"
						required
					/>
					<div
						class="image-upload-icon-wrapper"
						data-show="!$_cropperImageLoading"
						style="display: none;"
					>
						@icons.Icon(icons.FileUpload, icons.Size20)
					</div>
					<p data-show="$_has_current_image" style="display: none;">Klikk eller dra og slipp for å bytte   bilete</p>
					<p data-show="!$_has_current_image && !$_uploading && !$_cropperImageLoading" data-text="$_add_drag_over ? 'Slipp bildet her' : 'Klikk her eller dra et bilde inn for å laste det opp.'" style="display: none;">
						Klikk her eller dra et bilde inn for å laste det opp.
					</p>
					<p data-show="!$_has_current_image && !$_uploading && !$_cropperImageLoading" style="display: none;">
						Støttede formater: PNG, JPG, ...
					</p>
					<div class="image-upload-progress-wrapper" data-show="$_uploading" style="display: none;">
						<div class="image-upload-progress" role="progressbar" aria-label="Laster opp bilde" aria-valuemin="0" aria-valuemax="100" data-attr:aria-valuenow="$_uploadProgress">
							<div class="progress-bar" data-style="{'--progress': $_uploadProgress}"></div>
						</div>
						<span data-text="$_uploadProgress === 100 ? 'Lastar bilete. Ver venleg og vent...' : ''"></span>
					</div>
					<p class="feedback-error" data-show="$_uploadError" data-text="$_uploadError"></p>
				</form>
			</div>
			<div
				class="surface-pane image-upload-content"
				data-show="$_cropperImageError"
			>
				<p class="feedback-error" data-text="$_cropperImageError"></p>
			</div>
			<div
				class="surface-pane banner-cropper cropper-placeholder--banner"
				data-show="$_cropperImageLoading"
			>
				<div
					class="cropper-placeholder-canvas"
					role="status"
					aria-label="Lastar bilete"
				>
					@icons.Icon(icons.Loading, icons.Size40)
				</div>
			</div>
			<div
				class="surface-pane banner-cropper cropper-placeholder--card"
				data-show="$_cropperImageLoading"
			>
				<div
					class="cropper-placeholder-canvas "
					role="status"
					aria-label="Lastar bilete"
				>
					@icons.Icon(icons.Loading, icons.Size40)
				</div>
			</div>
			@imageCropper(eventId, "banner", "Bannerbilder på arrangementsiden", "1360", "400", "980", "218", "_bannerCrop", "toastBannerImage")
			@imageCropper(eventId, "card", "Thumbnail på arrangementsiden", "600", "350", "540", "190", "_cardCrop", "toastCardImage")
		</div>
	</article>
}

// The component owns canvas operations; Datastar owns requests and feedback.
templ imageCropper(eventID, kind, label, width, height, previewWidth, previewHeight, stateName, indicator string) {
	{{ state := "$" + stateName }}
	<div class="surface-pane banner-cropper" data-show="$_cropperImageReady">
		<banner-cropper
			width={ width }
			height={ height }
			preview-width={ previewWidth }
			preview-height={ previewHeight }
			label={ label }
			data-on:image-loading={ fmt.Sprintf("%s.loading = true; %s.ready = false; %s.loadError = ''; %s.saved = false; %s.saveError = ''; %s.exporting = false", state, state, state, state, state, state) }
			data-on:image-ready={ fmt.Sprintf("%s.loading = false; %s.ready = true", state, state) }
			data-on:image-error={ fmt.Sprintf("%s.loading = false; %s.ready = false; %s.loadError = evt.detail.message", state, state, state) }
			data-on:crop-started={ fmt.Sprintf("%s.exporting = true; %s.saveError = ''; %s.saved = false", state, state, state) }
			data-on:crop-error={ fmt.Sprintf("%s.exporting = false; %s.saveError = evt.detail.message", state, state) }
			data-on:crop-ready={ fmt.Sprintf("%s.exporting = false; el.querySelector('input[name=image]').files = evt.detail.files; el.querySelector('form').requestSubmit()", state) }
			data-attr:image-url="$sourceImageUrl"
		>
			<form
				slot="actions"
				class="cropper-actions"
				enctype="multipart/form-data"
				data-indicator={ indicator }
				data-on:submit__prevent={ fmt.Sprintf("if (!$%s) @post('/profile/api/new/%s/upload-cropped', {contentType: 'form', requestCancellation: 'disabled', retry: 'never', retryMaxCount: 0})", indicator, eventID) }
				data-on:datastar-fetch__document={ fmt.Sprintf("if (evt.detail.el === el) { if (evt.detail.type === 'error' || evt.detail.type === 'retries-failed') %s.saveError = 'Kunne ikke lagre bildet. Prøv igjen.'; if (evt.detail.type === 'finished' && !%s.saveError) %s.saved = true }", state, state, state) }
			>
				<input type="file" name="image" hidden required/>
				<input type="hidden" name="kind" value={ kind }/>
				<div aria-live="polite">
					<span data-show={ fmt.Sprintf("%s.exporting || $%s", state, indicator) } style="display: none;">Laster opp...</span>
					<span data-show={ state + ".saved" } style="display: none;">Lastet opp</span>
					<span class="feedback-error" data-show={ state + ".saveError" } data-text={ state + ".saveError" } style="display: none;"></span>
				</div>
				<button
					type="button"
					class="btn btn--outline"
					data-attr:disabled={ fmt.Sprintf("$_uploading || !%s.ready || %s.exporting || $%s", state, state, indicator) }
					data-on:click="el.closest('banner-cropper').exportImage()"
				>Lagre</button>
			</form>
		</banner-cropper>
	</div>
}
