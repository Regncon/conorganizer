package components

import (
	"fmt"
	"net/url"

	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/service/eventimage"
)

func eventCardHref(eventID string, pulje string, date string) string {
	query := url.Values{}
	if date != "" {
		query.Set("date", date)
	}
	if pulje != "" {
		query.Set("pulje", pulje)
	}

	href := fmt.Sprintf("/event/%s", url.PathEscape(eventID))
	if encoded := query.Encode(); encoded != "" {
		href += "?" + encoded
	}
	return href
}

templ EventCard(eventCard models.EventCardModel, eventImageDir *string, showStatus bool, pulje string, date string) {
	{{ cardClass := "" }}
	if pulje != "" {
		{{ cardClass = "raffle-event-card" }}
	}
	@renderEventCard(eventCard, eventImageDir, showStatus, pulje, date, true, true, false, cardClass)
}

templ ProgramEventCard(eventCard models.EventCardModel, eventImageDir *string, pulje string, date string) {
	@renderEventCard(eventCard, eventImageDir, false, pulje, date, false, false, true, "program-event-card")
}

templ renderEventCard(eventCard models.EventCardModel, eventImageDir *string, showStatus bool, pulje string, date string, showSystem bool, showHost bool, descriptionInFooter bool, cardClass string) {
	{{ imageUrl := eventimage.GetEventImageUrl(eventCard.Id, "card", eventImageDir) }}
	<a
		if eventCard.Status == models.EventStatusDraft || eventCard.Status == models.EventStatusSubmitted || eventCard.Status == models.EventStatusArchived {
			href={ templ.URL(fmt.Sprintf("/profile/new/%s", eventCard.Id)) }
		} else {
			href={ templ.URL(eventCardHref(eventCard.Id, pulje, date)) }
		}
		class={ "event-card-container", cardClass }
	>
		<img
			src={ imageUrl }
			alt="Bilde for arrangement"
			class="event-card-thumbnail"
		/>
		<div class="event-card-main-body">
			<div>
				<h2 class="event-card-title">
					if eventCard.Title != "" {
						{ eventCard.Title }
					} else {
						Nytt arrangement
					}
				</h2>
				if showSystem {
					<h3 class="event-card-subtitle">
						if eventCard.System != "" {
							{ eventCard.System }
						} else {
							Game System
						}
					</h3>
					}
			</div>
			if !descriptionInFooter {
				@eventCardDescription(eventCard, "")
			}
		</div>
		<div class="event-card-footer">
			if descriptionInFooter {
				@eventCardDescription(eventCard, "event-card-footer-description")
			}
			if showHost {
				<div class="event-card-footer-gamemaster">
					@icons.Icon(icons.Gamemaster, icons.Size24)
					<p>
						if eventCard.HostName != "" {
							{ eventCard.HostName }
						} else {
							Arrangørnavn
						}
					</p>
				</div>
			}
			<div class="event-card-footer-tagicons">
				if eventCard.EventType == models.EventTypeRoleplay {
					<div class="event-card-tagicon-container" data-tippy-content={ eventCard.EventType.Label() }>
						@icons.Icon(icons.EventRoleplay, icons.Size20)
					</div>
				} else if eventCard.EventType == models.EventTypeBoardGame {
					<div class="event-card-tagicon-container" data-tippy-content={ eventCard.EventType.Label() }>
						@icons.Icon(icons.EventBoardgame, icons.Size20)
					</div>
				} else if eventCard.EventType == models.EventTypeCardGame {
					<div class="event-card-tagicon-container" data-tippy-content={ eventCard.EventType.Label() }>
						@icons.Icon(icons.EventCardgame, icons.Size20)
					</div>
				} else if eventCard.EventType == models.EventTypeOther {
					<div class="event-card-tagicon-container" data-tippy-content={ eventCard.EventType.Label() }>
						@icons.Icon(icons.EventOtherGames, icons.Size20)
					</div>
				}
				if eventCard.AgeGroup == models.AgeGroupAdultsOnly {
					<div class="event-card-tagicon-container" data-tippy-content={ eventCard.AgeGroup.BadgeLabel() }>
						@icons.Icon(icons.EventAdultOnly, icons.Size20)
					</div>
				} else if eventCard.AgeGroup == models.AgeGroupChildFriendly {
					<div class="event-card-tagicon-container" data-tippy-content={ eventCard.AgeGroup.BadgeLabel() }>
						@icons.Icon(icons.EventChildFriendly, icons.Size20)
					</div>
				}
				if eventCard.Runtime == models.RunTimeLongRunning {
					<div class="event-card-tagicon-container" data-tippy-content={ eventCard.Runtime.BadgeLabel() }>
						@icons.Icon(icons.TimeOver6Hours, icons.Size20)
					</div>
				} else if eventCard.Runtime == models.RunTimeShortRunning {
					<div class="event-card-tagicon-container" data-tippy-content={ eventCard.Runtime.BadgeLabel() }>
						@icons.Icon(icons.TimeUnder3Hours, icons.Size20)
					</div>
				}
				if eventCard.BeginnerFriendly {
					<div class="event-card-tagicon-container" data-tippy-content="Nybegynnervennlig">
						@icons.Icon(icons.EventBeginnerFriendly, icons.Size20)
					</div>
				}
				if eventCard.CanBeRunInEnglish {
					<div class="event-card-tagicon-container" data-tippy-content="Can be run in English">
						@icons.Icon(icons.EventEnglish, icons.Size20)
					</div>
				}
			</div>
		</div>
	</a>
}

templ eventCardDescription(eventCard models.EventCardModel, className string) {
	<p class={ "event-card-description", className }>
		if eventCard.Intro != "" {
			{ eventCard.Intro }
		} else {
			Legg til en kort beskrivelse
		}
	</p>
}
