package components

import (
	"fmt"
	"strings"

	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/models"
)

type BillettholderInterest struct {
	BillettholderID   int
	BillettholderName string
	InterestLevel     models.InterestLevel
	IsSelected        bool
}

func (interest BillettholderInterest) Description() string {
	firstName := interest.BillettholderName
	if nameParts := strings.Fields(interest.BillettholderName); len(nameParts) > 0 {
		firstName = nameParts[0]
	}
	return fmt.Sprintf("%s er %s", firstName, strings.ToLower(interest.InterestLevel.Label()))
}

func (interest BillettholderInterest) HeartStyle() templ.SafeCSS {
	fill := "0%"
	switch interest.InterestLevel {
	case models.InterestLevelHigh:
		fill = "100%"
	case models.InterestLevelMedium:
		fill = "65%"
	case models.InterestLevelLow:
		fill = "45%"
	}
	return templ.SafeCSS(fmt.Sprintf("--interest-fill: %s;", fill))
}

func (interest BillettholderInterest) SelectedExpression() string {
	return fmt.Sprintf("$_menuBillettholder?.Id == %d", interest.BillettholderID)
}

templ InterestIndicator(interests []BillettholderInterest) {
	<style>
		.interest-indicator {
			--heart-size: 1.5rem;
			--heart-overlap: 1rem;

			position: relative;
			flex-shrink: 0;

			&:focus-visible {
				outline: 3px solid var(--color-secondary-focus-visible);
				outline-offset: 2px;
				border-radius: var(--border-radius-1x);
			}

			.interest-indicator-hearts {
				display: flex;
				padding-inline-start: var(--heart-overlap);
			}

			.interest-indicator-heart {
				--heart-color: var(--color-accent-blue);

				display: grid;
				margin-inline-start: calc(var(--heart-overlap) * -1);
				color: var(--heart-color);

				> span {
					display: grid;
					grid-area: 1 / 1;
				}

				/*
					The heart does not fill its 24px icon box: it starts 11% down
					and is 76.5% of the box tall. This math makes --interest-fill: 45%
					fill 45% of the heart, not 45% of the box.
				*/
				.interest-indicator-heart-fill {
					--heart-top: 11%;
					--heart-height: 0.765;

					clip-path: inset(calc(var(--heart-top) + (100% - var(--interest-fill)) * var(--heart-height)) 0 0 0);
				}

				&.selected {
					--heart-color: var(--color-primary);

					order: 1;
				}

				&:not(.selected) .interest-indicator-heart-fill {
					display: none;
				}

				&:not(.selected) ~ &:not(.selected) {
					display: none;
				}
			}

			/*
				The mask is inlined as a data URL instead of loading a file,
				because a mask file made the blue heart flicker on page load.
			*/
			&:has(.interest-indicator-heart.selected) .interest-indicator-heart:not(.selected) {
				mask-image: linear-gradient(#000 0 0), url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%0A%3Cpath d='M12 20.9999L10.55 19.6999C8.86667 18.1832 7.475 16.8749 6.375 15.7749C5.275 14.6749 4.4 13.6874 3.75 12.8124C3.1 11.9374 2.64583 11.1332 2.3875 10.3999C2.12917 9.66657 2 8.91657 2 8.1499C2 6.58324 2.525 5.2749 3.575 4.2249C4.625 3.1749 5.93333 2.6499 7.5 2.6499C8.36667 2.6499 9.19167 2.83324 9.975 3.1999C10.7583 3.56657 11.4333 4.08324 12 4.7499C12.5667 4.08324 13.2417 3.56657 14.025 3.1999C14.8083 2.83324 15.6333 2.6499 16.5 2.6499C18.0667 2.6499 19.375 3.1749 20.425 4.2249C21.475 5.2749 22 6.58324 22 8.1499C22 8.91657 21.8708 9.66657 21.6125 10.3999C21.3542 11.1332 20.9 11.9374 20.25 12.8124C19.6 13.6874 18.725 14.6749 17.625 15.7749C16.525 16.8749 15.1333 18.1832 13.45 19.6999L12 20.9999Z' fill='black' stroke='black' stroke-width='3' stroke-linejoin='round'/%3E%0A%3C/svg%3E");
				mask-composite: subtract;
				mask-position: 0 0, calc(var(--heart-size) - var(--heart-overlap)) 0;
				mask-repeat: no-repeat;
				mask-size: 100% 100%;
			}

			.interest-indicator-tooltip {
				position: absolute;
				inset-block-end: calc(100% + var(--spacing-3x));
				inset-inline-end: 0;
				z-index: 1;
				display: flex;
				flex-direction: column;
				gap: var(--spacing-1x);
				inline-size: max-content;
				max-inline-size: 16rem;
				margin: 0;
				padding: var(--spacing-2x) var(--spacing-3x);
				list-style: none;
				border-radius: var(--border-radius-1x);
				background-color: var(--bg-tooltip);
				color: var(--color-primary-text);
				font-size: var(--text-body-small);
				line-height: 1.4;
				overflow-wrap: anywhere;
				opacity: 0;
				transform: scale(0.8);
				transform-origin: calc(100% - var(--heart-size) / 2) 100%;
				pointer-events: none;
				transition: opacity 250ms, transform 250ms;

				&::after {
					content: "";
					position: absolute;
					inset-block-start: 100%;
					inset-inline-end: calc(var(--heart-size) / 2 - var(--spacing-2x));
					border: var(--spacing-2x) solid transparent;
					border-block-start-color: var(--bg-tooltip);
					border-block-end-width: 0;
				}

				.selected {
					order: -1;
				}
			}

			@media (hover: none) {
				&[data-open] .interest-indicator-tooltip {
					opacity: 1;
					transform: none;
				}
			}

			@media (hover: hover) {
				&:is(:hover, :focus-visible) .interest-indicator-tooltip {
					opacity: 1;
					transform: none;
				}
			}
		}
	</style>
	<span
		class="interest-indicator"
		tabindex="0"
		data-on:click="matchMedia('(hover: none)').matches && (evt.preventDefault(), el.toggleAttribute('data-open'))"
		data-on:click__outside="el.removeAttribute('data-open')"
	>
		<span class="interest-indicator-hearts" aria-hidden="true">
			for _, interest := range interests {
				<span
					class={ "interest-indicator-heart", templ.KV("selected", interest.IsSelected) }
					data-class:selected={ interest.SelectedExpression() }
					style={ interest.HeartStyle() }
				>
					<span class="interest-indicator-heart-fill">
						@icons.Icon(icons.HeartFilled, icons.Size24)
					</span>
					<span class="interest-indicator-heart-outline">
						@icons.Icon(icons.HeartUnfilled, icons.Size24)
					</span>
				</span>
			}
		</span>
		<ul class="interest-indicator-tooltip">
			for _, interest := range interests {
				<li
					class={ templ.KV("selected", interest.IsSelected) }
					data-class:selected={ interest.SelectedExpression() }
				>
					{ interest.Description() }
				</li>
			}
		</ul>
	</span>
}
