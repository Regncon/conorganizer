package header

import (
	"database/sql"
	"fmt"
	"github.com/Regncon/conorganizer/components/icons"
	"github.com/Regncon/conorganizer/components/ticket_holder"
	"github.com/Regncon/conorganizer/service/requestctx"
	"log/slog"
)

templ Menu(userInfo requestctx.UserRequestInfo, db *sql.DB, logger *slog.Logger) {
	{{
	logger := logger.With("component", "Menu")
	associatedBillettholdere, _ := ticketholder.GetTicketHolders(userInfo, db)
	currentBillettholder := ticketholder.GetYourBillettHolderInfo(userInfo, associatedBillettholdere)
	initials := ticketholder.GetInitials(currentBillettholder.Name)
	}}
	<style>
		.main-menu-header {
			width: 100%;
			background-color: var(--bg-surface);
			box-shadow: 0 2px 4px hsla(0, 0%, 0%, 0.1);
			position: fixed;
			bottom: 0;
			border-top: 1px solid var(--bg-item-border);
			z-index: var(--nav-z-index);
		}
		.main-menu {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: space-around;
			height: var(--nav-height);
			width: 100%;
			gap: var(--spacing-4x);
			font-family: var(--font-sans-serif);

			.logo-link {
				border-radius: 50%;
			}

			.logo-link:focus-visible {
				outline: none;
				background-color: var(--btn-ghost-hover-bg);
				box-shadow: 0 0 0 3px var(--btn-ghost-focus-shadow);
			}

			details {
				position: relative;
				display: block;
				place-self: center end;
			}

			summary {
				cursor: pointer;
				list-style: none;
				/* hide the default disclosure triangle in some browsers */
				color: var(--color-secondary);
				text-decoration: none;
			}

			summary::-webkit-details-marker {
				display: none;
				/* hide default marker in Chrome/Safari */
			}

			.menu-btn {
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				font-size: 12px;
				height: 48px;
				padding: 0 var(--spacing-4x);
				gap: var(--spacing-1x);
				.menu-btn-text {
					white-space: nowrap;
				}
			}

			.dropdown-panel {
				position: absolute;
				right: 0;
				bottom: 52px;
				background-color: var(--bg-item);
				border: 1px solid var(--bg-item-border);
				box-shadow: 0 8px 16px hsla(0, 0%, 0%, 0.2);
				border-radius: var(--border-radius-1x);
				z-index: var(--nav-drop-down-z-index);
				width: max-content;
				max-width: 260px;

                button {
                    height: fit-content;
                    font-weight: inherit;
                    font-family: inherit;
                    font-size: inherit;
                    padding-block: 0;
                }
                a, button {
                    display: block;
                    color: var(--color-primary-text);
                    padding: 0.5rem 1rem;
                    text-decoration: none;
			    }

                a.external-link {
                    display: flex;
                    align-items: center;
                    gap: var(--spacing-1x);
                }

                a:hover, a:focus-visible, button:hover, button:focus-visible {
                    background-color: hsla(0, 0%, 100%, 0.1);
                }
                a:focus-visible {
                    outline: none;
                    box-shadow: inset 0 0 0 2px var(--btn-ghost-focus-shadow);
                }
			}


		}

		#main-menu-logo {
			display: none;
		}

		#main-menu-navbuttons {
			display: contents;
		}

		.main-menu-buttons {
			display: contents;
		}

		#main-menu-usermenu {
            #main-menu-user-details {
                display: none;
            }
		}

		@container main (width > 600px) {
			#main-menu-logo {
				grid-area: logo;
				display: flex;
				justify-content: flex-start;
				width: 100%;
			}

			#main-menu-navbuttons {
				display: initial;
				grid-area: navbuttons;
				width: 100%;
			}

			#main-menu-usermenu {
				grid-area: usermenu;
				display: flex;
				justify-content: flex-end;
				width: 100%;

                #main-menu-user-details {
                    display: block;
                    padding: var(--spacing-2x);

                    &[open], &:hover {
                        background-color: var(--color-text-soft-20);
                        border-radius: var(--border-radius-1x);
                    }

                    .clickable-billettholder-menu-wrapper {
                        display: flex;
                        place-items: center;
                        cursor: pointer;
                        gap: var(--spacing-3x);

                        .clickable-billettholder-menu-name {
                            max-width: 180px;
                            p {
                                margin: 0;
                            }
                            p:first-child {
                                font-weight: 700;
                                overflow: clip;
                                white-space: nowrap;
                            }
                            p:last-child {
                                font-size: 12px;
                                color: var(--color-text-soft-50);
                                text-align: end;
                            }

                        }

                        .initials {
                            width: 40px;
                            height: 40px;
                        }
                    }
                }
                .hamburger-phone {
                    display: none;
                }
			}

			.main-menu-header {
				position: sticky;
				top: 0;
				bottom: unset;
				border-top: none;
				border-bottom: 1px solid var(--bg-item-border);
			}

			.main-menu {
				display: grid;
				grid-template-areas: "logo navbuttons usermenu";
				grid-template-columns: 50px 1fr 50px;
				place-content: center;
				place-items: center;
				.logo-link {
					display: flex;
					place-items: center;

					img {
						width: 3rem;
						height: 3rem;
					}
				}

				.menu-btn-container:not(:has(.hamburger-have-billettholder)) {
					display: flex;
					align-items: center;
					justify-content: center;
					height: 42px;
					width: 42px;
					.inline-icon {
						width: 24px;
						height: 24px;
					}
				}

				.menu-btn {
					height: var(--btn-height);
					width: var(--btn-height);
					padding: 0;
					.menu-btn-text {
						display: none;
					}
				}

				.btn-login {
					white-space: nowrap;
				}

                .dropdown-panel {
                    display: block;
                    position: absolute;
                    top: 61px;
                    right: 0;
                    bottom: unset;
                    background-color: var(--bg-item);
                    border: 1px solid var(--bg-item-border);
                    box-shadow: 0 8px 16px hsla(0, 0%, 0%, 0.2);
                    border-radius: var(--border-radius-1x);
                    z-index: var(--nav-drop-down-z-index);
                    width: max-content;
                    max-width: 320px;

                    .clickable-billettholder-menu-pc {
                            display: grid;
                            grid-template-columns: 1fr 24px;
                            grid-gap: 52px;
                        }

                        .name-initials-little {
                            max-width: 24px;
                            max-height: 24px;
                        }
                    }
			    }

                .dropdown-panel a {
                    display: block;
                    color: var(--color-primary-text);
                    padding: 0.5rem 1rem;
                    text-decoration: none;
                }

                .dropdown-panel a.external-link {
                    display: flex;
                    align-items: center;
                    gap: var(--spacing-1x);
                }

                .dropdown-panel a:hover {
                    background-color: hsla(0, 0%, 100%, 0.1);
                }
			}
		}

		@container main (width > 800px) {
			.main-menu {
				grid-template-columns: 120px 1fr 120px;
			}

		}
	</style>
	<header class="main-menu-header no-print">
		<nav class="main-menu page-content-container wide-content">
			<section id="main-menu-logo">
				<a href="/" class="logo-link">
					<img src="/static/RegnconLogo.svg" alt="Regncon framside"/>
				</a>
			</section>
			<section id="main-menu-navbuttons">
				@MainMenuButtons(userInfo)
			</section>
			<section id="main-menu-usermenu">
				if userInfo.IsLoggedIn {
					<div style="display: flex; align-items: center; gap: 0.5rem; place-self: center end;">
						<details
							id="main-menu-user-details"
							class="menu-btn-container"
							data-on:click__outside="document.getElementById('main-menu-user-details')?.removeAttribute('open')"
						>
							<summary>
								/*TODO: make clickable menu shown when you have an account*/
								if currentBillettholder.Id != 0 {
									<div class="hamburger-have-billettholder">
										@clickableBillettholderMenu(userInfo, db, logger)
									</div>
								}
								if currentBillettholder.Id == 0 {
									<div>
										@icons.Icon(icons.Menu, icons.Size20)
									</div>
								}
							</summary>
							<div class="dropdown-panel">
								<button
									class="clickable-billettholder-menu-pc btn"
									data-on:click="document.getElementById('modal-billettholder-switcher').showModal()"
								>
									Bytt aktiv billettholder
									<div class="name-initials-little">
										@ticketholder.Initials(initials, currentBillettholder.Color)
									</div>
								</button>
								<a href="/profile">Min Profil</a>
								<a
									href="https://www.regncon.no/vanlege-sporsmal/"
									target="_blank"
									rel="noopener noreferrer"
									class="external-link"
								>
									<span>Vanlege Spørsmål</span>
									@icons.Icon(icons.ExternalLink, icons.Size16)
								</a>
								if userInfo.IsAdmin {
									<hr/>
									<a href="/admin/billettholder/">Billettholderoversikt</a>
									<a href="/admin/approval/">Godkjenn arrangementer</a>
									<hr/>
								}
								<a href="/auth/logout">Logg ut</a>
							</div>
						</details>
						@HamburgerPhone(userInfo, db, logger)
					</div>
				}
				if !userInfo.IsLoggedIn {
					<a href="/auth" class="btn btn--primary btn-login">
						Logg inn
					</a>
				}
			</section>
		</nav>
	</header>
}

templ HamburgerPhone(userInfo requestctx.UserRequestInfo, db *sql.DB, logger *slog.Logger) {
	{{
	associatedBillettholdere, _ := ticketholder.GetTicketHolders(userInfo, db)
	currentBillettholder := ticketholder.GetYourBillettHolderInfo(userInfo, associatedBillettholdere)
	initials := ticketholder.GetInitials(currentBillettholder.Name)
	}}
	<style>
        .main-menu-button {
            font-family: inherit;
        }
        /* this is only shown on phone. Therefore static size 100dynamic*/
        #modal-hamburger-phone[open] {
            margin: 0;
            min-height: calc(100dvh - var(--nav-height));
            min-width: 100dvw;
            border: none;
            display: grid;
            grid-template-rows: 50px 1fr;
            background-color: var(--bg-base);
            padding: 0;
            position: fixed;
            top: 0;
            .hamburger-modal-content {
                padding-top: 50px;
                display: grid;
                grid-auto-rows: 52px;
                div {
                    display: flex;
                    color: var(--color-primary-text);
                    padding-left: var(--spacing-5x);
                    place-items: center start;
                    place-content: space-between;
                }

                button {
                    height: fit-content;
                    font-weight: inherit;
                    font-family: inherit;
                    font-size: inherit;
                    padding-block: 0;
                    place-content: space-between;
                    height: 52px;
                }

                a, button {
                    display: flex;
                    color: var(--color-primary-text);
                    text-decoration: none;
                    padding-left: var(--spacing-5x);
                    place-items: center start;
                }

                a:hover, a:focus-visible, button:hover, button:focus-visible {
                    background-color: hsla(0, 0%, 100%, 0.1);
                }
                a:focus-visible {
                    outline: none;
                    box-shadow: inset 0 0 0 2px var(--btn-ghost-focus-shadow);
                }
                .border-bottom {
                    border-bottom: 1px solid var(--bg-item);
                }
            }
        }

        #modal-billettholder-switcher[open] {
            max-width: 344px;
            margin-top: 70px;
            border-radius: var(--spacing-2x);
            border: none;
            background-color: var(--bg-surface);
            padding: var(--spacing-5x);
            gap: var(--spacing-5x);
            display: grid;
            grid-template-rows:24px 1fr;

            .modal-billettholder-header {
                max-width: 304px;
                max-height: 20px;
                display: grid;
                grid-template-columns: 1fr 24px;
                p {
                    font-size: var(--text-body);
                    line-height: 100%;
                    font-weight: 700;
                    align-self: center;
                }

                .modal-close-button-billettholderswitcher {
                    display: flex;
                }
            }
            .hamburger-modal-billettholder-content {
                display: grid;
                gap: var(--spacing-5x);

                p:not(.name-initials p) {
                    font-size: var(--text-heading-4);
                    font-weight: 400;
                    line-height: 100%;
                    color: var(--color-text-soft);
                }
                .billettholder-switcher {
                    display: grid;
                    gap: var(--spacing-2x);
                    grid-auto-rows: 1fr;
                    min-width: 304px;
                }
            }
        }

        @container main (width > 600px) {
            .hamburger-menu-button {
                display: none;
            }

            #modal-billettholder-switcher[open] {
                max-width: 420px;
                margin-top: auto;

                .modal-billettholder-header {
                    max-width: 380px;
                }
                .hamburger-modal-billettholder-content {
                    p:not(.name-initials p) {

                    }

                    .billettholder-switcher {

                    }
                }
            }

        }

    </style>
	<button
		class="main-menu-button btn btn--ghost btn-with-icon hamburger-phone"
		data-signals="{toggleHamburgerModal: false}"
		data-on:click="$toggleHamburgerModal = !$toggleHamburgerModal; $toggleHamburgerModal ? document.getElementById('modal-hamburger-phone').show() : document.getElementById('modal-hamburger-phone').close()"
	>
		@icons.Icon(icons.Menu, icons.Size20)
		<span class="menu-button-text">
			Meny
		</span>
	</button>
	<dialog id="modal-hamburger-phone">
		<div class="hamburger-modal-content">
			<button class="btn" data-on:click="document.getElementById('modal-billettholder-switcher').showModal()">
				Bytt aktiv billettholder
				<div class="btn">
					@ticketholder.Initials(initials, currentBillettholder.Color)
				</div>
			</button>
			<a href="/profile">Min Profil</a>
			<a href="https://www.regncon.no/vanlege-sporsmal/" target="_blank" class="border-bottom">Vanlege Spørsmål</a>
			if userInfo.IsAdmin {
				<a href="/admin/billettholder/">Billettholderoversikt</a>
				<a href="/admin/approval/" class="border-bottom">Godkjenn arrangementer</a>
			}
			<a href="/auth/logout">Logg ut</a>
		</div>
	</dialog>
	<dialog id="modal-billettholder-switcher">
		<div class="modal-billettholder-header">
			<p>Bytt aktiv billettholder</p>
			<button class="modal-close-button-billettholderswitcher btn" commandfor="modal-billettholder-switcher" command="close">
				@icons.Icon(icons.Close, icons.Size20)
			</button>
		</div>
		<div class="hamburger-modal-billettholder-content">
			<p>
				Ved å bytte aktiv bruker vil interessevalgene
				til den valgte brukeren vises på programoversikten
				og de vil være standardvalget på Min Side og i
				interessevelgeren på et arrangement.
			</p>
			@BillettholderSwitcher(userInfo, db, logger)
			<p>Valgene dine lagres automatisk. Du kan lukke denne modalen når du er ferdig.</p>
		</div>
	</dialog>
}

templ BillettholderSwitcher(userInfo requestctx.UserRequestInfo, db *sql.DB, logger *slog.Logger) {
	{{
	associatedBillettholdere, _ := ticketholder.GetTicketHolders(userInfo, db)
	}}
	<div class="billettholder-switcher">
		for _, billettholder := range associatedBillettholdere {
			@billettholderSwitcherButton(billettholder)
		}
	</div>
}

templ billettholderSwitcherButton(currentBillettHolder ticketholder.BillettHolder) {
	{{
	initials := ticketholder.GetInitials(currentBillettHolder.Name)
	currentBillettHolderJSON, _ := templ.JSONString(currentBillettHolder)
	}}
	<style>
		.ticket-holder-picker {
            padding-inline: var(--border-outline-width);
			.card-clickable {
                place-content: start;
                height: 3.125rem;
                min-width: 304px;
            }

            .name-initials {
                p {
                    font-size: var(--text-body);
                    font-weight: 400;
                    color: var(--color-text-soft);
                }
            }
		}


        @container main (width > 600px) {
            .ticket-holder-picker {
			.card-clickable {
                min-width: 380px;
            }
        }
	</style>
	<div class="ticket-holder-picker">
		<div
			role="button"
			data-attr:tabindex={ fmt.Sprintf(`$billettHolderId == %d ? '-1' : '0'`, currentBillettHolder.Id) }
			class="card-clickable card-clickable-item"
			data-current-billett-holder={ currentBillettHolderJSON }
			data-class:selected={ fmt.Sprintf("$billettHolderId == %d", currentBillettHolder.Id) }
			data-on:click={ fmt.Sprintf("$billettHolderId = %d; window.conorganizer.billettholderSelection.set(JSON.parse(evt.currentTarget.dataset.currentBillettHolder));", currentBillettHolder.Id) }
		>
			@ticketholder.NameInitials(currentBillettHolder.Name, initials, currentBillettHolder.Color)
		</div>
	</div>
}
