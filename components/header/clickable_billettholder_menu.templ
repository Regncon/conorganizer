package header

import ticketholder "github.com/Regncon/conorganizer/components/ticket_holder"

templ clickableBillettholderMenu(currentBillettholder ticketholder.BillettHolder) {
	{{
		initials := ticketholder.GetInitials(currentBillettholder.Name)
	}}

	<div class="clickable-billettholder-menu-wrapper">
		<div class="clickable-billettholder-menu-name">
			<p data-current-billettholder-name>{ currentBillettholder.Name }</p>
			<p data-current-billettholder-ticket-type>{ currentBillettholder.TicketType }</p>
		</div>
		<div data-current-billettholder-avatar>
			@ticketholder.Initials(initials, currentBillettholder.Color)
		</div>
	</div>
}
