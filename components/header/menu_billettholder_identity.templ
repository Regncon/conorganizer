package header

import (
	"fmt"

	"github.com/Regncon/conorganizer/components/ticket_holder"
)

templ menuBillettholderIdentityStyles() {
	<style>
		.main-menu-header {
			.menu-billettholder-avatar-content {
				display: grid;
				position: relative;
			}

			.menu-billettholder-value {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
			}

			.menu-billettholder-skeleton,
			.menu-billettholder-skeleton-text {
				display: none;
			}

			.menu-billettholder-skeleton {
				background-color: var(--color-text-soft-20);
				border-radius: var(--border-radius-1x);
				animation: menu-billettholder-pulse 1.5s ease-in-out infinite;
			}

			.menu-billettholder-skeleton-avatar {
				position: absolute;
				inset: 0;
				border-radius: 50%;
			}

			.menu-billettholder-skeleton-text {
				position: absolute;
				inset: 0;
				place-content: center;
				grid-template-columns: 1fr;
				gap: var(--spacing-2x);
			}

			.menu-billettholder-skeleton-name {
				inline-size: 100%;
				block-size: 0.85em;
			}

			.menu-billettholder-skeleton-ticket {
				inline-size: 100%;
				block-size: 0.65em;
				place-self: center end;
			}

			[data-billettholder-pending] {
				.menu-billettholder-value {
					visibility: hidden;
				}

				.menu-billettholder-skeleton {
					display: block;
				}

				.menu-billettholder-skeleton-text {
					display: grid;
				}
			}
		}

		@keyframes menu-billettholder-pulse {
			0%, 100% {
				opacity: 0.5;
			}

			50% {
				opacity: 1;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.main-menu-header .menu-billettholder-skeleton {
				animation: none;
			}
		}
	</style>
}

templ menuBillettholderAvatar(billettholder ticketholder.BillettHolder, pending bool, className string) {
	<div
		class={ "js-current-billettholder-avatar " + className }
		data-ignore-morph
		data-billettholder-identity
		aria-busy={ fmt.Sprint(pending) }
		if pending {
			data-billettholder-pending
		}
	>
		<span class="menu-billettholder-avatar-content">
			<span
				class="menu-billettholder-value"
				if pending {
					aria-hidden="true"
				}
			>
				@ticketholder.Initials(ticketholder.GetInitials(billettholder.Name), billettholder.Color)
			</span>
			<span class="menu-billettholder-skeleton menu-billettholder-skeleton-avatar" aria-hidden="true"></span>
		</span>
	</div>
}
