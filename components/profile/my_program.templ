package profilecomponent

import (
	"database/sql"
	"errors"
	"fmt"
	"log/slog"

	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/service/puljer"
	"github.com/Regncon/conorganizer/service/requestctx"
)

func getProgramPublished(db *sql.DB) (bool, error) {
	const query = `
		SELECT is_published
		FROM program_publishing_state
		WHERE id = 1
	`

	var isPublished int
	if err := db.QueryRow(query).Scan(&isPublished); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return false, nil
		}
		return false, fmt.Errorf("query program publishing state: %w", err)
	}

	return isPublished == 1, nil
}

templ MyProgram(userInfo requestctx.UserRequestInfo, selectedBillettholderID int, db *sql.DB, logger *slog.Logger, eventImageDir *string) {
	{{
		logger = logger.With("component", "profile_program")
		events, err := GetAllEventsForUser(userInfo, selectedBillettholderID, db, logger)
		interests, interestErr := getProgramWishesForUser(userInfo, selectedBillettholderID, db, logger)
		puljeRows, puljeErr := puljerService.GetAllPuljer(db)
		isPublished, publishErr := getProgramPublished(db)

		var hasError bool = false
		if err != nil {
			logger.Error(err.Error(), "user_id", userInfo.Id)
			hasError = true
		}
		if interestErr != nil {
			logger.Error(interestErr.Error(), "user_id", userInfo.Id)
			hasError = true
		}
		if puljeErr != nil {
			logger.Error(puljeErr.Error(), "user_id", userInfo.Id)
			hasError = true
		}
		if publishErr != nil {
			logger.Error(publishErr.Error(), "user_id", userInfo.Id)
			hasError = true
		}

		puljer := make([]UserProgramPulje, len(puljeRows))
		for i, pulje := range puljeRows {
			puljer[i].Pulje = pulje
		}

		for i := range puljer {

			for _, event := range events {
				if event.PuljeID == puljer[i].Pulje.ID {
					puljer[i].Events = append(puljer[i].Events, event)
				}
			}

			for _, interest := range interests {
				if interest.PuljeID == puljer[i].Pulje.ID {
					puljer[i].Interests = append(puljer[i].Interests, interest)
				}
			}
		}
	}}
	<style>
		#mitt-program {
			--program-card-border: color-mix(in srgb, var(--bg-item-border) 82%, var(--color-primary));
			--program-card-padding: clamp(var(--spacing-3x), 5cqi, var(--spacing-5x));
			container: mitt-program / inline-size;

			.program-pulje-list {
				display: grid;
				gap: var(--responsive-pane-padding);
			}

			.program-pulje-container {
				display: grid;
				gap: var(--spacing-2x);
				scroll-margin-block: var(--spacing-4x);
			}

			.program-pulje-heading {
				display: grid;
				gap: var(--spacing-1x);
				margin: 0;
			}

			.program-pulje-name {
				font-size: var(--text-heading-3);
				font-weight: 700;
				color: var(--color-text-strong);
			}

			.program-pulje-time {
				font-size: var(--text-heading-4);
				font-weight: 400;
				color: var(--color-text-soft);
			}

			.program-card {
				display: grid;
				gap: var(--spacing-3x);
				padding: var(--program-card-padding);
				border: 1px solid var(--program-card-border);
				border-radius: var(--border-radius-2x);
				background: color-mix(in srgb, var(--bg-item) 94%, var(--color-primary));
			}

			.program-card-status {
				font-weight: 700;
				color: var(--color-primary);
			}

			.program-card-status-success {
				color: var(--color-success);
			}

			.program-card-title {
				font-size: var(--text-heading-3);
				font-weight: 700;
				color: var(--color-text-strong);
				text-decoration: none;
			}

			.program-card-title:hover,
			.program-card-title:focus-visible {
				color: var(--color-primary);
				text-decoration: underline;
			}

			.program-card-meta {
				display: grid;
				gap: var(--spacing-1x);
				color: var(--color-text-soft);
			}

			.program-card-wishes {
				display: grid;
				gap: var(--spacing-2x);
				padding: 0;
				margin: 0;
				list-style: none;
			}

			.program-card-wish {
				display: grid;
				gap: var(--spacing-1x);
				padding-block-start: var(--spacing-2x);
				border-block-start: 1px solid var(--bg-item-border);
			}

			.program-card-wish a {
				font-weight: 700;
				color: var(--color-text-strong);
			}

			.program-group {
				border-block-start: 1px solid var(--bg-item-border);
				padding-block-start: var(--spacing-2x);
			}

			.program-group summary {
				cursor: pointer;
				font-weight: 700;
				color: var(--color-primary);
			}

			.program-group ul {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: var(--spacing-1x) var(--spacing-3x);
				padding-inline-start: var(--spacing-4x);
				margin-block-end: 0;
			}

			.program-group-role {
				color: var(--color-text-soft);
			}

			.program-card-neutral {
				color: var(--color-text-soft);
			}
		}

		@container mitt-program (width < 34rem) {
			#mitt-program .program-group ul {
				grid-template-columns: 1fr;
			}
		}
	</style>
	<div class="surface-pane" id="mitt-program">
		<h2 class="surface-pane-title">
			Mitt festivalprogram
		</h2>
		if hasError {
			<div style="padding: var(--spacing-4x); color: var(--color-error); background-color: var(--bg-error-light); border-radius: var(--border-radius-2x);">
				<p>Vi klarte ikke å laste hele festivalprogrammet ditt akkurat nå.</p>
				<p>Prøv igjen om litt.</p>
			</div>
		} else {
			<section class="program-pulje-list">
				for _, pulje := range puljer {
					<section
						class="program-pulje-container"
						id={ fmt.Sprintf("program-%s", pulje.Pulje.ID) }
						data-program-pulje={ string(pulje.Pulje.ID) }
					>
						<h3 class="program-pulje-heading">
							<span class="program-pulje-name">{ pulje.Pulje.Name }</span>
							<span class="program-pulje-time">{ pulje.Pulje.TimeRange() }</span>
						</h3>
						if !isPublished {
							@ProgramPendingCard(pulje.Interests)
						} else if len(pulje.Events) > 0 {
							for _, event := range pulje.Events {
								@ProgramEventCard(event)
							}
						} else if pulje.Pulje.Status == models.PuljeStatusCompleted && len(pulje.Interests) > 0 {
							@ProgramUnassignedCard(pulje.Interests)
						} else if len(pulje.Interests) > 0 {
							@ProgramPendingCard(pulje.Interests)
						} else {
							<div class="program-card program-card-neutral">
								<p>Du har ingen arrangementer eller ønsker i denne puljen.</p>
							</div>
						}
					</section>
				}
			</section>
		}
	</div>
}

templ ProgramEventCard(event UserEvent) {
	<article class="program-card">
		<p class={ "program-card-status", templ.KV("program-card-status-success", !event.IsGM) }>
			if event.IsGM {
				Du er GM
			} else {
				Du har fått plass
			}
		</p>
		<a href={ templ.URL(fmt.Sprintf("/event/%s", event.EventID)) } class="program-card-title">{ event.Title }</a>
		<div class="program-card-meta">
			if event.RoomLabel() != "" {
				<span>{ event.RoomLabel() }</span>
			}
			if len(event.GMNames) > 0 {
				<span>GM: { event.GMLabel() }</span>
			}
		</div>
		if event.PuljeStatus == models.PuljeStatusCompleted && len(event.GroupMembers) > 0 {
			<details class="program-group" data-program-group={ string(event.PuljeID) } data-preserve-attr="open">
				<summary>Se gruppen din</summary>
				<ul>
					for _, member := range event.GroupMembers {
						<li>
							{ member.FirstName }
							if member.Role == models.EventPlayerRoleGM {
								<span class="program-group-role"> (GM)</span>
							}
						</li>
					}
				</ul>
			</details>
		}
	</article>
}

templ ProgramPendingCard(interests []UserInterest) {
	<div class="program-card">
		<p class="program-card-status">Fordelingen er ikke publisert ennå</p>
		if len(interests) > 0 {
			<p>Ønskene dine i denne puljen:</p>
			@ProgramWishList(interests)
		} else {
			<p class="program-card-neutral">Du har ingen ønsker i denne puljen.</p>
		}
	</div>
}

templ ProgramUnassignedCard(interests []UserInterest) {
	<div class="program-card">
		<p class="program-card-status">Du fikk dessverre ikke plass i denne puljen</p>
		<p>Ta kontakt med arrangørene dersom du har spørsmål om fordelingen.</p>
		<p>Ønskene dine:</p>
		@ProgramWishList(interests)
	</div>
}

templ ProgramWishList(interests []UserInterest) {
	<ul class="program-card-wishes">
		for _, interest := range interests {
			<li class="program-card-wish">
				<a href={ templ.URL(fmt.Sprintf("/event/%s", interest.EventID)) }>{ interest.EventName }</a>
				<span>{ interest.InterestLevel.Label() }</span>
			</li>
		}
	</ul>
}

func getAllInterestsForUser(userInfo requestctx.UserRequestInfo, selectedBillettholderID int, db *sql.DB, logger *slog.Logger) ([]UserInterest, error) {
	return queryUserProgramInterests(userInfo, selectedBillettholderID, db, logger, true)
}

func getProgramWishesForUser(userInfo requestctx.UserRequestInfo, selectedBillettholderID int, db *sql.DB, logger *slog.Logger) ([]UserInterest, error) {
	return queryUserProgramInterests(userInfo, selectedBillettholderID, db, logger, false)
}

func queryUserProgramInterests(userInfo requestctx.UserRequestInfo, selectedBillettholderID int, db *sql.DB, logger *slog.Logger, hideCompletedResultWishes bool) ([]UserInterest, error) {
	if selectedBillettholderID <= 0 {
		return []UserInterest{}, nil
	}

	hideCompletedResultWishesValue := 0
	if hideCompletedResultWishes {
		hideCompletedResultWishesValue = 1
	}

	query := `
		SELECT
			i.event_id,
			e.title,
			CASE MIN(CASE i.interest_level
				WHEN ? THEN 1
				WHEN ? THEN 2
				WHEN ? THEN 3
				ELSE 999
			END)
				WHEN 1 THEN ?
				WHEN 2 THEN ?
				WHEN 3 THEN ?
				ELSE ?
			END AS interest_level,
			i.pulje_id
		FROM interests i
		JOIN events e ON i.event_id = e.id
		JOIN relation_billettholdere_users bu ON bu.billettholder_id = i.billettholder_id
		JOIN users u ON u.id = bu.user_id
		JOIN relation_event_puljer ep ON ep.event_id = i.event_id
			AND ep.pulje_id = i.pulje_id
		WHERE i.billettholder_id = ?
			AND u.external_id = ?
			AND e.status = ?
			AND ep.is_in_pulje = 1
			AND ep.is_published = 1
			AND (? = 0 OR NOT EXISTS (
				SELECT 1
				FROM relation_events_players assigned
				JOIN events assigned_event ON assigned_event.id = assigned.event_id
				JOIN relation_event_puljer assigned_event_pulje ON assigned_event_pulje.event_id = assigned.event_id
					AND assigned_event_pulje.pulje_id = assigned.pulje_id
				JOIN puljer assigned_pulje ON assigned_pulje.id = assigned.pulje_id
				WHERE assigned.billettholder_id = i.billettholder_id
					AND assigned.pulje_id = i.pulje_id
					AND assigned_event.status = ?
					AND assigned_event_pulje.is_in_pulje = 1
					AND assigned_event_pulje.is_published = 1
					AND (
						assigned.role = ?
						OR assigned_pulje.status = ?
					)
			))
		GROUP BY i.event_id, e.title, i.pulje_id
		ORDER BY i.pulje_id ASC,
			MIN(CASE i.interest_level
				WHEN ? THEN 1
				WHEN ? THEN 2
				WHEN ? THEN 3
				ELSE 999
			END) ASC,
			e.title ASC
	`

	rows, queryErr := db.Query(query,
		models.InterestLevelHigh,
		models.InterestLevelMedium,
		models.InterestLevelLow,
		models.InterestLevelHigh,
		models.InterestLevelMedium,
		models.InterestLevelLow,
		models.InterestLevelNone,
		selectedBillettholderID,
		userInfo.Id,
		models.EventStatusAnnounced,
		hideCompletedResultWishesValue,
		models.EventStatusAnnounced,
		models.EventPlayerRoleGM,
		models.PuljeStatusCompleted,
		models.InterestLevelHigh,
		models.InterestLevelMedium,
		models.InterestLevelLow,
	)
	if queryErr != nil {
		return nil, fmt.Errorf("unable to query interests for user %s: %w", userInfo.Id, queryErr)
	}
	defer rows.Close()

	interests := make([]UserInterest, 0)

	for rows.Next() {
		var interest UserInterest

		scanErr := rows.Scan(
			&interest.EventID,
			&interest.EventName,
			&interest.InterestLevel,
			&interest.PuljeID,
		)

		if scanErr != nil {
			logger.Error(fmt.Errorf("failed to scan interest for user %s: %w", userInfo.Id, scanErr).Error())
			continue
		}

		interests = append(interests, interest)
	}

	if rowsErr := rows.Err(); rowsErr != nil {
		return nil, fmt.Errorf("error iterating interest rows for user %s: %w", userInfo.Id, rowsErr)
	}

	return interests, nil
}

func GetAllEventsForUser(userInfo requestctx.UserRequestInfo, selectedBillettholderID int, db *sql.DB, logger *slog.Logger) ([]UserEvent, error) {
	if selectedBillettholderID <= 0 {
		return []UserEvent{}, nil
	}

	query := `
		SELECT
			ep.event_id,
			e.title,
			COALESCE(e.intro, '') as intro,
			COALESCE(e.description, '') as description,
			COALESCE(e.user_id, 0) as user_id,
			e.event_type,
			ep.pulje_id,
			p.status,
			MAX(ep.role = ?) AS is_gamemaster
		FROM relation_events_players ep
		JOIN relation_billettholdere_users bu ON bu.billettholder_id = ep.billettholder_id
		JOIN users u ON u.id = bu.user_id
		JOIN events e ON ep.event_id = e.id
		JOIN relation_event_puljer event_pulje ON event_pulje.event_id = ep.event_id
			AND event_pulje.pulje_id = ep.pulje_id
		JOIN puljer p ON ep.pulje_id = p.id
		WHERE ep.billettholder_id = ?
			AND u.external_id = ?
			AND e.status = ?
			AND event_pulje.is_in_pulje = 1
			AND event_pulje.is_published = 1
			AND (
				ep.role = ?
				OR p.status = ?
			)
		GROUP BY
			ep.event_id,
			e.title,
			e.intro,
			e.description,
			e.user_id,
			e.event_type,
			ep.pulje_id,
			p.status
		ORDER BY p.start_at ASC, e.title ASC
	`

	rows, queryErr := db.Query(
		query,
		models.EventPlayerRoleGM,
		selectedBillettholderID,
		userInfo.Id,
		models.EventStatusAnnounced,
		models.EventPlayerRoleGM,
		models.PuljeStatusCompleted,
	)
	if queryErr != nil {
		return nil, fmt.Errorf("unable to query events for user %s: %w", userInfo.Id, queryErr)
	}
	defer rows.Close()

	events := make([]UserEvent, 0)

	for rows.Next() {
		var event UserEvent

		scanErr := rows.Scan(
			&event.EventID,
			&event.Title,
			&event.Intro,
			&event.Description,
			&event.UserID,
			&event.EventType,
			&event.PuljeID,
			&event.PuljeStatus,
			&event.IsGM,
		)

		if scanErr != nil {
			logger.Error(fmt.Errorf("failed to scan event for user %s: %w", userInfo.Id, scanErr).Error())
			continue
		}
		events = append(events, event)
	}

	if rowsErr := rows.Err(); rowsErr != nil {
		return nil, fmt.Errorf("error iterating event rows for user %s: %w", userInfo.Id, rowsErr)
	}

	if err := rows.Close(); err != nil {
		return nil, fmt.Errorf("close events for user %s: %w", userInfo.Id, err)
	}

	if err := enrichUserProgramEvents(db, events); err != nil {
		return nil, fmt.Errorf("load program event details for user %s: %w", userInfo.Id, err)
	}

	return events, nil
}
