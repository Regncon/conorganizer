package event_components

import (
	"database/sql"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"time"

	"github.com/Regncon/conorganizer/components/formsubmission"
	"github.com/Regncon/conorganizer/components/icons"
	ticketholder "github.com/Regncon/conorganizer/components/ticket_holder"
	"github.com/Regncon/conorganizer/models"
	"github.com/Regncon/conorganizer/service/eventimage"
	"github.com/Regncon/conorganizer/service/requestctx"
)

templ EventInterests(userInfo requestctx.UserRequestInfo,
	eventId string,
	puljeId string,
	title string,
	ageGroup models.AgeGroup,
	eventImageDir *string,
	db *sql.DB,
	r *http.Request,
	logger *slog.Logger) {
	{{
	puljer, puljerErr := ticketholder.GetPuljerFromEventId(eventId, db)
	if puljerErr != nil {
		logger.Error(puljerErr.Error(), "event_id", eventId)
	}
	selectedPuljeState := ticketholder.BuildSelectedPuljeInterestState(puljer, puljeId, time.Now())
	billettholderID := requestctx.SelectedBillettholderID(r.Context())
	noticeState, noticeErr := LoadInterestNoticeState(billettholderID, puljeId, ageGroup, eventImageDir, db)
	if noticeErr != nil {
		logger.Error(noticeErr.Error(), "event_id", eventId, "pulje_id", puljeId, "billettholder_id", billettholderID)
	}
	}}
	<style>
		.dialog-container {
			container-type: inline-size;
			container-name: interest-dialog;
			position: relative;
		}

		.interest-dialog[open] {
			inset: 0;
			--dialog-width: min(32.5rem, calc(100% - 16px));
			visibility: visible;
			width: var(--dialog-width);
			background-color: var(--level-1-background);
			border: none;
			border-radius: var(--border-radius-2x);
			padding: var(--responsive-pane-padding);
			box-shadow: var(--shadow-dialog);
			/* This always centers the dialog on the page */
			position: fixed;
			top: 0;
			bottom: 0;
			left: 0;
			right: 0;
            outline:none;

			.no-marking {
				user-select: none;
				-moz-user-select: none;
				-khtml-user-select: none;
				-webkit-user-select: none;
				-o-user-select: none;
			}

			.dialog-container {
				.dialog-header {
					display: flex;
					place-content: space-between;
					place-items: center;
					height: fit-content;
					color: var(--color-text-soft);
					padding-bottom: var(--responsive-pane-padding);
				}

				.dialog-content {
                    --border-outline-width: 4px;

					display: flex;
					flex-direction: column;
					max-height: calc(100vh - 280px);
					overflow: auto;

					.label {
						font-size: 12px;
						font-weight: 700;
						color: var(--color-text-strong);
						margin-block-end: var(--spacing-1x);
					}

					button .emoji {
						font-size: 25px;
						margin-inline-end: var(--spacing-5x);
					}
				}

				.dialog-footer {
					display: flex;
					flex-direction: row;
					align-items: center;
					justify-content: space-between;
					gap: var(--responsive-pane-padding);
					padding-top: var(--responsive-pane-padding);
					.auto-save-message {
						color: var(--color-text-soft);
						font-size: 12px;
					}
				}

				.close-button-container {
					position: absolute;
					top: 0;
					right: 0;
					display: flex;
					align-items: center;
					justify-content: center;
					height: 18px;
					width: 18px;

					.btn {
						padding-inline: var(--spacing-2x);
					}
				}
			}
		}
	</style>
	// Refresh the current browser selection when the page's live stream delivers HTML.
	// The stream's original request may contain an earlier billettholder selection.
	<dialog
		class="interest-dialog"
		data-attr:open="$_interestIsOpen ? true : false"
		data-signals={ formsubmission.DataSignals(map[string]any{
			"puljeId":              puljeId,
			"puljeAvailability":    selectedPuljeState.Availability,
			"puljeCanEdit":         selectedPuljeState.CanEdit,
			"puljeStatusMessage":   selectedPuljeState.Message,
			"puljeShowProfileLink": selectedPuljeState.ShowProfileLink,
		}) }
		data-effect={ fmt.Sprintf("if ($billettHolderId && $puljeId) { @put('/event/api/%s/interest/selected-interest') }", eventId) }
		data-on:datastar-fetch__document={ fmt.Sprintf("if (el.isConnected && evt.detail.type === 'datastar-patch-elements' && evt.detail.el?.id === 'event-container' && $billettHolderId && $puljeId) { @put('/event/api/%s/interest/selected-interest') }", eventId) }
	>
		<div class="dialog-container">
			<header class="dialog-header">
				<h3>Meld interesse</h3>
			</header>
			<div
				class="dialog-content"
				tabindex="-1"
				data-effect="$_interestIsOpen && document.querySelector('.dialog-content')?.focus()"
			>
				@ticketholder.TicketHolderPicker(userInfo, eventId, db, logger)
				@ticketholder.TicketHolderPuljePicker(eventId, puljeId, db, logger)
				@InterestContent(eventId, title, noticeState, models.InterestLevelNone, db, r, logger)
			</div>
			<div class="dialog-footer">
				<p class="auto-save-message">Valgene dine lagres automatisk. Du kan lukke denne modalen når du er ferdig.</p>
				<button class="btn btn--outline" data-on:click="$_interestIsOpen = false">
					Ferdig
				</button>
			</div>
			<form class="close-button-container" method="dialog">
				<button
					class="btn btn--ghost close"
					data-on:click="$_interestIsOpen = false"
				>
					@icons.Icon(icons.Close, icons.Size24)
				</button>
			</form>
		</div>
	</dialog>
	<script>
		const dialogElement = document.querySelector(`.interest-dialog`);
		dialogElement?.addEventListener("click", (ev) => {
			ev.stopPropagation();
		});
	</script>
}

// Page morphs preserve this selection-dependent content. The selected-interest
// endpoint replaces the wrapper explicitly after validating the current selection.
templ InterestContent(eventID string, title string, state InterestNoticeState, interest models.InterestLevel, db *sql.DB, r *http.Request, logger *slog.Logger) {
	<div
		id="interest-content"
		data-ignore-morph
		data-signals:selected-interest-level={ fmt.Sprintf("%q", interest) }
		data-signals:current-interest-level-choice="'Pending choice'"
	>
		<p class="label">Velg interesse</p>
		if state.ShowAssignedEvent {
			@InterestAlreadyAssigned(eventID, title, state.AssignedEvent)
		}
		if state.ShowUnder18 {
			@interestUnder18(title)
		}
		if state.CanChooseInterest {
			@ticketholder.TicketHolderInterestPicker(eventID, db, r, logger)
		}
	</div>
}

templ InterestAlreadyAssigned(eventID string, title string, assignedEvent AssignedEvent) {
	<style>
        .interest-already-assigned {
            padding: var(--spacing-5x);
            background-color: var(--level-2-background);
            border-radius: var(--border-radius-1x);
            color: var(--color-text-soft);

            > p {
                margin-block: var(--spacing-5x);
            }

            .clickable-event-card{
                background-color: var(--level-3-background);
                border-radius: var(--border-radius-2x);
                border: 1px solid var(--level-3-border);


                .previous-next-buttons {
                    text-decoration: none;
                    color: inherit;
                    display: block;
                    padding: 0;

                    .text-container {
                        div {
                            padding: var(--spacing-4x);
                            color: var(--color-text-strong);

                            p {
                                font-size: 12px;
                                color: var(--color-primary);
                            }
                        }
                    }
                }
            }
        }

    </style>
	<section class="interest-already-assigned">
		if assignedEvent.Role == "GM" {
			@interestAlreadyAssignedGM(eventID, assignedEvent)
		} else {
			@interestAlreadyAssignedPlayer(eventID, title, assignedEvent)
		}
	</section>
}

templ interestAlreadyAssignedPlayer(eventID string, title string, assignedEvent AssignedEvent) {
	if assignedEvent.EventID == eventID {
		<h3>Du har allerede blitt tildelt dette arrangementet.</h3>
	} else {
		<h3>Du har allerede blitt tildelt i denne puljen.</h3>
		<p>
			Du har allerede plass på et annet arrangement i denne puljen. <i>{ title }</i>.
		</p>
		@ClickableEventCard(assignedEvent)
	}
}

templ interestAlreadyAssignedGM(eventID string, assignedEvent AssignedEvent) {
	if assignedEvent.EventID == eventID {
		<h3>Du er satt opp som arrangør for dette arrangementet.</h3>
	} else {
		<h3>Du er arrangør for et arrangement i denne puljen.</h3>
		<p><i>{ assignedEvent.Title }</i> er satt opp med deg som arrangør.</p>
		@ClickableEventCard(assignedEvent)
	}
}

templ interestUnder18(title string) {
	<style>
        .interest-under-18 {
            padding: var(--spacing-5x);
            background-color: var(--level-2-background);
            border-radius: var(--border-radius-1x);
            color: var(--color-text-soft);

            p:first-of-type {
                margin-block: var(--spacing-5x);
            }
        }
    </style>
	<section class="interest-under-18">
		<h3>Dette er et 18-års arrangement!</h3>
		<p>Arrangementet <i>{ title }</i> er satt opp med 18-års aldersgrense.</p>
		<p>Billetterholdere under 18 år kan ikke melde seg på.</p>
	</section>
}

templ ClickableEventCard(assignedEvent AssignedEvent) {
	<section class="prev-next-button-container no-print clickable-event-card">
		<a class="previous-next-buttons" href={ templ.URL("/event/" + assignedEvent.EventID) }>
			<div style="display: grid; grid-template-rows: 1fr; height: 100%;">
				<div class="text-container" style="display: flex; align-items: center; grid-row: 1 / 2; grid-column: 1 / 2;">
					<div
						style="
                            display: flex;
                            flex-direction: column;
                            gap: var(--spacing-1x);
                            overflow: clip;
                            "
					>
						<strong
							style="
                                height: 1lh;
                                word-break: break-all;
                            "
						>{ assignedEvent.Title }</strong>
						<p>{ assignedEvent.System }</p>
					</div>
				</div>
				if assignedEvent.ImageURL != "" {
					<img
						src={ assignedEvent.ImageURL }
						height="75px"
						style="
                                grid-row: 1 / 2;
                                grid-column: 1 / 2;
                                mask-image: var(--linear-gradient-mask);
                                -webkit-mask-image: var(--linear-gradient-mask);
                                filter:opacity(0.5);
                                place-self: end;
                                border-radius: var(--border-radius-2x);
                            "
					/>
				}
			</div>
		</a>
	</section>
}

type AssignedEvent struct {
	Title    string
	System   string
	Role     string
	Source   string
	EventID  string
	ImageURL string
}

type InterestNoticeState struct {
	ShowAssignedEvent bool
	ShowUnder18       bool
	CanChooseInterest bool
	AssignedEvent     AssignedEvent
}

func LoadInterestNoticeState(billettholderID int, puljeID string, ageGroup models.AgeGroup, eventImageDir *string, db *sql.DB) (InterestNoticeState, error) {
	if billettholderID <= 0 {
		return InterestNoticeState{}, nil
	}
	var isOver18 bool
	if err := db.QueryRow("SELECT is_over_18 FROM billettholdere WHERE id = ?1", billettholderID).Scan(&isOver18); err != nil {
		return InterestNoticeState{}, fmt.Errorf("failed to fetch billettholder age: %w", err)
	}
	assignedEvent, err := getAssignedEventForBillettholder(billettholderID, puljeID, db)
	if err != nil {
		return InterestNoticeState{}, err
	}
	if assignedEvent.EventID != "" {
		assignedEvent.ImageURL = eventimage.GetEventImageUrl(assignedEvent.EventID, "banner", eventImageDir)
	}
	showUnder18 := !isOver18 && ageGroup == models.AgeGroupAdultsOnly
	return InterestNoticeState{
		ShowAssignedEvent: assignedEvent.EventID != "",
		ShowUnder18:       showUnder18,
		CanChooseInterest: !showUnder18 && assignedEvent.EventID == "",
		AssignedEvent:     assignedEvent,
	}, nil
}

func getAssignedEventForBillettholder(billettholderID int, puljeID string, db *sql.DB) (AssignedEvent, error) {
	query := `
		SELECT e.title, e.system, bp.role, bp.source, e.id
		FROM relation_events_players bp
		JOIN events e ON e.id = bp.event_id
		WHERE bp.billettholder_id = ?1 AND bp.pulje_id = ?2
			AND (bp.source = 'manual' OR bp.role = 'GM')
		ORDER BY CASE WHEN bp.role = 'GM' THEN 0 ELSE 1 END, e.id
		LIMIT 1
	`
	var assignedEvent AssignedEvent
	err := db.QueryRow(query, billettholderID, puljeID).Scan(
		&assignedEvent.Title, &assignedEvent.System, &assignedEvent.Role, &assignedEvent.Source, &assignedEvent.EventID,
	)
	if errors.Is(err, sql.ErrNoRows) {
		return AssignedEvent{}, nil
	}
	if err != nil {
		return AssignedEvent{}, fmt.Errorf("failed to fetch assigned event for billettholder: %w", err)
	}
	return assignedEvent, nil
}
